@model StudentApplicationDetailViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "ApplicationDetail.Title");
    var hasInvalidRequirementConfiguration = !Model.HasValidRequiredDocumentConfiguration();
    var canSubmit = Model.CanSubmitDocumentWorkflow();
}

<header class="page-heading">
    <div>
        <p class="eyebrow">@UiText.Get(Context, "ApplicationDetail.Title")</p>
        <h1>@Model.ProgramName</h1>
        <p>@Model.InstituteName · @Model.AcademicYear · @Model.TermName</p>
    </div>
    <partial name="_ApplicationStatusBadge" model="Model.CurrentStatus" />
</header>

<partial name="_ApplicationProgress" model="Model.CurrentStatus" />

@if (Model.UsesEvaluationWorkflow && Model.CurrentStatus != ApplicationStatus.Withdrawn)
{
    if (Model.PublishedEvaluation is null)
    {
        <section class="empty-state empty-state--compact" aria-labelledby="evaluation-pending-heading">
            <h2 id="evaluation-pending-heading">@UiText.Get(Context, "ApplicationDetail.EvaluationPending")</h2>
            <p>@UiText.Get(Context, "ApplicationDetail.EvaluationPendingLead")</p>
        </section>
    }
    else
    {
        var result = Model.PublishedEvaluation;
        var isAdmitted = result.Outcome == EvaluationOutcome.Admitted;
        <section class="result-card @(!isAdmitted ? "result-card--negative" : null)" aria-labelledby="evaluation-result-heading">
            <div class="result-card__hero">
                <div>
                    <p class="eyebrow">@UiText.Get(Context, "ApplicationDetail.FinalResult")</p>
                    <h2 id="evaluation-result-heading">@UiText.Get(Context, "ApplicationDetail.PublishedResult")</h2>
                    <p>@Model.InstituteName · @Model.ProgramName · @Model.AcademicYear · @Model.TermName</p>
                </div>
                <strong>@UiText.LocalizeEvaluationOutcome(Context, result.Outcome)</strong>
            </div>

            <dl class="meta-grid">
                <div>
                    <dt>@UiText.Get(Context, "ApplicationDetail.TotalScore")</dt>
                    <dd>@(result.TotalScore?.ToString("0.0000") ?? "—")</dd>
                </div>
                <div>
                    <dt>@UiText.Get(Context, "ApplicationDetail.Rank")</dt>
                    <dd>@(result.Rank?.ToString() ?? "—")</dd>
                </div>
                <div>
                    <dt>@UiText.Get(Context, "ApplicationDetail.Quota")</dt>
                    <dd>@Model.Quota</dd>
                </div>
                <div>
                    <dt>@UiText.Get(Context, "ApplicationDetail.PublishedAt")</dt>
                    <dd>@IstanbulTime.FromUtc(result.ResultsPublishedAtUtc).ToString("dd.MM.yyyy HH:mm")</dd>
                </div>
            </dl>

            @if (result.Components.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle responsive-table">
                        <caption>@UiText.Get(Context, "ApplicationDetail.ComponentsCaption")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@UiText.Get(Context, "ApplicationDetail.Criterion")</th>
                                <th scope="col">@UiText.Get(Context, "ApplicationDetail.RawScore")</th>
                                <th scope="col">@UiText.Get(Context, "ApplicationDetail.NormalizedScore")</th>
                                <th scope="col">@UiText.Get(Context, "ApplicationDetail.Weight")</th>
                                <th scope="col">@UiText.Get(Context, "ApplicationDetail.Contribution")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var component in result.Components)
                            {
                                <tr>
                                    <th scope="row" data-label="@UiText.Get(Context, "ApplicationDetail.Criterion")">@component.DisplayName</th>
                                    <td data-label="@UiText.Get(Context, "ApplicationDetail.RawScore")">@component.RawScore.ToString("0.0000")</td>
                                    <td data-label="@UiText.Get(Context, "ApplicationDetail.NormalizedScore")">@component.NormalizedScore.ToString("0.0000")</td>
                                    <td data-label="@UiText.Get(Context, "ApplicationDetail.Weight")">@((component.WeightBasisPoints / 100m).ToString("0.##"))%</td>
                                    <td data-label="@UiText.Get(Context, "ApplicationDetail.Contribution")">@component.WeightedScore.ToString("0.0000")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <p class="snapshot-note">
                @UiText.Get(Context, "ApplicationDetail.SnapshotNote")
            </p>
        </section>
    }
}

<section class="section-heading" aria-labelledby="documents-heading">
    <div>
        <p class="eyebrow">@UiText.Get(Context, "ApplicationDetail.DocumentEyebrow")</p>
        <h2 id="documents-heading">@UiText.Get(Context, "ApplicationDetail.Documents")</h2>
    </div>
</section>

@if (!Model.UsesDocumentWorkflow)
{
    <div class="alert alert-info" role="status">
        @UiText.Get(Context, "ApplicationDetail.LegacyDocuments")
    </div>
}
else
{
    @if (Model.CanUpdateDocuments && Model.ApplicationDeadlineUtc.HasValue)
    {
        <div class="alert alert-info" role="status">
            @UiText.Format(Context, "ApplicationDetail.UpdateUntil",
                IstanbulTime.FromUtc(Model.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm"))
        </div>
    }
    else if (Model.CurrentStatus is ApplicationStatus.Draft or ApplicationStatus.Pending or ApplicationStatus.UnderReview)
    {
        <div class="alert alert-secondary" role="status">
            @UiText.Get(Context, "ApplicationDetail.UpdateClosed")
        </div>
    }

    @if (Model.MissingRequiredDocuments.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@UiText.Get(Context, "ApplicationDetail.MissingDocuments")</strong> @string.Join(", ", Model.MissingRequiredDocuments)
        </div>
    }

    <div class="document-list">
        @foreach (var requirement in Model.DocumentRequirements)
        {
            var document = requirement.CurrentDocument;
            var canUpload = Model.CanUpdateDocuments;

            <article class="document-card @(requirement.IsRequired ? "document-card--required" : null)">
                <header>
                    <div>
                        <h3>@requirement.DisplayName</h3>
                        <span class="status-badge">
                            @(requirement.IsRequired ? UiText.Get(Context, "ApplicationDetail.Required") : UiText.Get(Context, "ApplicationDetail.Optional"))
                        </span>
                    </div>
                    <dl>
                        <div>
                            <dt>@UiText.Get(Context, "ApplicationDetail.FileType")</dt>
                            <dd>@UiText.LocalizeDocumentCategory(Context, requirement.AllowedContentCategory)</dd>
                        </div>
                        <div>
                            <dt>@UiText.Get(Context, "ApplicationDetail.Maximum")</dt>
                            <dd>@DocumentPresentation.FileSize(requirement.MaximumBytes)</dd>
                        </div>
                    </dl>
                </header>

                @if (!string.IsNullOrWhiteSpace(requirement.Description))
                {
                    <p>@requirement.Description</p>
                }

                @if (document is not null)
                {
                    <section class="document-current" aria-label="@UiText.Format(Context, "ApplicationDetail.UploadedDocumentAria", requirement.DisplayName)">
                        <dl class="meta-grid">
                            <div>
                                <dt>@UiText.Get(Context, "ApplicationDetail.File")</dt>
                                <dd>@document.OriginalFileName</dd>
                            </div>
                            <div>
                                <dt>@UiText.Get(Context, "ApplicationDetail.Version")</dt>
                                <dd>@document.VersionNumber</dd>
                            </div>
                            <div>
                                <dt>@UiText.Get(Context, "ApplicationDetail.UploadedAt")</dt>
                                <dd>@IstanbulTime.FromUtc(document.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</dd>
                            </div>
                            <div>
                                <dt>@UiText.Get(Context, "ApplicationDetail.Review")</dt>
                                <dd>@UiText.LocalizeDocumentReview(Context, document.ReviewStatus)</dd>
                            </div>
                        </dl>
                        @if (document.ReviewStatus == DocumentReviewStatus.Rejected)
                        {
                            <div class="alert alert-danger" role="alert">
                                <strong>@UiText.Get(Context, "ApplicationDetail.RejectionReason")</strong> @document.RejectionReason
                            </div>
                        }
                        <a asp-action="DownloadDocument"
                           asp-route-publicId="@Model.PublicId"
                           asp-route-documentPublicId="@document.PublicId"
                           class="btn btn-outline-secondary">@UiText.Get(Context, "ApplicationDetail.Download")</a>
                    </section>
                }
                else
                {
                    <p class="empty-inline">@UiText.Get(Context, "ApplicationDetail.NoDocument")</p>
                }

                @if (canUpload)
                {
                    @if (document?.ReviewStatus == DocumentReviewStatus.Approved)
                    {
                        <div class="alert alert-warning" role="alert">
                            @UiText.Get(Context, "ApplicationDetail.ApprovalReset")
                        </div>
                    }
                    <form asp-action="UploadDocument"
                          asp-route-publicId="@Model.PublicId"
                          asp-route-requirementPublicId="@requirement.PublicId"
                          method="post"
                          enctype="multipart/form-data"
                          class="upload-form">
                        <label class="form-label" for="file-@requirement.PublicId">
                            @(document is null ? UiText.Get(Context, "ApplicationDetail.Upload") : UiText.Get(Context, "ApplicationDetail.UpdateDocument"))
                        </label>
                        <div class="input-group">
                            <input id="file-@requirement.PublicId"
                                   name="file"
                                   type="file"
                                   class="form-control"
                                   accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                   required />
                            <button type="submit" class="btn btn-primary">
                                @(document is null ? UiText.Get(Context, "ApplicationDetail.UploadButton") : UiText.Get(Context, "ApplicationDetail.UpdateDocument"))
                            </button>
                        </div>
                    </form>
                }
            </article>
        }
    </div>

    @if (Model.CurrentStatus == ApplicationStatus.Draft)
    {
        <form asp-action="SubmitApplication" asp-route-publicId="@Model.PublicId" method="post" class="submission-panel">
            <div>
                <h2>@UiText.Get(Context, "ApplicationDetail.Submit")</h2>
                <p>@UiText.Get(Context, "ApplicationDetail.SubmitLead")</p>
                @if (!canSubmit)
                {
                    if (hasInvalidRequirementConfiguration)
                    {
                        <p class="text-warning">@UiText.Get(Context, "ApplicationDetail.InvalidConfiguration")</p>
                    }
                    else
                    {
                        <p class="text-muted">@UiText.Get(Context, "ApplicationDetail.UploadRequired")</p>
                    }
                }
            </div>
            <button type="submit" class="btn btn-success" disabled="@(!canSubmit)">@UiText.Get(Context, "ApplicationDetail.Submit")</button>
        </form>
    }
}

@if (Model.CanWithdraw)
{
    <section class="danger-zone" aria-labelledby="withdraw-application-heading">
        <h2 id="withdraw-application-heading">@UiText.Get(Context, "ApplicationDetail.Withdraw")</h2>
        <p>
            @UiText.Get(Context, "ApplicationDetail.WithdrawLead")
        </p>
        <form asp-action="WithdrawApplication" asp-route-publicId="@Model.PublicId" method="post">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-danger">@UiText.Get(Context, "ApplicationDetail.Withdraw")</button>
        </form>
    </section>
}
else if (Model.CanReactivate)
{
    <section class="submission-panel" aria-labelledby="reactivate-application-heading">
        <div>
            <h2 id="reactivate-application-heading">@UiText.Get(Context, "ApplicationDetail.Reactivate")</h2>
            <p>
                @UiText.Get(Context, "ApplicationDetail.ReactivateLead")
            </p>
        </div>
        <form asp-action="ReactivateApplication" asp-route-publicId="@Model.PublicId" method="post">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-primary">@UiText.Get(Context, "ApplicationDetail.ReactivateDraft")</button>
        </form>
    </section>
}

<a asp-action="Index" class="btn btn-link mt-3">@UiText.Get(Context, "ApplicationDetail.Back")</a>
