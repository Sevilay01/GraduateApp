@model StudentApplicationDetailViewModel
@{
    ViewData["Title"] = "Başvuru detayı";
    var hasInvalidRequirementConfiguration = !Model.HasValidRequiredDocumentConfiguration();
    var canSubmit = Model.CanSubmitDocumentWorkflow();
}

<header class="page-heading">
    <div>
        <p class="eyebrow">Başvuru detayı</p>
        <h1>@Model.ProgramName</h1>
        <p>@Model.InstituteName · @Model.AcademicYear · @Model.TermName</p>
    </div>
    <partial name="_ApplicationStatusBadge" model="Model.CurrentStatus" />
</header>

<partial name="_ApplicationProgress" model="Model.CurrentStatus" />

@if (Model.UsesEvaluationWorkflow)
{
    if (Model.PublishedEvaluation is null)
    {
        <section class="empty-state empty-state--compact" aria-labelledby="evaluation-pending-heading">
            <h2 id="evaluation-pending-heading">Değerlendirme sürüyor</h2>
            <p>Sonuçlar kesinleştirilip yayımlanana kadar puan, sıralama ve karar gösterilmez.</p>
        </section>
    }
    else
    {
        var result = Model.PublishedEvaluation;
        var isAdmitted = result.Outcome == EvaluationOutcome.Admitted;
        <section class="result-card @(!isAdmitted ? "result-card--negative" : null)" aria-labelledby="evaluation-result-heading">
            <div class="result-card__hero">
                <div>
                    <p class="eyebrow">Kesinleşmiş sonuç</p>
                    <h2 id="evaluation-result-heading">Yayımlanmış değerlendirme sonucu</h2>
                    <p>@Model.InstituteName · @Model.ProgramName · @Model.AcademicYear · @Model.TermName</p>
                </div>
                <strong>@result.Outcome.DisplayName()</strong>
            </div>

            <dl class="meta-grid">
                <div>
                    <dt>Toplam puan</dt>
                    <dd>@(result.TotalScore?.ToString("0.0000") ?? "—")</dd>
                </div>
                <div>
                    <dt>Sıralama</dt>
                    <dd>@(result.Rank?.ToString() ?? "—")</dd>
                </div>
                <div>
                    <dt>Kontenjan</dt>
                    <dd>@Model.Quota</dd>
                </div>
                <div>
                    <dt>Yayımlanma</dt>
                    <dd>@IstanbulTime.FromUtc(result.ResultsPublishedAtUtc).ToString("dd.MM.yyyy HH:mm")</dd>
                </div>
            </dl>

            @if (result.Components.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle responsive-table">
                        <caption>Değerlendirme puanı bileşenleri</caption>
                        <thead>
                            <tr>
                                <th scope="col">Kriter</th>
                                <th scope="col">Ham puan</th>
                                <th scope="col">Normalize puan</th>
                                <th scope="col">Ağırlık</th>
                                <th scope="col">Katkı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var component in result.Components)
                            {
                                <tr>
                                    <th scope="row" data-label="Kriter">@component.DisplayName</th>
                                    <td data-label="Ham puan">@component.RawScore.ToString("0.0000")</td>
                                    <td data-label="Normalize puan">@component.NormalizedScore.ToString("0.0000")</td>
                                    <td data-label="Ağırlık">@((component.WeightBasisPoints / 100m).ToString("0.##"))%</td>
                                    <td data-label="Katkı">@component.WeightedScore.ToString("0.0000")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <p class="snapshot-note">
                Bu sonuç, başvuru ve değerlendirme anında kaydedilen kesinleşmiş snapshot verilerine dayanır.
            </p>
        </section>
    }
}

<section class="section-heading" aria-labelledby="documents-heading">
    <div>
        <p class="eyebrow">Güvenli belge akışı</p>
        <h2 id="documents-heading">Başvuru belgeleri</h2>
    </div>
</section>

@if (!Model.UsesDocumentWorkflow)
{
    <div class="alert alert-info" role="status">
        Bu başvuru legacy belge iş akışını kullanıyor. Mevcut erişim ve durum kuralları korunur.
    </div>
}
else
{
    @if (Model.CanUpdateDocuments && Model.ApplicationDeadlineUtc.HasValue)
    {
        <div class="alert alert-info" role="status">
            Belgelerinizi son başvuru tarihi olan
            <strong>@IstanbulTime.FromUtc(Model.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm")</strong>
            anına kadar güncelleyebilirsiniz. Yeni sürüm yeniden incelenir.
        </div>
    }
    else if (Model.CurrentStatus is ApplicationStatus.Draft or ApplicationStatus.Pending or ApplicationStatus.UnderReview)
    {
        <div class="alert alert-secondary" role="status">
            İlan kapalı olduğu veya son başvuru tarihi geçtiği için belgeler artık güncellenemez.
        </div>
    }

    @if (Model.MissingRequiredDocuments.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Eksik zorunlu belgeler:</strong> @string.Join(", ", Model.MissingRequiredDocuments)
        </div>
    }

    <div class="document-list">
        @foreach (var requirement in Model.DocumentRequirements)
        {
            var document = requirement.CurrentDocument;
            var canUpload = Model.CanUpdateDocuments;

            <article class="document-card @(requirement.IsRequired ? "document-card--required" : null)">
                <header>
                    <div>
                        <h3>@requirement.DisplayName</h3>
                        <span class="status-badge">
                            @(requirement.IsRequired ? "Zorunlu" : "İsteğe bağlı")
                        </span>
                    </div>
                    <dl>
                        <div>
                            <dt>Dosya türü</dt>
                            <dd>@requirement.AllowedContentCategory.CategoryName()</dd>
                        </div>
                        <div>
                            <dt>En fazla</dt>
                            <dd>@DocumentPresentation.FileSize(requirement.MaximumBytes)</dd>
                        </div>
                    </dl>
                </header>

                @if (!string.IsNullOrWhiteSpace(requirement.Description))
                {
                    <p>@requirement.Description</p>
                }

                @if (document is not null)
                {
                    <section class="document-current" aria-label="@requirement.DisplayName yüklü belge bilgileri">
                        <dl class="meta-grid">
                            <div>
                                <dt>Dosya</dt>
                                <dd>@document.OriginalFileName</dd>
                            </div>
                            <div>
                                <dt>Sürüm</dt>
                                <dd>@document.VersionNumber</dd>
                            </div>
                            <div>
                                <dt>Yükleme</dt>
                                <dd>@IstanbulTime.FromUtc(document.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</dd>
                            </div>
                            <div>
                                <dt>İnceleme</dt>
                                <dd>@document.ReviewStatus.ReviewName()</dd>
                            </div>
                        </dl>
                        @if (document.ReviewStatus == DocumentReviewStatus.Rejected)
                        {
                            <div class="alert alert-danger" role="alert">
                                <strong>Ret gerekçesi:</strong> @document.RejectionReason
                            </div>
                        }
                        <a asp-action="DownloadDocument"
                           asp-route-publicId="@Model.PublicId"
                           asp-route-documentPublicId="@document.PublicId"
                           class="btn btn-outline-secondary">Belgeyi indir</a>
                    </section>
                }
                else
                {
                    <p class="empty-inline">Henüz belge yüklenmedi.</p>
                }

                @if (canUpload)
                {
                    @if (document?.ReviewStatus == DocumentReviewStatus.Approved)
                    {
                        <div class="alert alert-warning" role="alert">
                            Bu belgeyi güncellerseniz mevcut onay geçersiz olur ve yeni sürüm yeniden incelenir.
                        </div>
                    }
                    <form asp-action="UploadDocument"
                          asp-route-publicId="@Model.PublicId"
                          asp-route-requirementPublicId="@requirement.PublicId"
                          method="post"
                          enctype="multipart/form-data"
                          class="upload-form">
                        <label class="form-label" for="file-@requirement.PublicId">
                            @(document is null ? "Belge yükle" : "Belgeyi güncelle")
                        </label>
                        <div class="input-group">
                            <input id="file-@requirement.PublicId"
                                   name="file"
                                   type="file"
                                   class="form-control"
                                   accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                   required />
                            <button type="submit" class="btn btn-primary">
                                @(document is null ? "Yükle" : "Belgeyi güncelle")
                            </button>
                        </div>
                    </form>
                }
            </article>
        }
    </div>

    @if (Model.CurrentStatus == ApplicationStatus.Draft)
    {
        <form asp-action="SubmitApplication" asp-route-publicId="@Model.PublicId" method="post" class="submission-panel">
            <div>
                <h2>Başvuruyu gönder</h2>
                <p>Göndermeden önce tüm zorunlu belgelerin doğru ve güncel olduğunu kontrol edin.</p>
                @if (!canSubmit)
                {
                    if (hasInvalidRequirementConfiguration)
                    {
                        <p class="text-warning">Bu taslak için geçerli zorunlu belge koşulu bulunmuyor. İlan yöneticisiyle iletişime geçin.</p>
                    }
                    else
                    {
                        <p class="text-muted">Önce tüm zorunlu belgeleri yükleyin.</p>
                    }
                }
            </div>
            <button type="submit" class="btn btn-success" disabled="@(!canSubmit)">Başvuruyu gönder</button>
        </form>
    }
}

@if (Model.CanWithdraw)
{
    <section class="danger-zone" aria-labelledby="withdraw-application-heading">
        <h2 id="withdraw-application-heading">Başvuruyu geri çek</h2>
        <p>
            Geri çekilen başvuru değerlendirme ve kontenjan hesabının dışında kalır.
            İlan açık ve son tarih geçmemişse daha sonra yeniden etkinleştirebilirsiniz;
            bu durumda başvuru taslağa döner ve yeniden gönderilmesi gerekir.
        </p>
        <form asp-action="WithdrawApplication" asp-route-publicId="@Model.PublicId" method="post">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-danger">Başvuruyu geri çek</button>
        </form>
    </section>
}
else if (Model.CanReactivate)
{
    <section class="submission-panel" aria-labelledby="reactivate-application-heading">
        <div>
            <h2 id="reactivate-application-heading">Başvuruyu yeniden etkinleştir</h2>
            <p>
                Belgeleriniz korunur. Eski puan ve değerlendirme snapshot’ları temizlenir;
                güncel bilgileri kontrol ettikten sonra başvuruyu yeniden göndermeniz gerekir.
            </p>
        </div>
        <form asp-action="ReactivateApplication" asp-route-publicId="@Model.PublicId" method="post">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-primary">Taslak olarak yeniden etkinleştir</button>
        </form>
    </section>
}

<a asp-action="Index" class="btn btn-link mt-3">Panele dön</a>
