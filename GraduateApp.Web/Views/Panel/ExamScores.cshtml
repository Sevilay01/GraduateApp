@model StudentExamScoresPageViewModel
@{
    ViewData["Title"] = "Sınav sonuçlarım";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Sınav sonuçlarım</h1>
        <p class="text-muted mb-0">Başvurularda kullanılacak güncel sınav sonuçlarınızı yönetin.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Öğrenci paneline dön</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <section aria-labelledby="scores-heading">
            <h2 id="scores-heading" class="h4">Kayıtlı sonuçlar</h2>
            @if (Model.Scores.Count == 0)
            {
                <p class="text-muted">Henüz bir sınav sonucu eklemediniz.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr><th>Sınav</th><th>Puan</th><th>Sınav tarihi</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var score in Model.Scores)
                            {
                                <tr>
                                    <td>@score.ExamName</td>
                                    <td>@score.Score.ToString("0.##")</td>
                                    <td>@(score.ExamDate?.ToString("dd.MM.yyyy") ?? "Belirtilmemiş")</td>
                                    <td class="text-end">
                                        <a asp-action="ExamScores" asp-route-editId="@score.ScoreId" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                        <form asp-action="DeleteExamScore" method="post" class="d-inline"
                                              onsubmit="return confirm('Bu sınav sonucunu silmek istediğinizden emin misiniz?');">
                                            <input type="hidden" name="scoreId" value="@score.ScoreId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-12 col-lg-5">
        <section class="card" aria-labelledby="score-form-heading">
            <div class="card-body">
                <h2 id="score-form-heading" class="h4">@(Model.Form.ScoreId > 0 ? "Sonucu güncelle" : "Yeni sonuç ekle")</h2>
                <form asp-action="SaveExamScore" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <input asp-for="Form.ScoreId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Form.ExamId" class="form-label"></label>
                        <select asp-for="Form.ExamId" class="form-select" id="exam-select">
                            <option value="0">Sınav seçiniz</option>
                            @foreach (var exam in Model.Exams)
                            {
                                <option value="@exam.ExamId" data-maximum-score="@exam.MaximumScore.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @exam.ExamName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Form.ExamId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Score" class="form-label"></label>
                        <input asp-for="Form.Score" class="form-control" type="number" min="0" max="999.99" step="0.01" id="score-input" />
                        <div class="form-text" id="score-help">ALES, YDS ve YÖKDİL puanları 0–100 aralığında olmalıdır.</div>
                        <span asp-validation-for="Form.Score" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.ExamDate" class="form-label"></label>
                        <input asp-for="Form.ExamDate" class="form-control" type="date" max="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Form.ExamDate" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    @if (Model.Form.ScoreId > 0)
                    {
                        <a asp-action="ExamScores" class="btn btn-outline-secondary">Vazgeç</a>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const examSelect = document.getElementById('exam-select');
            const scoreInput = document.getElementById('score-input');
            const updateMaximum = () => {
                const option = examSelect.options[examSelect.selectedIndex];
                scoreInput.max = option?.dataset.maximumScore ?? '999.99';
            };
            examSelect.addEventListener('change', updateMaximum);
            updateMaximum();
        })();
    </script>
}
