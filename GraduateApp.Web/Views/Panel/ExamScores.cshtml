@model StudentExamScoresPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "ExamScores.Title");
}

<div class="page-heading">
    <div>
        <span class="eyebrow">@UiText.Get(Context, "ExamScores.Eyebrow")</span>
        <h1 class="page-heading__title">@UiText.Get(Context, "ExamScores.Title")</h1>
        <p class="page-heading__description">@UiText.Get(Context, "ExamScores.Lead")</p>
    </div>
    <div class="page-heading__actions">
        <a asp-action="Index" class="btn btn-outline-primary">@UiText.Get(Context, "Profile.Back")</a>
    </div>
</div>

<div class="profile-note mb-4" role="note">
    @UiText.Get(Context, "ExamScores.ValidityNote")
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning app-alert" role="alert">
        <strong>@UiText.Get(Context, "ExamScores.PartialWarning")</strong>
        <span>@Model.ErrorMessage</span>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section aria-labelledby="scores-heading">
            <div class="section-heading">
                <h2 id="scores-heading">@UiText.Get(Context, "ExamScores.Registered")</h2>
            </div>
            @if (Model.Scores.Count == 0)
            {
                <div class="empty-state">
                    <h3>@UiText.Get(Context, "ExamScores.Empty")</h3>
                    <p>@UiText.Get(Context, "ExamScores.EmptyLead")</p>
                </div>
            }
            else
            {
                <div class="table-shell">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle responsive-table">
                            <thead>
                                <tr><th>@UiText.Get(Context, "ExamScores.ExamType")</th><th>@UiText.Get(Context, "ExamScores.Score")</th><th>@UiText.Get(Context, "ExamScores.ResultDate")</th><th>@UiText.Get(Context, "ExamScores.Validity")</th><th><span class="visually-hidden">@UiText.Get(Context, "ExamScores.Actions")</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var score in Model.Scores)
                                {
                                    <tr>
                                        <td data-label="@UiText.Get(Context, "ExamScores.ExamType")"><strong>@score.ExamName</strong></td>
                                        <td data-label="@UiText.Get(Context, "ExamScores.Score")">@score.Score.ToString("0.##")</td>
                                        <td data-label="@UiText.Get(Context, "ExamScores.ResultDate")">@(score.ExamDate?.ToString("dd.MM.yyyy") ?? UiText.Get(Context, "ExamScores.NotSpecified"))</td>
                                        <td data-label="@UiText.Get(Context, "ExamScores.Validity")"><span class="small text-muted">@UiText.Get(Context, "ExamScores.ByOffering")</span></td>
                                        <td data-label="" class="text-end">
                                            <a asp-action="ExamScores" asp-route-editId="@score.ScoreId" class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Common.Edit")</a>
                                            <form asp-action="DeleteExamScore" method="post" class="d-inline"
                                                  onsubmit="return confirm('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(UiText.Get(Context, "ExamScores.DeleteConfirm"))');">
                                                <input type="hidden" name="scoreId" value="@score.ScoreId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@UiText.Get(Context, "Common.Delete")</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card" aria-labelledby="score-form-heading">
            <div class="card-body p-4">
                <span class="eyebrow">@(Model.Form.ScoreId > 0 ? UiText.Get(Context, "ExamScores.UpdateEyebrow") : UiText.Get(Context, "ExamScores.NewEyebrow"))</span>
                <h2 id="score-form-heading" class="h4">@(Model.Form.ScoreId > 0 ? UiText.Get(Context, "ExamScores.UpdateTitle") : UiText.Get(Context, "ExamScores.NewTitle"))</h2>
                <form asp-action="SaveExamScore" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input asp-for="Form.ScoreId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Form.ExamId" class="form-label"></label>
                        <select asp-for="Form.ExamId" class="form-select" id="exam-select">
                            <option value="0">@UiText.Get(Context, "ExamScores.SelectExam")</option>
                            @foreach (var exam in Model.Exams)
                            {
                                <option value="@exam.ExamId" data-maximum-score="@exam.MaximumScore.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @exam.ExamName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Form.ExamId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Score" class="form-label"></label>
                        <input asp-for="Form.Score" class="form-control" type="text" inputmode="decimal" id="score-input" />
                        <div class="form-text" id="score-help">@UiText.Get(Context, "ExamScores.ScoreHelp")</div>
                        <span asp-validation-for="Form.Score" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Form.ExamDate" class="form-label"></label>
                        <input asp-for="Form.ExamDate" class="form-control" type="date" max="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Form.ExamDate" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Common.Save")</button>
                    @if (Model.Form.ScoreId > 0)
                    {
                        <a asp-action="ExamScores" class="btn btn-outline-secondary">@UiText.Get(Context, "Common.Cancel")</a>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const examSelect = document.getElementById('exam-select');
            const scoreInput = document.getElementById('score-input');
            const updateMaximum = () => {
                const option = examSelect.options[examSelect.selectedIndex];
                const maximum = option?.dataset.maximumScore ?? '999.99';
                scoreInput.dataset.valLocalizeddecimalMax = maximum;

                const validator = window.jQuery?.(scoreInput.form).data('validator');
                const localizedRule = validator?.settings?.rules?.[scoreInput.name]?.localizeddecimal;
                if (localizedRule) {
                    localizedRule.max = maximum;
                }
            };
            examSelect.addEventListener('change', updateMaximum);
            updateMaximum();
        })();
    </script>
}
