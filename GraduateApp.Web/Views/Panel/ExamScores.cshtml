@model StudentExamScoresPageViewModel
@{
    ViewData["Title"] = "Sınav sonuçlarım";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Başvuru verileri</span>
        <h1 class="page-heading__title">Sınav sonuçlarım</h1>
        <p class="page-heading__description">Başvurularda kullanılacak güncel sınav puanlarınızı ve sınav tarihlerinizi yönetin.</p>
    </div>
    <div class="page-heading__actions">
        <a asp-action="Index" class="btn btn-outline-primary">Öğrenci paneline dön</a>
    </div>
</div>

<div class="profile-note mb-4" role="note">
    Sınav puanının geçerliliği, başvurduğunuz ilandaki sınav türü ve asgari geçerlilik tarihi koşullarına göre değerlendirilir.
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning app-alert" role="alert">
        <strong>Sınav sonuçları eksik olabilir.</strong>
        <span>@Model.ErrorMessage</span>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section aria-labelledby="scores-heading">
            <div class="section-heading">
                <h2 id="scores-heading">Kayıtlı sonuçlar</h2>
            </div>
            @if (Model.Scores.Count == 0)
            {
                <div class="empty-state">
                    <h3>Henüz sınav sonucu eklemediniz</h3>
                    <p>Yeni sonuç formundan sınav türünü, puanınızı ve sınav tarihinizi kaydedebilirsiniz.</p>
                </div>
            }
            else
            {
                <div class="table-shell">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle responsive-table">
                            <thead>
                                <tr><th>Sınav türü</th><th>Puan</th><th>Sınav tarihi</th><th>Geçerlilik</th><th><span class="visually-hidden">İşlemler</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var score in Model.Scores)
                                {
                                    <tr>
                                        <td data-label="Sınav türü"><strong>@score.ExamName</strong></td>
                                        <td data-label="Puan">@score.Score.ToString("0.##")</td>
                                        <td data-label="Sınav tarihi">@(score.ExamDate?.ToString("dd.MM.yyyy") ?? "Belirtilmemiş")</td>
                                        <td data-label="Geçerlilik"><span class="small text-muted">İlan koşuluna göre</span></td>
                                        <td data-label="" class="text-end">
                                            <a asp-action="ExamScores" asp-route-editId="@score.ScoreId" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                            <form asp-action="DeleteExamScore" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bu sınav sonucunu silmek istediğinizden emin misiniz?');">
                                                <input type="hidden" name="scoreId" value="@score.ScoreId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card" aria-labelledby="score-form-heading">
            <div class="card-body p-4">
                <span class="eyebrow">@(Model.Form.ScoreId > 0 ? "Kayıt güncelleme" : "Yeni kayıt")</span>
                <h2 id="score-form-heading" class="h4">@(Model.Form.ScoreId > 0 ? "Sınav sonucunu güncelle" : "Yeni sınav sonucu ekle")</h2>
                <form asp-action="SaveExamScore" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input asp-for="Form.ScoreId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Form.ExamId" class="form-label"></label>
                        <select asp-for="Form.ExamId" class="form-select" id="exam-select">
                            <option value="0">Sınav seçiniz</option>
                            @foreach (var exam in Model.Exams)
                            {
                                <option value="@exam.ExamId" data-maximum-score="@exam.MaximumScore.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @exam.ExamName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Form.ExamId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Score" class="form-label"></label>
                        <input asp-for="Form.Score" class="form-control" type="number" min="0" max="999.99" step="0.01" id="score-input" />
                        <div class="form-text" id="score-help">ALES, YDS ve YÖKDİL puanları 0–100 aralığında olmalıdır.</div>
                        <span asp-validation-for="Form.Score" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Form.ExamDate" class="form-label"></label>
                        <input asp-for="Form.ExamDate" class="form-control" type="date" max="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3)).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Form.ExamDate" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    @if (Model.Form.ScoreId > 0)
                    {
                        <a asp-action="ExamScores" class="btn btn-outline-secondary">Vazgeç</a>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const examSelect = document.getElementById('exam-select');
            const scoreInput = document.getElementById('score-input');
            const updateMaximum = () => {
                const option = examSelect.options[examSelect.selectedIndex];
                scoreInput.max = option?.dataset.maximumScore ?? '999.99';
            };
            examSelect.addEventListener('change', updateMaximum);
            updateMaximum();
        })();
    </script>
}
