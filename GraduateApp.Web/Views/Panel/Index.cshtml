@model PanelDashboardViewModel
@{
    ViewData["Title"] = "Öğrenci paneli";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">Öğrenci işlemleri</span>
        <h1 class="page-heading__title">Öğrenci paneli</h1>
        <p class="page-heading__description">Açık programları inceleyin ve başvurularınızın güncel durumunu takip edin.</p>
    </div>
    <div class="page-heading__actions">
        <a asp-action="ExamScores" class="btn btn-outline-primary">Sınav sonuçlarım</a>
        <a asp-action="Profile" class="btn btn-outline-primary">Profil ve eğitim bilgilerim</a>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning app-alert" role="alert">
        <strong>Panel bilgileri eksik olabilir.</strong>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="mb-5" aria-labelledby="programs-heading">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Yeni başvuru</span>
            <h2 id="programs-heading">Başvuruya açık programlar</h2>
        </div>
        <p>Koşulları karşılaştırın ve başvuru taslağınızı oluşturun.</p>
    </div>

    <form asp-action="Index" method="get" class="admin-filter-panel mb-4" role="search" aria-label="Açık programlarda ara">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-6">
                <label for="open-program-search" class="form-label">Program, enstitü veya derece ara</label>
                <input id="open-program-search"
                       name="search"
                       value="@Model.ProgramSearch.Search"
                       maxlength="@OpenProgramSearchViewModel.MaximumSearchLength"
                       class="form-control"
                       placeholder="Örn. Bilgisayar, Fen Bilimleri veya Doktora" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-year" class="form-label">Akademik yıl başlangıcı</label>
                <input id="open-program-year"
                       name="academicYearStart"
                       value="@Model.ProgramSearch.AcademicYearStart"
                       type="number"
                       min="2000"
                       max="2200"
                       class="form-control"
                       placeholder="2026" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-term" class="form-label">Dönem</label>
                <select id="open-program-term" name="term" class="form-select">
                    <option value="">Tüm dönemler</option>
                    @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                    {
                        <option value="@term" selected="@(Model.ProgramSearch.Term == term ? "selected" : null)">@term.DisplayName()</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-check mt-3">
            <input id="prefer-undergraduate-program"
                   name="preferUndergraduateProgram"
                   type="checkbox"
                   value="true"
                   checked="@(Model.ProgramSearch.PreferUndergraduateProgram ? "checked" : null)"
                   class="form-check-input" />
            <label for="prefer-undergraduate-program" class="form-check-label">
                Mezuniyet programımla aynı alanı taşıyan ilanları öne çıkar
            </label>
            <div class="form-text">
                Program adları karşılaştırılır; ilandaki tezli/tezsiz yüksek lisans veya doktora gibi derece ekleri eşleştirmeyi değiştirmez.
                Resmî başvuru uygunluğu kararı değildir ve hiçbir ilana başvurmanızı engellemez.
            </div>
        </div>
        <div class="admin-form-actions mt-3">
            <button type="submit" class="btn btn-primary">Programları ara</button>
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Filtreleri temizle</a>
            }
        </div>
    </form>

    @if (Model.RecommendationMessage is not null)
    {
        <div class="alert alert-info app-alert" role="status" data-profile-recommendation>
            <strong>Profil önerisi</strong>
            <span>@Model.RecommendationMessage</span>
            @if (!string.IsNullOrWhiteSpace(Model.GraduatedProgram))
            {
                <small>Profildeki program: @Model.GraduatedProgram</small>
            }
        </div>
    }

    @if (Model.OpenPrograms.Count == 0)
    {
        <div class="empty-state">
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <h3>Arama ölçütlerine uygun açık program bulunamadı</h3>
                <p>Arama metnini veya akademik dönem filtrelerini değiştirerek yeniden deneyin.</p>
                <a asp-action="Index" class="btn btn-outline-primary">Tüm açık programları göster</a>
            }
            else
            {
                <h3>Şu anda başvuruya açık program yok</h3>
                <p>Yeni ilanlar yayımlandığında bu bölümde görüntülenecektir.</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var program in Model.OpenPrograms)
            {
                var existingApplication = Model.Applications.FirstOrDefault(item => item.ProgramOfferingId == program.ProgramOfferingId);
                var alreadyApplied = existingApplication is not null;
                <div class="col-12 col-xl-6">
                    <article class="card program-card h-100">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                                <div>
                                    <div class="program-card__institute">@program.InstituteName</div>
                                    <h3 class="h4 mb-1">@program.ProgramName</h3>
                                    <p class="program-card__degree">@program.DegreeType</p>
                                </div>
                                <div class="d-flex flex-column align-items-end gap-2">
                                    @if (program.IsRecommendedForProfile)
                                    {
                                        <span class="admin-state admin-state--success" data-profile-match>
                                            Program alanı eşleşiyor
                                        </span>
                                    }
                                    @if (existingApplication is not null)
                                    {
                                        <partial name="_ApplicationStatusBadge" model="existingApplication.CurrentStatus" />
                                    }
                                </div>
                            </div>

                            <dl class="meta-grid">
                                <div class="meta-item">
                                    <dt>Akademik dönem</dt>
                                    <dd>@program.AcademicYear · @program.TermName</dd>
                                </div>
                                <div class="meta-item">
                                    <dt>Kontenjan</dt>
                                    <dd>@program.Quota kişi</dd>
                                </div>
                            </dl>

                            <div class="deadline-callout">
                                <div>
                                    <div class="deadline-callout__label">Son başvuru tarihi</div>
                                    <time datetime="@program.ApplicationDeadlineUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(program.ApplicationDeadlineUtc).ToString("dd MMMM yyyy · HH:mm")
                                    </time>
                                    <span class="visually-hidden"> İstanbul saati</span>
                                </div>
                            </div>

                            @if (program.ExamRequirements.Count > 0)
                            {
                                <div class="mb-3">
                                    <h4 class="h6">Sınav koşulları</h4>
                                    <ul class="requirement-list">
                                        @foreach (var requirement in program.ExamRequirements)
                                        {
                                            <li>
                                                <span><strong>@requirement.ExamName</strong> · En az @requirement.MinimumScore.ToString("0.##")</span>
                                                <span class="requirement-kind">@(requirement.IsRequired ? "Zorunlu" : "İsteğe bağlı")</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-3">Bu ilan için ayrıca bir sınav koşulu belirtilmemiştir.</p>
                            }

                            <form asp-action="Apply" method="post" class="mt-auto">
                                <input type="hidden" name="programOfferingId" value="@program.ProgramOfferingId" />
                                <button type="submit" class="btn btn-primary" disabled="@alreadyApplied">
                                    @(alreadyApplied ? "Başvuru oluşturuldu" : "Başvuru taslağı oluştur")
                                </button>
                                @if (existingApplication is not null)
                                {
                                    <a asp-action="ApplicationDetail" asp-route-publicId="@existingApplication.PublicId"
                                       class="btn btn-link">Başvuruyu görüntüle</a>
                                }
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<section aria-labelledby="applications-heading">
    <div class="section-heading">
        <div>
            <span class="eyebrow">Takip</span>
            <h2 id="applications-heading">Başvurularım</h2>
        </div>
    </div>
    @if (Model.Applications.Count == 0)
    {
        <div class="empty-state">
            <h3>Henüz bir başvurunuz bulunmuyor</h3>
            <p>Yukarıdaki açık programlardan birini seçerek başvuru taslağı oluşturabilirsiniz.</p>
        </div>
    }
    else
    {
        <div class="table-shell">
            <div class="table-responsive">
                <table class="table table-hover align-middle responsive-table">
                    <thead>
                        <tr><th>Program</th><th>Akademik dönem</th><th>Başvuru tarihi</th><th>Durum</th><th><span class="visually-hidden">İşlem</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var application in Model.Applications)
                        {
                            <tr>
                                <td data-label="Program"><strong>@application.ProgramName</strong></td>
                                <td data-label="Akademik dönem">@application.AcademicYear · @application.TermName</td>
                                <td data-label="Başvuru tarihi">
                                    <time datetime="@application.ApplicationDateUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(application.ApplicationDateUtc).ToString("dd.MM.yyyy HH:mm")
                                    </time>
                                    <span class="visually-hidden"> İstanbul saati</span>
                                </td>
                                <td data-label="Durum"><partial name="_ApplicationStatusBadge" model="application.CurrentStatus" /></td>
                                <td data-label="">
                                    <a asp-action="ApplicationDetail" asp-route-publicId="@application.PublicId"
                                       class="btn btn-sm btn-outline-primary">Belgeler ve detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
