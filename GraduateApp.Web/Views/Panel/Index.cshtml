@model PanelDashboardViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Panel.Title");
}

<div class="page-heading">
    <div>
        <span class="eyebrow">@UiText.Get(Context, "Panel.Eyebrow")</span>
        <h1 class="page-heading__title">@UiText.Get(Context, "Panel.Title")</h1>
        <p class="page-heading__description">@UiText.Get(Context, "Panel.Lead")</p>
    </div>
    <div class="page-heading__actions">
        <a asp-action="ExamScores" class="btn btn-outline-primary">@UiText.Get(Context, "Panel.ExamScores")</a>
        <a asp-action="Profile" class="btn btn-outline-primary">@UiText.Get(Context, "Panel.Profile")</a>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning app-alert" role="alert">
        <strong>@UiText.Get(Context, "Panel.PartialWarning")</strong>
        <span>@Model.ErrorMessage</span>
    </div>
}

<section class="mb-5" aria-labelledby="programs-heading">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Panel.NewApplication")</span>
            <h2 id="programs-heading">@UiText.Get(Context, "Panel.OpenPrograms")</h2>
        </div>
        <p>@UiText.Get(Context, "Panel.OpenProgramsLead")</p>
    </div>

    <form asp-action="Index" method="get" class="admin-filter-panel mb-4" role="search" aria-label="@UiText.Get(Context, "Panel.SearchAria")">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-6">
                <label for="open-program-search" class="form-label">@UiText.Get(Context, "Panel.SearchLabel")</label>
                <input id="open-program-search"
                       name="search"
                       value="@Model.ProgramSearch.Search"
                       maxlength="@OpenProgramSearchViewModel.MaximumSearchLength"
                       class="form-control"
                       placeholder="@UiText.Get(Context, "Panel.SearchPlaceholder")" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-year" class="form-label">@UiText.Get(Context, "Panel.YearLabel")</label>
                <input id="open-program-year"
                       name="academicYearStart"
                       value="@Model.ProgramSearch.AcademicYearStart"
                       type="number"
                       min="2000"
                       max="2200"
                       class="form-control"
                       placeholder="2026" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-term" class="form-label">@UiText.Get(Context, "Panel.TermLabel")</label>
                <select id="open-program-term" name="term" class="form-select">
                    <option value="">@UiText.Get(Context, "Panel.AllTerms")</option>
                    @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                    {
                        <option value="@term" selected="@(Model.ProgramSearch.Term == term ? "selected" : null)">@UiText.Get(Context, $"AcademicTerm.{term}")</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-check mt-3">
            <input id="prefer-undergraduate-program"
                   name="preferUndergraduateProgram"
                   type="checkbox"
                   value="true"
                   checked="@(Model.ProgramSearch.PreferUndergraduateProgram ? "checked" : null)"
                   class="form-check-input" />
            <label for="prefer-undergraduate-program" class="form-check-label">
                @UiText.Get(Context, "Panel.PreferLabel")
            </label>
            <div class="form-text">
                @UiText.Get(Context, "Panel.PreferHelp")
            </div>
        </div>
        <div class="admin-form-actions mt-3">
            <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Panel.SearchButton")</button>
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "Panel.ClearFilters")</a>
            }
        </div>
    </form>

    @if (Model.RecommendationMessage is not null)
    {
        <div class="alert alert-info app-alert" role="status" data-profile-recommendation>
            <strong>@UiText.Get(Context, "Panel.RecommendationHeading")</strong>
            <span>@Model.RecommendationMessage</span>
            @if (!string.IsNullOrWhiteSpace(Model.GraduatedProgram))
            {
                <small>@UiText.Format(Context, "Panel.ProfileProgram", Model.GraduatedProgram)</small>
            }
        </div>
    }

    @if (Model.OpenPrograms.Count == 0)
    {
        <div class="empty-state">
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <h3>@UiText.Get(Context, "Panel.NoMatch")</h3>
                <p>@UiText.Get(Context, "Panel.TryDifferent")</p>
                <a asp-action="Index" class="btn btn-outline-primary">@UiText.Get(Context, "Panel.ShowAll")</a>
            }
            else
            {
                <h3>@UiText.Get(Context, "Panel.NoPrograms")</h3>
                <p>@UiText.Get(Context, "Panel.NoProgramsLead")</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var program in Model.OpenPrograms)
            {
                var existingApplication = Model.Applications.FirstOrDefault(item => item.ProgramOfferingId == program.ProgramOfferingId);
                var alreadyApplied = existingApplication is not null;
                <div class="col-12 col-xl-6">
                    <article class="card program-card h-100">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                                <div>
                                    <div class="program-card__institute">@program.InstituteName</div>
                                    <h3 class="h4 mb-1">@UiText.SelectLocalized(Context, program.ProgramName, program.ProgramNameEnglish)</h3>
                                    <p class="program-card__degree">@UiText.LocalizeDegreeType(Context, program.DegreeType)</p>
                                </div>
                                <div class="d-flex flex-column align-items-end gap-2">
                                    @if (program.IsRecommendedForProfile)
                                    {
                                        <span class="admin-state admin-state--success" data-profile-match>
                                            @UiText.Get(Context, "Panel.ProfileMatch")
                                        </span>
                                    }
                                    @if (existingApplication is not null)
                                    {
                                        <partial name="_ApplicationStatusBadge" model="existingApplication.CurrentStatus" />
                                    }
                                </div>
                            </div>

                            <dl class="meta-grid">
                                <div class="meta-item">
                                    <dt>@UiText.Get(Context, "Panel.AcademicPeriod")</dt>
                                    <dd>@program.AcademicYear · @UiText.Get(Context, $"AcademicTerm.{program.Term}")</dd>
                                </div>
                                <div class="meta-item">
                                    <dt>@UiText.Get(Context, "Panel.Quota")</dt>
                                    <dd>@UiText.Format(Context, "Home.People", program.Quota)</dd>
                                </div>
                            </dl>

                            <div class="deadline-callout">
                                <div>
                                    <div class="deadline-callout__label">@UiText.Get(Context, "Panel.Deadline")</div>
                                    <time datetime="@program.ApplicationDeadlineUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(program.ApplicationDeadlineUtc).ToString("dd MMMM yyyy · HH:mm")
                                    </time>
                                    <span class="visually-hidden"> @UiText.Get(Context, "Home.IstanbulTime")</span>
                                </div>
                            </div>

                            @if (program.ExamRequirements.Count > 0)
                            {
                                <div class="mb-3">
                                    <h4 class="h6">@UiText.Get(Context, "Panel.ExamRequirements")</h4>
                                    <ul class="requirement-list">
                                        @foreach (var requirement in program.ExamRequirements)
                                        {
                                            <li>
                                                <span><strong>@requirement.ExamName</strong> · @UiText.Get(Context, "Panel.Minimum") @requirement.MinimumScore.ToString("0.##")</span>
                                                <span class="requirement-kind">@(requirement.IsRequired ? UiText.Get(Context, "Panel.Required") : UiText.Get(Context, "Panel.Optional"))</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <p class="small text-muted mb-3">@UiText.Get(Context, "Panel.NoExamRequirement")</p>
                            }

                            <form asp-action="Apply" method="post" class="mt-auto">
                                <input type="hidden" name="programOfferingId" value="@program.ProgramOfferingId" />
                                <button type="submit" class="btn btn-primary" disabled="@alreadyApplied">
                                    @(alreadyApplied ? UiText.Get(Context, "Panel.ApplicationCreated") : UiText.Get(Context, "Panel.CreateDraft"))
                                </button>
                                @if (existingApplication is not null)
                                {
                                    <a asp-action="ApplicationDetail" asp-route-publicId="@existingApplication.PublicId"
                                       class="btn btn-link">@UiText.Get(Context, "Panel.ViewApplication")</a>
                                }
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>

<section aria-labelledby="applications-heading">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Panel.Tracking")</span>
            <h2 id="applications-heading">@UiText.Get(Context, "Panel.MyApplications")</h2>
        </div>
    </div>
    @if (Model.Applications.Count == 0)
    {
        <div class="empty-state">
            <h3>@UiText.Get(Context, "Panel.NoApplications")</h3>
            <p>@UiText.Get(Context, "Panel.NoApplicationsLead")</p>
        </div>
    }
    else
    {
        <div class="table-shell">
            <div class="table-responsive">
                <table class="table table-hover align-middle responsive-table">
                    <thead>
                        <tr><th>@UiText.Get(Context, "Panel.Program")</th><th>@UiText.Get(Context, "Panel.AcademicPeriod")</th><th>@UiText.Get(Context, "Panel.ApplicationDate")</th><th>@UiText.Get(Context, "Panel.Status")</th><th><span class="visually-hidden">@UiText.Get(Context, "Panel.Action")</span></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var application in Model.Applications)
                        {
                            <tr>
                                <td data-label="@UiText.Get(Context, "Panel.Program")"><strong>@UiText.SelectLocalized(Context, application.ProgramName, application.ProgramNameEnglish)</strong></td>
                                <td data-label="@UiText.Get(Context, "Panel.AcademicPeriod")">@application.AcademicYear · @UiText.Get(Context, $"AcademicTerm.{application.Term}")</td>
                                <td data-label="@UiText.Get(Context, "Panel.ApplicationDate")">
                                    <time datetime="@application.ApplicationDateUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(application.ApplicationDateUtc).ToString("dd.MM.yyyy HH:mm")
                                    </time>
                                    <span class="visually-hidden"> @UiText.Get(Context, "Home.IstanbulTime")</span>
                                </td>
                                <td data-label="@UiText.Get(Context, "Panel.Status")"><partial name="_ApplicationStatusBadge" model="application.CurrentStatus" /></td>
                                <td data-label="">
                                    <a asp-action="ApplicationDetail" asp-route-publicId="@application.PublicId"
                                       class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Panel.DocumentsDetails")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
