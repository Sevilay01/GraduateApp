@model UniversityPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Universities.Title");
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Admin.Catalog.Eyebrow")</span>
            <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Universities.Heading")</h1>
            <p class="page-heading__description">@UiText.Get(Context, "Admin.Universities.Lead")</p>
        </div>
        <div class="page-heading__actions admin-tab-links">
            <a asp-action="Institutes" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Institutes")</a>
            <a asp-action="Programs" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Programs")</a>
            <a asp-action="Universities" class="btn btn-outline-primary" aria-current="page">@UiText.Get(Context, "Admin.Catalog.Universities")</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <section class="admin-section" aria-labelledby="university-list-title">
                <div class="admin-section-heading">
                    <div>
                        <h2 id="university-list-title">@UiText.Get(Context, "Admin.Universities.ListHeading")</h2>
                        <p>@UiText.Format(Context, "Admin.Universities.Count", Model.Universities.Count)</p>
                    </div>
                </div>
                @if (Model.Universities.Count == 0)
                {
                    <div class="empty-state">
                        <h3>@UiText.Get(Context, "Admin.Universities.EmptyHeading")</h3>
                        <p>@UiText.Get(Context, "Admin.Universities.EmptyLead")</p>
                    </div>
                }
                else
                {
                    <div class="table-shell">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle responsive-table">
                                <caption class="visually-hidden">@UiText.Get(Context, "Admin.Universities.Caption")</caption>
                                <thead>
                                    <tr><th scope="col">@UiText.Get(Context, "Admin.Universities.Name")</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var university in Model.Universities)
                                    {
                                        <tr><td data-label="@UiText.Get(Context, "Admin.Universities.University")">@university.UniversityName</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </section>
        </div>

        <div class="col-12 col-lg-5">
            <section class="admin-section" aria-labelledby="university-form-title">
                <div class="admin-section-heading">
                    <div>
                        <h2 id="university-form-title">@UiText.Get(Context, "Admin.Universities.NewHeading")</h2>
                        <p>@UiText.Get(Context, "Admin.Universities.NewLead")</p>
                    </div>
                </div>
                <form asp-action="CreateUniversity" method="post" novalidate data-disable-on-submit="true">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Form.UniversityName" class="form-label">@UiText.Get(Context, "Admin.Universities.Name")</label>
                        <input asp-for="Form.UniversityName" class="form-control" maxlength="100" autocomplete="off" />
                        <span asp-validation-for="Form.UniversityName" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Admin.Universities.Add")</button>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
