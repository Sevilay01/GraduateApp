@model EvaluationPublishPageViewModel
@{
    ViewData["Title"] = "Sonuçları yayımla";
    var rankedApplications = Model.Evaluation.Applications
        .Where(item => item.Rank.HasValue)
        .OrderBy(item => item.Rank)
        .ToArray();
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">İlanlar ve değerlendirme</span>
            <h1 class="page-heading__title">Sonuçları yayımla</h1>
            <p class="page-heading__description">@Model.ProgramName</p>
        </div>
        <div class="page-heading__actions">
            <span class="admin-state admin-state--info">Kesinleştirildi</span>
            <a asp-action="Evaluation" asp-route-id="@Model.ProgramOfferingId" class="btn btn-outline-secondary">Değerlendirmeye dön</a>
        </div>
    </header>

    <section class="admin-summary-grid" aria-label="Yayımlama özeti">
        <article class="admin-summary-card">
            <h2>Kontenjan</h2>
            <p class="display-6 mb-0">@Model.Summary.Quota</p>
        </article>
        <article class="admin-summary-card">
            <h2>Kabul</h2>
            <p class="display-6 mb-0">@Model.Summary.AdmittedCount</p>
        </article>
        <article class="admin-summary-card">
            <h2>Kontenjan dışında</h2>
            <p class="display-6 mb-0">@Model.Summary.NotAdmittedCount</p>
        </article>
        <article class="admin-summary-card">
            <h2>Uygun bulunmadı</h2>
            <p class="display-6 mb-0">@Model.Summary.IneligibleCount</p>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="final-ranking-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="final-ranking-heading">Kesinleştirilmiş sıralama</h2>
                <p>Bu sıralama yayımlama sırasında başvuru durumları ve öğrenci sonuç snapshot’ları için kullanılır.</p>
            </div>
        </div>
        @if (rankedApplications.Length == 0)
        {
            <div class="empty-state">
                <h3>Sıralama satırı bulunamadı</h3>
                <p>Yayımlamadan önce değerlendirme ekranına dönerek kesinleştirilmiş verileri doğrulayın.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table responsive-table">
                        <caption class="visually-hidden">Kesinleştirilmiş aday sıralaması</caption>
                        <thead>
                            <tr>
                                <th scope="col">Sıra</th>
                                <th scope="col">Maskelenmiş aday</th>
                                <th scope="col">Toplam puan</th>
                                <th scope="col">Sonuç</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in rankedApplications)
                            {
                                <tr>
                                    <td data-label="Sıra">@application.Rank</td>
                                    <td data-label="Maskelenmiş aday">@application.StudentFullName · @application.MaskedTc</td>
                                    <td data-label="Toplam puan">@(application.TotalScore?.ToString("0.0000") ?? "-")</td>
                                    <td data-label="Sonuç"><strong>@(application.Outcome?.DisplayName() ?? "Belirlenmedi")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="danger-zone" aria-labelledby="publish-confirmation-heading" data-publish-confirmation>
        <h2 id="publish-confirmation-heading" class="h4">Geri alınamaz yayımlama onayı</h2>
        <div class="alert alert-danger" role="alert">
            <strong>İşlem geri alınamaz.</strong>
            Kesinleştirilmiş sonuçlar öğrencilere açılır ve başvuru durumları atomik olarak Onaylandı/Reddedildi yapılır.
        </div>
        <ul>
            <li>Yayımlama öncesinde öğrenciler puan, sıra ve sonucu göremez.</li>
            <li>Publish işlemi başvuru statüsü, history, audit ve sonuç snapshot kayıtlarını tek atomik işlemde oluşturur.</li>
            <li>Sunucu tarafındaki lifecycle, antiforgery ve RowVersion kontrolleri yeniden uygulanır.</li>
        </ul>
        <form asp-action="PublishEvaluation" method="post" data-disable-on-submit="true">
            <input type="hidden" name="programOfferingId" value="@Model.ProgramOfferingId" />
            <input type="hidden" name="rowVersion" value="@Model.Summary.OfferingRowVersion" />
            <div class="admin-form-actions">
                <button class="btn btn-danger" type="submit">Sonuçları yayımla</button>
                <a asp-action="Evaluation" asp-route-id="@Model.ProgramOfferingId" class="btn btn-outline-secondary">Yayımlamadan vazgeç</a>
            </div>
        </form>
    </section>
</div>
