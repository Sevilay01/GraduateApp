@model EvaluationPublishPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.PublishEvaluation.PageTitle");
    var rankedApplications = Model.Evaluation.Applications
        .Where(item => item.Rank.HasValue)
        .OrderBy(item => item.Rank)
        .ToArray();
}

<div class="admin-page">
    <partial name="_OfferingHeader" model="Model.Shell" />
    <h2 class="visually-hidden">@UiText.Get(Context, "Admin.PublishEvaluation.PageTitle")</h2>

    <section class="admin-summary-grid" aria-label="@UiText.Get(Context, "Admin.PublishEvaluation.SummaryAria")">
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Evaluation.Quota")</h2>
            <p class="display-6 mb-0">@Model.Summary.Quota</p>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.PublishEvaluation.Admitted")</h2>
            <p class="display-6 mb-0">@Model.Summary.AdmittedCount</p>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.PublishEvaluation.NotAdmitted")</h2>
            <p class="display-6 mb-0">@Model.Summary.NotAdmittedCount</p>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.PublishEvaluation.Ineligible")</h2>
            <p class="display-6 mb-0">@Model.Summary.IneligibleCount</p>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="final-ranking-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="final-ranking-heading">@UiText.Get(Context, "Admin.PublishEvaluation.FinalRanking")</h2>
                <p>@UiText.Get(Context, "Admin.PublishEvaluation.FinalRankingDescription")</p>
            </div>
        </div>
        @if (rankedApplications.Length == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.PublishEvaluation.NoRows")</h3>
                <p>@UiText.Get(Context, "Admin.PublishEvaluation.NoRowsBody")</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table responsive-table">
                        <caption class="visually-hidden">@UiText.Get(Context, "Admin.PublishEvaluation.RankingCaption")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.Rank")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.MaskedCandidate")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.TotalScore")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.PublishEvaluation.Outcome")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in rankedApplications)
                            {
                                <tr>
                                    <td data-label="@UiText.Get(Context, "Admin.Evaluation.Rank")">@application.Rank</td>
                                    <td data-label="@UiText.Get(Context, "Admin.Evaluation.MaskedCandidate")">@application.StudentFullName · @application.MaskedTc</td>
                                    <td data-label="@UiText.Get(Context, "Admin.Evaluation.TotalScore")">@(application.TotalScore?.ToString("0.0000") ?? "-")</td>
                                    <td data-label="@UiText.Get(Context, "Admin.PublishEvaluation.Outcome")"><strong>@(application.Outcome.HasValue ? UiText.LocalizeEvaluationOutcome(Context, application.Outcome.Value) : UiText.Get(Context, "Admin.PublishEvaluation.Undetermined"))</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    @if (Model.Evaluation.EvaluationState == OfferingEvaluationState.Finalized)
    {
    <section class="danger-zone" aria-labelledby="publish-confirmation-heading" data-publish-confirmation>
        <h2 id="publish-confirmation-heading" class="h4">@UiText.Get(Context, "Admin.PublishEvaluation.ConfirmationHeading")</h2>
        <div class="alert alert-danger" role="alert">
            <strong>@UiText.Get(Context, "Admin.PublishEvaluation.Irreversible")</strong>
            @UiText.Get(Context, "Admin.PublishEvaluation.IrreversibleBody")
        </div>
        <ul>
            <li>@UiText.Get(Context, "Admin.PublishEvaluation.BeforePublication")</li>
            <li>@UiText.Get(Context, "Admin.PublishEvaluation.AtomicEffect")</li>
            <li>@UiText.Get(Context, "Admin.PublishEvaluation.ServerChecks")</li>
        </ul>
        <form asp-action="PublishEvaluation" method="post" data-disable-on-submit="true">
            <input type="hidden" name="programOfferingId" value="@Model.ProgramOfferingId" />
            <input type="hidden" name="rowVersion" value="@Model.Summary.OfferingRowVersion" />
            <div class="admin-form-actions">
                <button class="btn btn-danger" type="submit">@UiText.Get(Context, "Admin.PublishEvaluation.PublishAction")</button>
                <a asp-action="Evaluation" asp-route-id="@Model.ProgramOfferingId" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.PublishEvaluation.Cancel")</a>
            </div>
        </form>
    </section>
    }
    else
    {
        <div class="alert alert-success" role="status">@UiText.Get(Context, "Admin.Evaluation.AlreadyPublished")</div>
    }
</div>
