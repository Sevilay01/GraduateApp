@model EvaluationPageViewModel
@{
    ViewData["Title"] = "Başvuru değerlendirmesi";
    var evaluation = Model.Evaluation;
    var capabilities = evaluation.Capabilities;
    var eligibleExamRequirements = evaluation.EligibleExamRequirements;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Başvuru değerlendirmesi</h1>
        <p class="text-muted mb-0">@evaluation.ProgramName · @evaluation.AcademicYear · @evaluation.TermName</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge text-bg-secondary align-self-center">@evaluation.EvaluationState</span>
        <a asp-action="Offerings" class="btn btn-outline-secondary">İlanlara dön</a>
    </div>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

@if (evaluation.EvaluationState == OfferingEvaluationState.Finalized)
{
    <div class="alert alert-info" role="status">
        Sonuçlar kesinleştirildi; değerlendirme verileri değiştirilemez.
    </div>
}
else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
{
    <div class="alert alert-success" role="status">
        Sonuçlar yayımlandı; değerlendirme verileri değiştirilemez.
    </div>
}

<section class="card mb-4" aria-labelledby="policy-heading">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <h2 id="policy-heading" class="h4">Değerlendirme politikası</h2>
            <span>Toplam: <strong>@evaluation.Criteria.Sum(item => item.WeightBasisPoints) / 10000 bp</strong></span>
        </div>
        <p class="small text-muted">Kriterler ilk taslak başvuru oluştuğunda kilitlenir. Eşitlikte küçük öncelik numarası önce uygulanır.</p>
        @foreach (var criterion in evaluation.Criteria)
        {
            var usesExam = criterion.SourceType == EvaluationCriterionSourceType.ExamScore;
            @if (capabilities.CanEditPolicy)
            {
                <form asp-action="SaveEvaluationCriterion" method="post" class="border rounded p-3 mb-2" data-evaluation-criterion-form>
                    <input type="hidden" name="ProgramOfferingId" value="@evaluation.ProgramOfferingId" />
                    <input type="hidden" name="PublicId" value="@criterion.PublicId" />
                    <input type="hidden" name="RowVersion" value="@criterion.RowVersion" />
                    <div class="row g-2">
                        <div class="col-md-2"><label class="form-label">Kod</label><input name="Code" value="@criterion.Code" class="form-control" required /></div>
                        <div class="col-md-3"><label class="form-label">Ad</label><input name="DisplayName" value="@criterion.DisplayName" class="form-control" required /></div>
                        <div class="col-md-2">
                            <label class="form-label">Kaynak</label>
                            <select name="SourceType" class="form-select" data-source-type>
                                @foreach (var source in Enum.GetValues<EvaluationCriterionSourceType>())
                                {
                                    <option value="@source" selected="@(criterion.SourceType == source)">@(source.DisplayName())</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2" data-exam-field hidden="@(!usesExam)">
                            <label class="form-label">Sınav</label>
                            <select name="ExamId" class="form-select" data-exam-id required="@usesExam" disabled="@(!usesExam)">
                                <option value="">Sınav seçiniz</option>
                                @foreach (var requirement in eligibleExamRequirements)
                                {
                                    <option value="@requirement.ExamId" selected="@(criterion.ExamId == requirement.ExamId)">
                                        @requirement.ExamName · En az @requirement.MinimumScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1"><label class="form-label">bp</label><input name="WeightBasisPoints" value="@criterion.WeightBasisPoints" class="form-control" type="number" min="1" max="10000" /></div>
                        <div class="col-md-1"><label class="form-label">Maks.</label><input name="MaximumRawScore" value="@criterion.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" type="number" step="0.0001" /></div>
                        <div class="col-md-1"><label class="form-label">Öncelik</label><input name="TieBreakPriority" value="@criterion.TieBreakPriority" class="form-control" type="number" min="1" /></div>
                        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary">Kaydet</button></div>
                    </div>
                </form>
                <form asp-action="DeleteEvaluationCriterion" method="post" class="mb-3">
                    <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                    <input type="hidden" name="publicId" value="@criterion.PublicId" />
                    <input type="hidden" name="rowVersion" value="@criterion.RowVersion" />
                    <button class="btn btn-sm btn-outline-danger">Kriteri kaldır</button>
                </form>
            }
            else
            {
                <dl class="row border rounded p-3 mb-2" data-readonly-evaluation-criterion>
                    <dt class="col-sm-2">Kod</dt>
                    <dd class="col-sm-2"><output>@criterion.Code</output></dd>
                    <dt class="col-sm-2">Ad</dt>
                    <dd class="col-sm-6"><output>@criterion.DisplayName</output></dd>
                    <dt class="col-sm-2">Kaynak</dt>
                    <dd class="col-sm-2"><output>@criterion.SourceType.DisplayName()</output></dd>
                    <dt class="col-sm-2">Sınav</dt>
                    <dd class="col-sm-2"><output>@(criterion.ExamName ?? "-")</output></dd>
                    <dt class="col-sm-2">Ağırlık</dt>
                    <dd class="col-sm-2"><output>@criterion.WeightBasisPoints bp</output></dd>
                    <dt class="col-sm-2">Maksimum</dt>
                    <dd class="col-sm-2"><output>@criterion.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)</output></dd>
                    <dt class="col-sm-2">Öncelik</dt>
                    <dd class="col-sm-2 mb-0"><output>@criterion.TieBreakPriority</output></dd>
                </dl>
            }
        }

        @if (capabilities.CanEditPolicy)
        {
            var newCriterionUsesExam = Model.CriterionForm.SourceType == EvaluationCriterionSourceType.ExamScore;
            <form asp-action="SaveEvaluationCriterion" method="post" class="border rounded p-3 mt-3" data-evaluation-criterion-form>
                <h3 class="h6">Yeni kriter</h3>
                <input asp-for="CriterionForm.ProgramOfferingId" name="ProgramOfferingId" type="hidden" />
                <div class="row g-2">
                    <div class="col-md-2"><input asp-for="CriterionForm.Code" name="Code" class="form-control" placeholder="Kod" /></div>
                    <div class="col-md-3"><input asp-for="CriterionForm.DisplayName" name="DisplayName" class="form-control" placeholder="Görünen ad" /></div>
                    <div class="col-md-2">
                        <label class="form-label">Kaynak</label>
                        <select name="SourceType" class="form-select" data-source-type>
                            @foreach (var source in Enum.GetValues<EvaluationCriterionSourceType>())
                            {
                                <option value="@source" selected="@(Model.CriterionForm.SourceType == source)">@(source.DisplayName())</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2" data-exam-field hidden="@(!newCriterionUsesExam)">
                        <label class="form-label">Sınav</label>
                        <select name="ExamId" class="form-select" data-exam-id required="@newCriterionUsesExam" disabled="@(!newCriterionUsesExam)">
                            <option value="">Sınav seçiniz</option>
                            @foreach (var requirement in eligibleExamRequirements)
                            {
                                <option value="@requirement.ExamId" selected="@(Model.CriterionForm.ExamId == requirement.ExamId)">
                                    @requirement.ExamName · En az @requirement.MinimumScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1"><input asp-for="CriterionForm.WeightBasisPoints" name="WeightBasisPoints" class="form-control" placeholder="bp" /></div>
                    <div class="col-md-1"><input asp-for="CriterionForm.MaximumRawScore" name="MaximumRawScore" class="form-control" step="0.0001" /></div>
                    <div class="col-md-1"><input asp-for="CriterionForm.TieBreakPriority" name="TieBreakPriority" class="form-control" /></div>
                    <div class="col-md-1"><button class="btn btn-primary">Ekle</button></div>
                </div>
            </form>
        }
    </div>
</section>

<script>
    (() => {
        const examScoreSource = '@EvaluationCriterionSourceType.ExamScore';
        document.querySelectorAll('[data-evaluation-criterion-form]').forEach(form => {
            const sourceType = form.querySelector('[data-source-type]');
            const examField = form.querySelector('[data-exam-field]');
            const examId = form.querySelector('[data-exam-id]');
            if (!sourceType || !examField || !examId) {
                return;
            }

            const synchronizeExamField = () => {
                const usesExam = sourceType.value === examScoreSource;
                examField.hidden = !usesExam;
                examId.disabled = !usesExam;
                examId.required = usesExam;
                if (!usesExam) {
                    examId.value = '';
                }
            };

            sourceType.addEventListener('change', synchronizeExamField);
            synchronizeExamField();
        });
    })();
</script>

<section class="card mb-4" aria-labelledby="candidates-heading">
    <div class="card-body">
        <h2 id="candidates-heading" class="h4">Adaylar</h2>
        @foreach (var application in evaluation.Applications)
        {
            <article class="border rounded p-3 mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div><strong>@application.StudentFullName</strong> · @application.MaskedTc · @application.CurrentStatus.DisplayName()</div>
                    <a asp-action="Detail" asp-route-id="@application.ApplicationPublicId">Başvuruyu aç</a>
                </div>
                <div class="small text-muted">@application.DocumentReviewSummary · Uygunluk: @application.EligibilityStatus · Toplam: @(application.TotalScore?.ToString("0.0000") ?? "-")</div>
                @if (application.CurrentStatus == ApplicationStatus.UnderReview
                    && (capabilities.CanDecideEligibility || capabilities.CanEditManualScore))
                {
                    <div class="row g-3 mt-1">
                        @if (capabilities.CanDecideEligibility)
                        {
                            <div class="col-md-6">
                                <form asp-action="DecideEligibility" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                                    <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                                    <input type="hidden" name="rowVersion" value="@application.EvaluationRowVersion" />
                                    <select name="eligibilityStatus" class="form-select"><option value="Eligible">Uygun</option><option value="Ineligible">Uygun değil</option></select>
                                    <input name="ineligibilityReason" class="form-control" maxlength="500" placeholder="Uygun değilse gerekçe" />
                                    <button class="btn btn-outline-primary">Kaydet</button>
                                </form>
                            </div>
                        }
                        @if (capabilities.CanEditManualScore)
                        {
                            @foreach (var component in application.Components.Where(item => item.SourceType == EvaluationCriterionSourceType.ManualScore))
                            {
                                <div class="col-md-6">
                                    <form asp-action="SetManualScore" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                                        <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                                        <input type="hidden" name="criterionPublicId" value="@component.CriterionPublicId" />
                                        <input type="hidden" name="rowVersion" value="@component.RowVersion" />
                                        <label class="form-label text-nowrap align-self-center">@component.DisplayName</label>
                                        <input name="rawScore" value="@component.RawScore?.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="100" step="0.0001" class="form-control" required />
                                        <button class="btn btn-outline-primary">Puanla</button>
                                    </form>
                                </div>
                            }
                        }
                    </div>
                }
                @if (!capabilities.CanDecideEligibility)
                {
                    <div class="mt-2" data-readonly-eligibility>
                        <span class="fw-semibold">Uygunluk kararı:</span>
                        <output>@application.EligibilityStatus</output>
                        @if (!string.IsNullOrWhiteSpace(application.IneligibilityReason))
                        {
                            <span> · @application.IneligibilityReason</span>
                        }
                    </div>
                }
                @if (!capabilities.CanEditManualScore)
                {
                    <div class="table-responsive mt-2" data-readonly-evaluation-components>
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>Bileşen</th><th>Kaynak</th><th>Ham puan</th><th>Normalize</th><th>Ağırlıklı puan</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var component in application.Components)
                            {
                                <tr>
                                    <td>@component.DisplayName</td>
                                    <td>@component.SourceType.DisplayName()</td>
                                    <td><output>@(component.RawScore?.ToString("G29", System.Globalization.CultureInfo.CurrentCulture) ?? "-")</output></td>
                                    <td><output>@(component.NormalizedScore?.ToString("0.0000") ?? "-")</output></td>
                                    <td><output>@(component.WeightedScore?.ToString("0.0000") ?? "-")</output></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        }
    </div>
</section>

<section class="card" aria-labelledby="ranking-heading">
    <div class="card-body">
        <h2 id="ranking-heading" class="h4">Deterministik sıralama önizlemesi</h2>
        @if (Model.Preview.BlockingReasons.Count > 0)
        {
            <div class="alert alert-warning"><ul class="mb-0">@foreach (var reason in Model.Preview.BlockingReasons) { <li>@reason</li> }</ul></div>
        }
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Sıra</th><th>Aday</th><th>Puan</th><th>Öngörülen sonuç</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Preview.Rows)
                {
                    <tr><td>@row.Rank</td><td>@row.StudentFullName · @row.MaskedTc</td><td>@row.TotalScore.ToString("0.0000")</td><td>@row.ProjectedOutcome.DisplayName()</td></tr>
                }
                </tbody>
            </table>
        </div>
        @if (capabilities.CanFinalize)
        {
            <form asp-action="FinalizeEvaluation" method="post">
                <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                <input type="hidden" name="rowVersion" value="@evaluation.OfferingRowVersion" />
                <button class="btn btn-danger" disabled="@(!Model.Preview.CanFinalize)">Sonuçları kesinleştir</button>
                <span class="small text-muted ms-2">Bu işlem sıralama ve kararları dondurur; öğrenciye henüz göstermez.</span>
            </form>
        }
        else if (capabilities.CanPublish)
        {
            <a asp-action="PublishEvaluation" asp-route-id="@evaluation.ProgramOfferingId" class="btn btn-danger">Yayımlama onayına geç</a>
        }
        else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
        {
            <div class="alert alert-success mb-0">Sonuçlar yayımlandı.</div>
        }
    </div>
</section>
