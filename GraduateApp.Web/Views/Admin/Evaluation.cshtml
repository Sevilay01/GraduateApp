@model EvaluationPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Evaluation.PageTitle");
    var evaluation = Model.Evaluation;
    var capabilities = evaluation.Capabilities;
    var totalWeight = evaluation.Criteria.Sum(item => item.WeightBasisPoints);
    var firstQuotaOutsideRank = Model.Preview.Rows
        .Where(item => item.ProjectedOutcome == EvaluationOutcome.NotAdmitted)
        .Select(item => (int?)item.Rank)
        .Min();
}

<div class="admin-page">
    <partial name="_OfferingHeader" model="Model.Shell" />
    <h2 class="visually-hidden">@UiText.Get(Context, "Admin.Evaluation.PageTitle")</h2>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }
    @if (evaluation.EvaluationState == OfferingEvaluationState.Finalized)
    {
        <div class="alert alert-info" role="status"><strong>@UiText.Get(Context, "Admin.Evaluation.FinalizedTitle")</strong> @UiText.Get(Context, "Admin.Evaluation.FinalizedBody")</div>
    }
    else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
    {
        <div class="alert alert-success" role="status"><strong>@UiText.Get(Context, "Admin.Evaluation.PublishedTitle")</strong> @UiText.Get(Context, "Admin.Evaluation.PublishedBody")</div>
    }

    <section class="admin-summary-grid" aria-label="@UiText.Get(Context, "Admin.Evaluation.LifecycleAria")">
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Evaluation.Lifecycle")</h2>
            <dl>
                <dt>@UiText.Get(Context, "Admin.Evaluation.Status")</dt><dd>@UiText.LocalizeEvaluationState(Context, evaluation.EvaluationState)</dd>
                <dt>@UiText.Get(Context, "Admin.Evaluation.Quota")</dt><dd>@evaluation.Quota</dd>
                <dt>@UiText.Get(Context, "Admin.Evaluation.Deadline")</dt><dd>@(evaluation.ApplicationDeadlineUtc.HasValue ? IstanbulTime.FromUtc(evaluation.ApplicationDeadlineUtc.Value).ToString("g") : UiText.Get(Context, "Admin.Evaluation.Unspecified"))</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Evaluation.Permissions")</h2>
            <dl>
                <dt>@UiText.Get(Context, "Admin.Evaluation.Eligibility")</dt><dd>@UiText.Get(Context, capabilities.CanDecideEligibility ? "Admin.Evaluation.DecisionAllowed" : "Admin.Evaluation.ReadOnly")</dd>
                <dt>@UiText.Get(Context, "Admin.Evaluation.ManualScore")</dt><dd>@UiText.Get(Context, capabilities.CanEditManualScore ? "Admin.Evaluation.ScoreAllowed" : "Admin.Evaluation.ReadOnly")</dd>
                <dt>@UiText.Get(Context, "Admin.Evaluation.Finalization")</dt><dd>@UiText.Get(Context, capabilities.CanFinalize ? "Admin.Evaluation.PrerequisiteDependent" : "Admin.Evaluation.Closed")</dd>
            </dl>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="candidates-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="candidates-heading">@UiText.Get(Context, "Admin.Evaluation.Candidates")</h2>
                <p>@UiText.Get(Context, "Admin.Evaluation.CandidatesDescription")</p>
            </div>
        </div>
        @if (evaluation.Applications.Count == 0)
        {
            <div class="empty-state"><h3>@UiText.Get(Context, "Admin.Evaluation.NoCandidates")</h3><p>@UiText.Get(Context, "Admin.Evaluation.NoCandidatesBody")</p></div>
        }
        @foreach (var application in evaluation.Applications)
        {
            <article class="candidate-card">
                <header class="candidate-card__header">
                    <div><h3 class="h5 mb-1">@application.StudentFullName</h3><span>@application.MaskedTc</span></div>
                    <div class="admin-form-actions">
                        <partial name="_ApplicationStatusBadge" model="application.CurrentStatus" />
                        <a asp-action="Detail" asp-route-id="@application.ApplicationPublicId" class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Evaluation.OpenApplication")</a>
                    </div>
                </header>
                <div class="candidate-card__summary">
                    <span class="admin-state">@UiText.LocalizeDocumentReviewSummary(Context, application.DocumentReviewSummary)</span>
                    <span class="admin-state @(application.EligibilityStatus == EvaluationEligibilityStatus.Eligible ? "admin-state--success" : application.EligibilityStatus == EvaluationEligibilityStatus.Ineligible ? "admin-state--danger" : "admin-state--warning")">@UiText.Format(Context, "Admin.Evaluation.EligibilityFormat", UiText.LocalizeEligibility(Context, application.EligibilityStatus))</span>
                    <span class="admin-state">@UiText.Format(Context, "Admin.Evaluation.TotalFormat", application.TotalScore?.ToString("0.0000") ?? "-")</span>
                </div>
                <div class="table-shell mt-3" data-readonly-evaluation-components="@(!capabilities.CanEditManualScore ? "true" : null)">
                    <div class="table-responsive">
                        <table class="table table-sm responsive-table">
                            <caption class="visually-hidden">@UiText.Format(Context, "Admin.Evaluation.ComponentsCaption", application.StudentFullName)</caption>
                            <thead><tr>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.Component")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.Source")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.RawScore")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Evaluation.Contribution")</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var component in application.Components)
                                {
                                    <tr>
                                        <td data-label="@UiText.Get(Context, "Admin.Evaluation.Component")">@component.DisplayName</td>
                                        <td data-label="@UiText.Get(Context, "Admin.Evaluation.Source")">@UiText.LocalizeCriterionSource(Context, component.SourceType)</td>
                                        <td data-label="@UiText.Get(Context, "Admin.Evaluation.RawScore")"><output>@(component.RawScore?.ToString("G29", System.Globalization.CultureInfo.CurrentCulture) ?? "-")</output></td>
                                        <td data-label="@UiText.Get(Context, "Admin.Evaluation.Contribution")"><output>@(component.WeightedScore?.ToString("0.0000") ?? "-")</output></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                @if (application.CurrentStatus == ApplicationStatus.UnderReview && capabilities.CanDecideEligibility)
                {
                    <form asp-action="DecideEligibility" method="post" class="admin-summary-card mt-3" data-disable-on-submit="true">
                        <h4 class="h6">@UiText.Get(Context, "Admin.Evaluation.EligibilityDecision")</h4>
                        <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                        <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                        <input type="hidden" name="rowVersion" value="@application.EvaluationRowVersion" />
                        <div class="row g-3">
                            <div class="col-12 col-md-4"><label for="eligibility-@application.ApplicationPublicId" class="form-label">@UiText.Get(Context, "Admin.Evaluation.Decision")</label><select id="eligibility-@application.ApplicationPublicId" name="eligibilityStatus" class="form-select"><option value="Eligible">@UiText.LocalizeEligibility(Context, EvaluationEligibilityStatus.Eligible)</option><option value="Ineligible">@UiText.LocalizeEligibility(Context, EvaluationEligibilityStatus.Ineligible)</option></select></div>
                            <div class="col-12 col-md-8"><label for="reason-@application.ApplicationPublicId" class="form-label">@UiText.Get(Context, "Admin.Evaluation.IneligibleReason")</label><input id="reason-@application.ApplicationPublicId" name="ineligibilityReason" class="form-control" maxlength="500" /></div>
                            <div class="col-12"><button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Evaluation.SaveEligibility")</button></div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="admin-readonly-note" data-readonly-eligibility><strong>@UiText.Get(Context, "Admin.Evaluation.EligibilityDecision"):</strong> <output>@UiText.LocalizeEligibility(Context, application.EligibilityStatus)</output></div>
                }
                @if (application.CurrentStatus == ApplicationStatus.UnderReview && capabilities.CanEditManualScore)
                {
                    @foreach (var component in application.Components.Where(item => item.SourceType == EvaluationCriterionSourceType.ManualScore))
                    {
                        <form asp-action="SetManualScore" method="post" class="admin-summary-card mt-3" data-disable-on-submit="true">
                            <h4 class="h6">@UiText.Format(Context, "Admin.Evaluation.ManualScoreHeading", component.DisplayName)</h4>
                            <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                            <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                            <input type="hidden" name="criterionPublicId" value="@component.CriterionPublicId" />
                            <input type="hidden" name="rowVersion" value="@component.RowVersion" />
                            <div class="row g-3 align-items-end"><div class="col-12 col-sm-6"><label for="score-@application.ApplicationPublicId-@component.CriterionPublicId" class="form-label">@UiText.Get(Context, "Admin.Evaluation.RawScore")</label><input id="score-@application.ApplicationPublicId-@component.CriterionPublicId" name="rawScore" value="@component.RawScore?.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@component.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" class="form-control" required /></div><div class="col-12 col-sm-6"><button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Evaluation.SaveManualScore")</button></div></div>
                        </form>
                    }
                }
            </article>
        }
    </section>

    <section class="admin-section" aria-labelledby="ranking-heading">
        <div class="admin-section-heading"><div><h2 id="ranking-heading">@UiText.Get(Context, "Admin.Evaluation.RankingHeading")</h2><p>@UiText.Get(Context, "Admin.Evaluation.RankingDescription")</p></div></div>
        @if (Model.Preview.BlockingReasons.Count > 0)
        {
            <div class="alert alert-warning" role="alert"><strong>@UiText.Get(Context, "Admin.Evaluation.FinalizeBlocked")</strong><ul class="mb-0">@foreach (var reason in Model.Preview.BlockingReasons) { <li>@UiText.LocalizeEvaluationBlockingReason(Context, reason)</li> }</ul></div>
        }
        <div class="table-shell"><div class="table-responsive"><table class="table table-sm responsive-table">
            <caption class="visually-hidden">@UiText.Get(Context, "Admin.Evaluation.RankingCaption")</caption>
            <thead><tr><th scope="col">@UiText.Get(Context, "Admin.Evaluation.Rank")</th><th scope="col">@UiText.Get(Context, "Admin.Evaluation.MaskedCandidate")</th><th scope="col">@UiText.Get(Context, "Admin.Evaluation.TotalScore")</th><th scope="col">@UiText.Get(Context, "Admin.Evaluation.ProjectedOutcome")</th></tr></thead>
            <tbody>@foreach (var row in Model.Preview.Rows) { <tr class="@(row.Rank == firstQuotaOutsideRank ? "quota-boundary" : null)"><td data-label="@UiText.Get(Context, "Admin.Evaluation.Rank")">@row.Rank @if (row.Rank == firstQuotaOutsideRank) { <span class="quota-boundary__label">@UiText.Get(Context, "Admin.Evaluation.QuotaBoundary")</span> }</td><td data-label="@UiText.Get(Context, "Admin.Evaluation.MaskedCandidate")">@row.StudentFullName · @row.MaskedTc</td><td data-label="@UiText.Get(Context, "Admin.Evaluation.TotalScore")">@row.TotalScore.ToString("0.0000")</td><td data-label="@UiText.Get(Context, "Admin.Evaluation.ProjectedOutcome")"><strong>@UiText.LocalizeEvaluationOutcome(Context, row.ProjectedOutcome)</strong></td></tr> }</tbody>
        </table></div></div>
        @if (capabilities.CanFinalize && Model.Preview.CanFinalize)
        {
            <div class="danger-zone"><h3 class="h5">@UiText.Get(Context, "Admin.Evaluation.FinalizeHeading")</h3><ul><li>@UiText.Format(Context, "Admin.Evaluation.PolicyTotalFormat", totalWeight.ToString("N0"))</li><li>@UiText.Format(Context, "Admin.Evaluation.QuotaFormat", evaluation.Quota)</li><li>@UiText.Get(Context, "Admin.Evaluation.FinalizeEffect")</li></ul><form asp-action="FinalizeEvaluation" method="post" data-disable-on-submit="true"><input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" /><input type="hidden" name="rowVersion" value="@evaluation.OfferingRowVersion" /><button class="btn btn-danger" type="submit">@UiText.Get(Context, "Admin.Evaluation.FinalizeAction")</button></form></div>
        }
        else if (capabilities.CanPublish)
        {
            <div class="danger-zone"><h3 class="h5">@UiText.Get(Context, "Admin.Evaluation.PublishHeading")</h3><p>@UiText.Get(Context, "Admin.Evaluation.PublishDescription")</p><a asp-action="Results" asp-route-id="@evaluation.ProgramOfferingId" class="btn btn-danger">@UiText.Get(Context, "Admin.Evaluation.PublishConfirmation")</a></div>
        }
        else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
        {
            <div class="alert alert-success mb-0">@UiText.Get(Context, "Admin.Evaluation.AlreadyPublished")</div>
        }
    </section>
</div>
