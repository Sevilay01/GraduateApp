@model EvaluationPageViewModel
@{
    ViewData["Title"] = "Başvuru değerlendirmesi";
    var evaluation = Model.Evaluation;
    var capabilities = evaluation.Capabilities;
    var eligibleExamRequirements = evaluation.EligibleExamRequirements;
    var totalWeight = evaluation.Criteria.Sum(item => item.WeightBasisPoints);
    var firstQuotaOutsideRank = Model.Preview.Rows
        .Where(item => item.ProjectedOutcome == EvaluationOutcome.NotAdmitted)
        .Select(item => (int?)item.Rank)
        .Min();
    var lifecycleClass = evaluation.EvaluationState switch
    {
        OfferingEvaluationState.Configuring => "admin-state--warning",
        OfferingEvaluationState.Finalized => "admin-state--info",
        OfferingEvaluationState.Published => "admin-state--success",
        _ => string.Empty
    };
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">İlanlar ve değerlendirme</span>
            <h1 class="page-heading__title">Başvuru değerlendirmesi</h1>
            <p class="page-heading__description">@evaluation.ProgramName · @evaluation.AcademicYear · @evaluation.TermName</p>
        </div>
        <div class="page-heading__actions">
            <span class="admin-state @lifecycleClass">@evaluation.EvaluationState.DisplayName()</span>
            <a asp-action="Offerings" class="btn btn-outline-secondary">İlanlara dön</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    @if (evaluation.EvaluationState == OfferingEvaluationState.Finalized)
    {
        <div class="alert alert-info" role="status">
            <strong>Sonuçlar kesinleştirildi; değerlendirme verileri değiştirilemez.</strong>
            Öğrenciler sonuçları yayımlama işlemi tamamlanana kadar göremez.
        </div>
    }
    else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
    {
        <div class="alert alert-success" role="status">
            <strong>Sonuçlar yayımlandı; değerlendirme verileri değiştirilemez.</strong>
            Başvuru durumları ve sonuç snapshot’ları yayımlanmış haldedir.
        </div>
    }

    <section class="admin-summary-grid" aria-label="Değerlendirme yaşam döngüsü ve yetkileri">
        <article class="admin-summary-card">
            <h2>Yaşam döngüsü</h2>
            <dl>
                <dt>Durum</dt><dd>@evaluation.EvaluationState.DisplayName()</dd>
                <dt>Kontenjan</dt><dd>@evaluation.Quota</dd>
                <dt>Son başvuru</dt>
                <dd>@(evaluation.ApplicationDeadlineUtc.HasValue ? IstanbulTime.FromUtc(evaluation.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm") : "Belirtilmemiş")</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>Mevcut işlem yetkileri</h2>
            <dl>
                <dt>Politika</dt><dd>@(capabilities.CanEditPolicy ? "Düzenlenebilir" : "Salt okunur")</dd>
                <dt>Uygunluk</dt><dd>@(capabilities.CanDecideEligibility ? "Karar verilebilir" : "Salt okunur")</dd>
                <dt>Manuel puan</dt><dd>@(capabilities.CanEditManualScore ? "Girilebilir" : "Salt okunur")</dd>
                <dt>Kesinleştirme</dt><dd>@(capabilities.CanFinalize ? "Önkoşullara bağlı" : "Kapalı")</dd>
                <dt>Yayımlama</dt><dd>@(capabilities.CanPublish ? "Açık" : "Kapalı")</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>Yaşam döngüsü yetki matrisi</h2>
            <p class="small mb-1"><strong>Yapılandırılıyor:</strong> politika, uygunluk ve manuel puan; önkoşullarla kesinleştirme.</p>
            <p class="small mb-1"><strong>Kesinleştirildi:</strong> yalnızca yayımlama.</p>
            <p class="small mb-0"><strong>Yayımlandı:</strong> tüm mutation yüzeyleri kapalı.</p>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="policy-heading">
        <div class="admin-section-heading">
            <div>
                <span class="eyebrow">1. Politika ve kriterler</span>
                <h2 id="policy-heading">Değerlendirme politikası</h2>
                <p>Kriterler ilk taslak başvuru oluştuğunda kilitlenir. Eşitlikte küçük tie-break önceliği önce uygulanır.</p>
            </div>
            <div class="weight-summary @(totalWeight == 10000 ? null : "is-incomplete")">
                <span><strong>@totalWeight.ToString("N0") / 10.000 bp</strong></span>
                <progress value="@Math.Min(totalWeight, 10000)" max="10000">@totalWeight / 10.000 bp</progress>
                <small>@(totalWeight == 10000 ? "Toplam ağırlık geçerli." : "Toplam ağırlık 10.000 bp olmalı.")</small>
            </div>
        </div>

        @if (evaluation.Criteria.Count == 0)
        {
            <div class="empty-state mb-3">
                <h3>Henüz kriter tanımlanmadı</h3>
                <p>İlan kesinleştirilmeden önce toplamı 10.000 bp olan geçerli bir politika oluşturun.</p>
            </div>
        }

        <div class="admin-card-list">
            @foreach (var criterion in evaluation.Criteria)
            {
                var usesExam = criterion.SourceType == EvaluationCriterionSourceType.ExamScore;
                @if (capabilities.CanEditPolicy)
                {
                    <article class="admin-item-card">
                        <form asp-action="SaveEvaluationCriterion" method="post" data-evaluation-criterion-form data-disable-on-submit="true">
                            <input type="hidden" name="ProgramOfferingId" value="@evaluation.ProgramOfferingId" />
                            <input type="hidden" name="PublicId" value="@criterion.PublicId" />
                            <input type="hidden" name="RowVersion" value="@criterion.RowVersion" />
                            <div class="row g-3">
                                <div class="col-12 col-md-3">
                                    <label for="code-@criterion.PublicId" class="form-label">Kod</label>
                                    <input id="code-@criterion.PublicId" name="Code" value="@criterion.Code" class="form-control" required />
                                </div>
                                <div class="col-12 col-md-5">
                                    <label for="name-@criterion.PublicId" class="form-label">Görünen ad</label>
                                    <input id="name-@criterion.PublicId" name="DisplayName" value="@criterion.DisplayName" class="form-control" required />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label for="source-@criterion.PublicId" class="form-label">Kaynak türü</label>
                                    <select id="source-@criterion.PublicId" name="SourceType" class="form-select" data-source-type>
                                        @foreach (var source in Enum.GetValues<EvaluationCriterionSourceType>())
                                        {
                                            <option value="@source" selected="@(criterion.SourceType == source)">@(source.DisplayName())</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4" data-exam-field hidden="@(!usesExam)">
                                    <label for="exam-@criterion.PublicId" class="form-label">Bağlı zorunlu sınav</label>
                                    <select name="ExamId" id="exam-@criterion.PublicId" class="form-select" data-exam-id required="@usesExam" disabled="@(!usesExam)">
                                        <option value="">Sınav seçiniz</option>
                                        @foreach (var requirement in eligibleExamRequirements)
                                        {
                                            <option value="@requirement.ExamId" selected="@(criterion.ExamId == requirement.ExamId)">
                                                @requirement.ExamName · En az @requirement.MinimumScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-4 col-md-2">
                                    <label for="weight-@criterion.PublicId" class="form-label">Ağırlık (bp)</label>
                                    <input id="weight-@criterion.PublicId" name="WeightBasisPoints" value="@criterion.WeightBasisPoints" class="form-control" type="number" min="1" max="10000" />
                                </div>
                                <div class="col-12 col-sm-4 col-md-3">
                                    <label for="maximum-@criterion.PublicId" class="form-label">Maksimum ham puan</label>
                                    <input id="maximum-@criterion.PublicId"
                                           name="MaximumRawScore"
                                           value="@criterion.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)"
                                           class="form-control"
                                           type="text"
                                           inputmode="decimal"
                                           data-val="true"
                                           data-val-localizeddecimal="Maksimum ham puan 0,0001 ile 99999 arasında geçerli bir ondalık sayı olmalıdır."
                                           data-val-localizeddecimal-min="0.0001"
                                           data-val-localizeddecimal-max="99999" />
                                </div>
                                <div class="col-12 col-sm-4 col-md-3">
                                    <label for="priority-@criterion.PublicId" class="form-label">Tie-break önceliği</label>
                                    <input id="priority-@criterion.PublicId" name="TieBreakPriority" value="@criterion.TieBreakPriority" class="form-control" type="number" min="1" />
                                </div>
                                <div class="col-12 admin-form-actions">
                                    <button class="btn btn-primary" type="submit">Kriteri kaydet</button>
                                </div>
                            </div>
                        </form>
                        <div class="danger-zone">
                            <h3 class="h6">Kriter silme alanı</h3>
                            <form asp-action="DeleteEvaluationCriterion" method="post" data-disable-on-submit="true">
                                <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                                <input type="hidden" name="publicId" value="@criterion.PublicId" />
                                <input type="hidden" name="rowVersion" value="@criterion.RowVersion" />
                                <button class="btn btn-sm btn-danger" type="submit">Kriteri sil</button>
                            </form>
                        </div>
                    </article>
                }
                else
                {
                    <dl class="admin-summary-card" data-readonly-evaluation-criterion>
                        <dt>Kod</dt><dd><output>@criterion.Code</output></dd>
                        <dt>Ad</dt><dd><output>@criterion.DisplayName</output></dd>
                        <dt>Kaynak</dt><dd><output>@criterion.SourceType.DisplayName()</output></dd>
                        <dt>Sınav</dt><dd><output>@(criterion.ExamName ?? "-")</output></dd>
                        <dt>Ağırlık</dt><dd><output>@criterion.WeightBasisPoints bp</output></dd>
                        <dt>Maksimum</dt><dd><output>@criterion.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)</output></dd>
                        <dt>Öncelik</dt><dd><output>@criterion.TieBreakPriority</output></dd>
                    </dl>
                }
            }
        </div>

        @if (capabilities.CanEditPolicy)
        {
            var newCriterionUsesExam = Model.CriterionForm.SourceType == EvaluationCriterionSourceType.ExamScore;
            <form asp-action="SaveEvaluationCriterion" method="post" class="admin-summary-card mt-3" data-evaluation-criterion-form data-disable-on-submit="true">
                <h3 class="h6">Yeni kriter</h3>
                <input asp-for="CriterionForm.ProgramOfferingId" name="ProgramOfferingId" type="hidden" />
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label asp-for="CriterionForm.Code" class="form-label">Kod</label>
                        <input asp-for="CriterionForm.Code" name="Code" class="form-control" />
                        <span asp-validation-for="CriterionForm.Code" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-5">
                        <label asp-for="CriterionForm.DisplayName" class="form-label">Görünen ad</label>
                        <input asp-for="CriterionForm.DisplayName" name="DisplayName" class="form-control" />
                        <span asp-validation-for="CriterionForm.DisplayName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="new-source" class="form-label">Kaynak türü</label>
                        <select id="new-source" name="SourceType" class="form-select" data-source-type>
                            @foreach (var source in Enum.GetValues<EvaluationCriterionSourceType>())
                            {
                                <option value="@source" selected="@(Model.CriterionForm.SourceType == source)">@(source.DisplayName())</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4" data-exam-field hidden="@(!newCriterionUsesExam)">
                        <label for="new-exam" class="form-label">Bağlı zorunlu sınav</label>
                        <select name="ExamId" id="new-exam" class="form-select" data-exam-id required="@newCriterionUsesExam" disabled="@(!newCriterionUsesExam)">
                            <option value="">Sınav seçiniz</option>
                            @foreach (var requirement in eligibleExamRequirements)
                            {
                                <option value="@requirement.ExamId" selected="@(Model.CriterionForm.ExamId == requirement.ExamId)">
                                    @requirement.ExamName · En az @requirement.MinimumScore.ToString("G29", System.Globalization.CultureInfo.CurrentCulture)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-sm-4 col-md-2">
                        <label asp-for="CriterionForm.WeightBasisPoints" class="form-label">Ağırlık (bp)</label>
                        <input asp-for="CriterionForm.WeightBasisPoints" name="WeightBasisPoints" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-4 col-md-3">
                        <label asp-for="CriterionForm.MaximumRawScore" class="form-label">Maksimum ham puan</label>
                        <input asp-for="CriterionForm.MaximumRawScore"
                               name="MaximumRawScore"
                               class="form-control"
                               type="text"
                               inputmode="decimal" />
                    </div>
                    <div class="col-12 col-sm-4 col-md-3">
                        <label asp-for="CriterionForm.TieBreakPriority" class="form-label">Tie-break önceliği</label>
                        <input asp-for="CriterionForm.TieBreakPriority" name="TieBreakPriority" class="form-control" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary" type="submit">Yeni kriteri ekle</button>
                    </div>
                </div>
            </form>
        }
    </section>

    <section class="admin-section" aria-labelledby="candidates-heading">
        <div class="admin-section-heading">
            <div>
                <span class="eyebrow">2. Aday değerlendirmeleri</span>
                <h2 id="candidates-heading">Adaylar</h2>
                <p>Maskelenmiş kimlik, belge uygunluğu, otomatik bileşenler ve izin verilen manuel işlemler birlikte gösterilir.</p>
            </div>
        </div>

        @if (evaluation.Applications.Count == 0)
        {
            <div class="empty-state">
                <h3>Değerlendirilecek aday yok</h3>
                <p>Bu ilanda henüz değerlendirme kapsamına alınmış bir başvuru bulunmuyor.</p>
            </div>
        }
        @foreach (var application in evaluation.Applications)
        {
            <article class="candidate-card">
                <header class="candidate-card__header">
                    <div>
                        <h3 class="h5 mb-1">@application.StudentFullName</h3>
                        <span>@application.MaskedTc</span>
                    </div>
                    <div class="admin-form-actions">
                        <partial name="_ApplicationStatusBadge" model="application.CurrentStatus" />
                        <a asp-action="Detail" asp-route-id="@application.ApplicationPublicId" class="btn btn-sm btn-outline-primary">Başvuruyu aç</a>
                    </div>
                </header>

                <div class="candidate-card__summary">
                    <span class="admin-state">@application.DocumentReviewSummary</span>
                    <span class="admin-state @(application.EligibilityStatus == EvaluationEligibilityStatus.Eligible ? "admin-state--success" : application.EligibilityStatus == EvaluationEligibilityStatus.Ineligible ? "admin-state--danger" : "admin-state--warning")">
                        Uygunluk: @application.EligibilityStatus.DisplayName()
                    </span>
                    <span class="admin-state">Toplam: @(application.TotalScore?.ToString("0.0000") ?? "-")</span>
                </div>

                @if (application.EligibilityStatus == EvaluationEligibilityStatus.Pending
                    || application.Components.Any(item => item.RawScore is null))
                {
                    <div class="admin-readonly-note">
                        <strong>Eksik önkoşullar:</strong>
                        @(application.EligibilityStatus == EvaluationEligibilityStatus.Pending ? "Uygunluk kararı bekliyor. " : null)
                        @(application.Components.Any(item => item.RawScore is null) ? "Bir veya daha fazla puan bileşeni eksik." : null)
                    </div>
                }

                <div class="table-shell mt-3"
                     data-readonly-evaluation-components="@(!capabilities.CanEditManualScore ? "true" : null)">
                    <div class="table-responsive">
                        <table class="table table-sm responsive-table">
                            <caption class="visually-hidden">@application.StudentFullName adayının puan bileşenleri</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Bileşen</th>
                                    <th scope="col">Kaynak</th>
                                    <th scope="col">Ham puan</th>
                                    <th scope="col">Normalize</th>
                                    <th scope="col">Ağırlık</th>
                                    <th scope="col">Katkı</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var component in application.Components)
                                {
                                    <tr>
                                        <td data-label="Bileşen">@component.DisplayName</td>
                                        <td data-label="Kaynak">@component.SourceType.DisplayName()</td>
                                        <td data-label="Ham puan"><output>@(component.RawScore?.ToString("G29", System.Globalization.CultureInfo.CurrentCulture) ?? "-")</output></td>
                                        <td data-label="Normalize"><output>@(component.NormalizedScore?.ToString("0.0000") ?? "-")</output></td>
                                        <td data-label="Ağırlık">@component.WeightBasisPoints bp</td>
                                        <td data-label="Katkı"><output>@(component.WeightedScore?.ToString("0.0000") ?? "-")</output></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (application.CurrentStatus == ApplicationStatus.UnderReview && capabilities.CanDecideEligibility)
                {
                    <form asp-action="DecideEligibility" method="post" class="admin-summary-card mt-3" data-disable-on-submit="true">
                        <h4 class="h6">Uygunluk kararı</h4>
                        <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                        <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                        <input type="hidden" name="rowVersion" value="@application.EvaluationRowVersion" />
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label for="eligibility-@application.ApplicationPublicId" class="form-label">Karar</label>
                                <select id="eligibility-@application.ApplicationPublicId" name="eligibilityStatus" class="form-select">
                                    <option value="Eligible">Uygun</option>
                                    <option value="Ineligible">Uygun değil</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-8">
                                <label for="reason-@application.ApplicationPublicId" class="form-label">Uygun değilse gerekçe</label>
                                <input id="reason-@application.ApplicationPublicId" name="ineligibilityReason" class="form-control" maxlength="500" />
                            </div>
                            <div class="col-12"><button class="btn btn-primary" type="submit">Uygunluk kararını kaydet</button></div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="admin-readonly-note" data-readonly-eligibility>
                        <strong>Uygunluk kararı:</strong>
                        <output>@application.EligibilityStatus.DisplayName()</output>
                        @if (!string.IsNullOrWhiteSpace(application.IneligibilityReason))
                        {
                            <span> · @application.IneligibilityReason</span>
                        }
                    </div>
                }

                @if (application.CurrentStatus == ApplicationStatus.UnderReview && capabilities.CanEditManualScore)
                {
                    @foreach (var component in application.Components.Where(item => item.SourceType == EvaluationCriterionSourceType.ManualScore))
                    {
                        <form asp-action="SetManualScore" method="post" class="admin-summary-card mt-3" data-disable-on-submit="true">
                            <h4 class="h6">@component.DisplayName manuel puanı</h4>
                            <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                            <input type="hidden" name="applicationPublicId" value="@application.ApplicationPublicId" />
                            <input type="hidden" name="criterionPublicId" value="@component.CriterionPublicId" />
                            <input type="hidden" name="rowVersion" value="@component.RowVersion" />
                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-sm-6">
                                    <label for="score-@application.ApplicationPublicId-@component.CriterionPublicId" class="form-label">Ham puan</label>
                                    <input id="score-@application.ApplicationPublicId-@component.CriterionPublicId" name="rawScore" value="@component.RawScore?.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="@component.MaximumRawScore.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" class="form-control" required />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <button class="btn btn-primary" type="submit">Manuel puanı kaydet</button>
                                </div>
                            </div>
                        </form>
                    }
                }
            </article>
        }
    </section>

    <section class="admin-section" aria-labelledby="ranking-heading">
        <div class="admin-section-heading">
            <div>
                <span class="eyebrow">3. Sıralama ve sonuç işlemleri</span>
                <h2 id="ranking-heading">Deterministik sıralama önizlemesi</h2>
                <p>Kabul ve kontenjan dışı ayrımı metinle belirtilir; kontenjan çizgisi tabloda ayrıca işaretlenir.</p>
            </div>
        </div>

        @if (Model.Preview.BlockingReasons.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                <strong>Kesinleştirme önkoşulları tamamlanmadı.</strong>
                <ul class="mb-0">
                    @foreach (var reason in Model.Preview.BlockingReasons)
                    {
                        <li>@reason</li>
                    }
                </ul>
            </div>
        }

        <div class="table-shell">
            <div class="table-responsive">
                <table class="table table-sm responsive-table">
                    <caption class="visually-hidden">Aday sıralaması ve öngörülen sonuçlar</caption>
                    <thead>
                        <tr>
                            <th scope="col">Sıra</th>
                            <th scope="col">Maskelenmiş aday</th>
                            <th scope="col">Toplam puan</th>
                            <th scope="col">Öngörülen sonuç</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Preview.Rows)
                        {
                            <tr class="@(row.Rank == firstQuotaOutsideRank ? "quota-boundary" : null)">
                                <td data-label="Sıra">
                                    @row.Rank
                                    @if (row.Rank == firstQuotaOutsideRank)
                                    {
                                        <span class="quota-boundary__label">Kontenjan çizgisi</span>
                                    }
                                </td>
                                <td data-label="Maskelenmiş aday">@row.StudentFullName · @row.MaskedTc</td>
                                <td data-label="Toplam puan">@row.TotalScore.ToString("0.0000")</td>
                                <td data-label="Öngörülen sonuç"><strong>@row.ProjectedOutcome.DisplayName()</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (capabilities.CanFinalize && Model.Preview.CanFinalize)
        {
            <div class="danger-zone">
                <h3 class="h5">Sonuçları kesinleştirme</h3>
                <ul>
                    <li>Son başvuru tarihi: @(evaluation.ApplicationDeadlineUtc.HasValue ? IstanbulTime.FromUtc(evaluation.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm") : "Belirtilmemiş")</li>
                    <li>Politika toplamı: @totalWeight.ToString("N0") bp</li>
                    <li>Kontenjan: @evaluation.Quota</li>
                    <li>Kesinleştirme sıralama ve kararları dondurur; öğrenciler sonuçları henüz göremez.</li>
                </ul>
                <form asp-action="FinalizeEvaluation" method="post" data-disable-on-submit="true">
                    <input type="hidden" name="programOfferingId" value="@evaluation.ProgramOfferingId" />
                    <input type="hidden" name="rowVersion" value="@evaluation.OfferingRowVersion" />
                    <button class="btn btn-danger" type="submit">Sonuçları kesinleştir</button>
                </form>
            </div>
        }
        else if (capabilities.CanFinalize)
        {
            <p class="admin-readonly-note">Kesinleştirme formu, tüm önkoşullar tamamlanana kadar gösterilmez.</p>
        }
        else if (capabilities.CanPublish)
        {
            <div class="danger-zone">
                <h3 class="h5">Sonuçları yayımlama</h3>
                <p>Kesinleştirilmiş sonuçları ve geri alınamaz yayımlama etkilerini ayrı onay ekranında inceleyin.</p>
                <a asp-action="PublishEvaluation" asp-route-id="@evaluation.ProgramOfferingId" class="btn btn-danger">Yayımlama onayına geç</a>
            </div>
        }
        else if (evaluation.EvaluationState == OfferingEvaluationState.Published)
        {
            <div class="alert alert-success mb-0">Sonuçlar yayımlandı; başka bir sonuç mutation işlemi gösterilmiyor.</div>
        }
    </section>
    <script>
        (() => {
            const examScoreSource = '@EvaluationCriterionSourceType.ExamScore';
            document.querySelectorAll('[data-evaluation-criterion-form]').forEach(form => {
                const sourceType = form.querySelector('[data-source-type]');
                const examField = form.querySelector('[data-exam-field]');
                const examId = form.querySelector('[data-exam-id]');
                if (!sourceType || !examField || !examId) {
                    return;
                }

                const synchronizeExamField = () => {
                    const usesExam = sourceType.value === examScoreSource;
                    examField.hidden = !usesExam;
                    examId.disabled = !usesExam;
                    examId.required = usesExam;
                    if (!usesExam) {
                        examId.value = '';
                    }
                };

                sourceType.addEventListener('change', synchronizeExamField);
                synchronizeExamField();
            });
        })();
    </script>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
