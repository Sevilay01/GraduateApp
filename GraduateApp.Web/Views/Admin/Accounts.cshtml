@model AdminAccountPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Accounts.Title");
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.Status.HasValue;
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Admin.Accounts.Eyebrow")</span>
            <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Accounts.Heading")</h1>
            <p class="page-heading__description">@UiText.Get(Context, "Admin.Accounts.Lead")</p>
        </div>
        <div class="page-heading__actions">
            <a asp-action="Students" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Accounts.Students")</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    <div class="alert alert-info" role="note">
        @UiText.Get(Context, "Admin.Accounts.LastAdminRule")
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <form method="get" class="admin-filter-panel mb-4" aria-labelledby="admin-account-filter-heading">
                <h2 id="admin-account-filter-heading" class="admin-filter-panel__heading">@UiText.Get(Context, "Admin.Accounts.FilterHeading")</h2>
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label asp-for="Search" class="form-label">@UiText.Get(Context, "Field.Email")</label>
                        <input asp-for="Search" class="form-control" placeholder="@UiText.Get(Context, "Admin.Accounts.EmailPlaceholder")" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="Status" class="form-label">@UiText.Get(Context, "Admin.Accounts.StatusLabel")</label>
                        <select asp-for="Status" class="form-select">
                            <option value="">@UiText.Get(Context, "Admin.Accounts.Status.All")</option>
                            <option value="Active">@UiText.Get(Context, "Admin.Accounts.Status.Active")</option>
                            <option value="Inactive">@UiText.Get(Context, "Admin.Accounts.Status.Inactive")</option>
                            <option value="InvitationPending">@UiText.Get(Context, "Admin.Accounts.Status.InvitationPending")</option>
                            <option value="Locked">@UiText.Get(Context, "Admin.Accounts.Status.Locked")</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3 admin-form-actions">
                        <button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Accounts.Filter")</button>
                        <a asp-action="Accounts" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Accounts.Clear")</a>
                    </div>
                </div>
                @if (hasActiveFilters)
                {
                    <div class="active-filters" aria-label="@UiText.Get(Context, "Admin.Accounts.ActiveFilters")">
                        <span class="active-filters__label">@UiText.Get(Context, "Admin.Accounts.ActiveFilters")</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <span class="filter-chip">@UiText.Format(Context, "Admin.Accounts.EmailFilter", Model.Search)</span>
                        }
                        @if (Model.Status.HasValue)
                        {
                            <span class="filter-chip">@UiText.Format(Context, "Admin.Accounts.StatusFilter", UiText.Get(Context, $"Admin.Accounts.Status.{Model.Status}"))</span>
                        }
                    </div>
                }
            </form>

            <div class="admin-results-heading mb-3">
                <div>
                    <h2>@UiText.Get(Context, "Admin.Accounts.ResultsHeading")</h2>
                    <p class="admin-results-count" role="status">@UiText.Format(Context, "Admin.Accounts.ResultCount", Model.Result.TotalCount)</p>
                </div>
            </div>

            @if (Model.Result.Items.Count == 0)
            {
                <div class="empty-state">
                    <h3>@UiText.Get(Context, "Admin.Accounts.EmptyHeading")</h3>
                    <p>@UiText.Get(Context, "Admin.Accounts.EmptyLead")</p>
                </div>
            }
            else
            {
                <div class="table-shell">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle responsive-table">
                            <caption class="visually-hidden">@UiText.Get(Context, "Admin.Accounts.TableCaption")</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@UiText.Get(Context, "Field.Email")</th>
                                    <th scope="col">@UiText.Get(Context, "Admin.Accounts.StatusLabel")</th>
                                    <th scope="col">@UiText.Get(Context, "Admin.Accounts.SignInSecurity")</th>
                                    <th scope="col">@UiText.Get(Context, "Admin.Accounts.Dates")</th>
                                    <th scope="col">@UiText.Get(Context, "Admin.Accounts.Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in Model.Result.Items)
                                {
                                    var stateClass = !account.IsActive
                                        ? string.Empty
                                        : account.IsInvitationPending
                                            ? "admin-state--warning"
                                            : "admin-state--success";
                                    var stateName = !account.IsActive
                                        ? UiText.Get(Context, "Admin.Accounts.Status.Inactive")
                                        : account.IsInvitationPending
                                            ? UiText.Get(Context, "Admin.Accounts.Status.InvitationPending")
                                            : UiText.Get(Context, "Admin.Accounts.Status.Active");
                                    <tr>
                                        <td data-label="@UiText.Get(Context, "Field.Email")">
                                            @account.Email
                                            @if (account.IsCurrentAdmin)
                                            {
                                                <span class="admin-state admin-state--info ms-1">@UiText.Get(Context, "Admin.Accounts.Current")</span>
                                            }
                                        </td>
                                        <td data-label="@UiText.Get(Context, "Admin.Accounts.StatusLabel")"><span class="admin-state @stateClass">@stateName</span></td>
                                        <td data-label="@UiText.Get(Context, "Admin.Accounts.SignInSecurity")">
                                            @if (account.IsLocked)
                                            {
                                                <span class="admin-state admin-state--danger">@UiText.Get(Context, "Admin.Accounts.Status.Locked")</span>
                                            }
                                            else
                                            {
                                                <span>@UiText.Format(Context, "Admin.Accounts.FailedSignIns", account.AccessFailedCount)</span>
                                            }
                                        </td>
                                        <td data-label="@UiText.Get(Context, "Admin.Accounts.Dates")" class="small">
                                            <div>@UiText.Format(Context, "Admin.Accounts.Created", IstanbulTime.FromUtc(account.CreatedAtUtc).ToString("g"))</div>
                                            <div>@UiText.Format(Context, "Admin.Accounts.Updated", IstanbulTime.FromUtc(account.UpdatedAtUtc).ToString("g"))</div>
                                        </td>
                                        <td data-label="">
                                            <div class="admin-action-stack">
                                                @if (account.IsInvitationPending && account.IsActive)
                                                {
                                                    <form asp-action="ResendAdminInvitation" method="post" data-disable-on-submit="true">
                                                        <input type="hidden" name="publicId" value="@account.PublicId" />
                                                        <input type="hidden" name="rowVersion" value="@account.RowVersion" />
                                                        <button class="btn btn-sm btn-outline-primary" type="submit">@UiText.Get(Context, "Admin.Accounts.ResendInvitation")</button>
                                                    </form>
                                                }
                                                @if (account.IsLocked)
                                                {
                                                    <form asp-action="UnlockAdmin" method="post" data-disable-on-submit="true">
                                                        <input type="hidden" name="publicId" value="@account.PublicId" />
                                                        <input type="hidden" name="rowVersion" value="@account.RowVersion" />
                                                        <button class="btn btn-sm btn-outline-primary" type="submit">@UiText.Get(Context, "Admin.Accounts.Unlock")</button>
                                                    </form>
                                                }
                                                @if (!account.IsCurrentAdmin && account.IsActive)
                                                {
                                                    <form asp-action="DeactivateAdmin" method="post" data-disable-on-submit="true">
                                                        <input type="hidden" name="publicId" value="@account.PublicId" />
                                                        <input type="hidden" name="rowVersion" value="@account.RowVersion" />
                                                        <button class="btn btn-sm btn-outline-danger" type="submit">@UiText.Get(Context, "Admin.Accounts.Deactivate")</button>
                                                    </form>
                                                }
                                                else if (!account.IsActive)
                                                {
                                                    <form asp-action="ActivateAdmin" method="post" data-disable-on-submit="true">
                                                        <input type="hidden" name="publicId" value="@account.PublicId" />
                                                        <input type="hidden" name="rowVersion" value="@account.RowVersion" />
                                                        <button class="btn btn-sm btn-outline-success" type="submit">@UiText.Get(Context, "Admin.Accounts.Activate")</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (Model.Result.TotalPages > 1)
            {
                <nav class="mt-3" aria-label="@UiText.Get(Context, "Admin.Accounts.Pagination")">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Accounts" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Result.Page - 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Accounts.Previous")</a></li>
                        <li class="page-item disabled"><span class="page-link" aria-current="page">@Model.Result.Page / @Model.Result.TotalPages</span></li>
                        <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Accounts" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-page="@(Model.Result.Page + 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Accounts.Next")</a></li>
                    </ul>
                </nav>
            }
        </div>

        <div class="col-12 col-xl-4">
            <section class="admin-section" aria-labelledby="admin-invite-heading">
                <div class="admin-section-heading">
                    <div>
                        <h2 id="admin-invite-heading">@UiText.Get(Context, "Admin.Accounts.InviteHeading")</h2>
                        <p>@UiText.Get(Context, "Admin.Accounts.InviteLead")</p>
                    </div>
                </div>
                <form asp-action="InviteAdmin" method="post" novalidate data-disable-on-submit="true">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Invite.Email" class="form-label">@UiText.Get(Context, "Field.Email")</label>
                        <input asp-for="Invite.Email" name="Email" class="form-control" autocomplete="email" maxlength="254" />
                        <span asp-validation-for="Invite.Email" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Accounts.InviteSubmit")</button>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
