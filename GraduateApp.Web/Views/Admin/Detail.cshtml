@model AdminApplicationDetailViewModel
@{
    ViewData["Title"] = "Başvuru detayı";
    var transitions = Model.UsesEvaluationWorkflow
        ? Model.CurrentStatus.AllowedAdminTransitions().Where(item => item == ApplicationStatus.UnderReview).ToArray()
        : Model.CurrentStatus.AllowedAdminTransitions();
    var allRequiredDocumentsApproved = !Model.UsesDocumentWorkflow || Model.DocumentRequirements
        .Where(item => item.IsRequired)
        .All(item => item.CurrentDocument?.ReviewStatus == DocumentReviewStatus.Approved);
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Başvurular</span>
            <h1 class="page-heading__title">Başvuru detayı</h1>
            <p class="page-heading__description">@Model.ProgramName · @Model.AcademicYear · @Model.TermName</p>
        </div>
        <div class="page-heading__actions">
            <partial name="_ApplicationStatusBadge" model="Model.CurrentStatus" />
            <a asp-action="Index" class="btn btn-outline-secondary">Başvuru listesine dön</a>
        </div>
    </header>

    <section class="admin-summary-grid" aria-label="Başvuru özeti">
        <article class="admin-summary-card">
            <h2>Başvuru özeti</h2>
            <dl>
                <dt>Başvuru tarihi</dt>
                <dd><time datetime="@Model.ApplicationDateUtc.ToString("O")">@IstanbulTime.FromUtc(Model.ApplicationDateUtc).ToString("dd.MM.yyyy HH:mm")</time></dd>
                <dt>Güncel durum</dt>
                <dd>@Model.CurrentStatus.DisplayName()</dd>
                <dt>Belge akışı</dt>
                <dd>@(Model.UsesDocumentWorkflow ? "Etkin" : "Legacy akış")</dd>
                <dt>Değerlendirme</dt>
                <dd>@(Model.UsesEvaluationWorkflow ? "Sıralamalı iş akışı" : "Standart karar akışı")</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>Öğrenci bilgileri</h2>
            <dl>
                <dt>Ad soyad</dt>
                <dd>@Model.StudentFullName</dd>
                <dt>Maskelenmiş TC</dt>
                <dd>@Model.MaskedTc</dd>
                <dt>E-posta</dt>
                <dd>@Model.Email</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>Program bilgileri</h2>
            <dl>
                <dt>Enstitü</dt>
                <dd>@Model.InstituteName</dd>
                <dt>Program</dt>
                <dd>@Model.ProgramName</dd>
                <dt>Akademik dönem</dt>
                <dd>@Model.AcademicYear · @Model.TermName</dd>
            </dl>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="application-lifecycle-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="application-lifecycle-heading">Başvuru yaşam döngüsü</h2>
                <p>Durum değişiklikleri ve yönetici notları kronolojik kayıt olarak korunur.</p>
            </div>
        </div>
        @if (Model.History.Count == 0)
        {
            <div class="empty-state">
                <h3>Henüz durum kaydı yok</h3>
                <p>İlk durum değişikliği burada tarih ve notuyla görüntülenecek.</p>
            </div>
        }
        else
        {
            <ol class="admin-lifecycle">
                @foreach (var history in Model.History.OrderByDescending(item => item.ChangedAtUtc))
                {
                    <li>
                        <strong>@history.CurrentStatus.DisplayName()</strong>
                        <time datetime="@history.ChangedAtUtc.ToString("O")">@IstanbulTime.FromUtc(history.ChangedAtUtc).ToString("dd.MM.yyyy HH:mm") (İstanbul)</time>
                        @if (!string.IsNullOrWhiteSpace(history.Notes))
                        {
                            <p class="mb-0 mt-1">@history.Notes</p>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    <section class="admin-section" aria-labelledby="scores-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="scores-heading">Başvuru anındaki sınav sonuçları</h2>
                <p>Bu değerler başvuru oluşturulurken alınan snapshot kayıtlarıdır.</p>
            </div>
        </div>
        @if (Model.ScoreSnapshots.Count == 0)
        {
            <div class="empty-state">
                <h3>Sınav sonucu bulunmuyor</h3>
                <p>Bu başvuru için kaydedilmiş sınav sonucu snapshot’ı yok.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table table-sm responsive-table">
                        <caption class="visually-hidden">Başvuru anındaki sınav sonucu snapshot’ları</caption>
                        <thead>
                            <tr>
                                <th scope="col">Sınav</th>
                                <th scope="col">Puan</th>
                                <th scope="col">Sınav tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var score in Model.ScoreSnapshots)
                            {
                                <tr>
                                    <td data-label="Sınav">@score.ExamName</td>
                                    <td data-label="Puan">@score.Score</td>
                                    <td data-label="Sınav tarihi">@score.ExamDate?.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="admin-section" aria-labelledby="documents-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="documents-heading">Belge gereksinimleri ve inceleme</h2>
                <p>Yalnızca Pending veya UnderReview başvurulardaki inceleme bekleyen güncel belgeler için karar verilebilir.</p>
            </div>
        </div>

        @if (!Model.UsesDocumentWorkflow)
        {
            <div class="alert alert-info mb-0" role="note">Bu legacy başvuru yeni belge onay koşullarından muaftır.</div>
        }
        else if (Model.DocumentRequirements.Count == 0)
        {
            <div class="empty-state">
                <h3>Belge gereksinimi bulunmuyor</h3>
                <p>Başvurunun belge snapshot’ında bir gereksinim yer almıyor.</p>
            </div>
        }
        else
        {
            <div class="document-list">
                @foreach (var requirement in Model.DocumentRequirements)
                {
                    var current = requirement.CurrentDocument;
                    var reviewClass = current?.ReviewStatus switch
                    {
                        DocumentReviewStatus.Approved => "admin-state--success",
                        DocumentReviewStatus.Rejected => "admin-state--danger",
                        _ => "admin-state--info"
                    };
                    <article class="document-card @(requirement.IsRequired ? "document-card--required" : null)">
                        <header>
                            <div>
                                <span class="eyebrow">@(requirement.IsRequired ? "Zorunlu belge" : "İsteğe bağlı belge")</span>
                                <h3>@requirement.DisplayName</h3>
                                @if (!string.IsNullOrWhiteSpace(requirement.Description))
                                {
                                    <p class="text-muted mb-0">@requirement.Description</p>
                                }
                            </div>
                            <span class="admin-state @reviewClass">@(current?.ReviewStatus.ReviewName() ?? "Belge yüklenmedi")</span>
                        </header>

                        @if (current is null)
                        {
                            <p class="empty-inline">Güncel belge bulunmuyor.</p>
                        }
                        else
                        {
                            <div class="document-current">
                                <dl class="meta-grid">
                                    <div><dt>Dosya adı</dt><dd>@current.OriginalFileName</dd></div>
                                    <div><dt>Sürüm</dt><dd>@current.VersionNumber</dd></div>
                                    <div><dt>Yüklenme zamanı</dt><dd><time datetime="@current.UploadedAtUtc.ToString("O")">@IstanbulTime.FromUtc(current.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</time></dd></div>
                                    <div><dt>İnceleme durumu</dt><dd>@current.ReviewStatus.ReviewName()</dd></div>
                                </dl>

                                @if (current.ReviewStatus == DocumentReviewStatus.Rejected)
                                {
                                    <div class="alert alert-danger py-2"><strong>Ret gerekçesi:</strong> @current.RejectionReason</div>
                                }

                                <a asp-action="DownloadDocument"
                                   asp-route-applicationPublicId="@Model.PublicId"
                                   asp-route-documentPublicId="@current.PublicId"
                                   class="btn btn-sm btn-outline-secondary">Güncel belgeyi güvenli indir</a>

                                @if (Model.CurrentStatus.CanReviewDocument(current.ReviewStatus))
                                {
                                    <div class="admin-review-actions" data-document-review-actions>
                                        <form asp-action="ReviewDocument" method="post" data-disable-on-submit="true">
                                            <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                            <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                            <input type="hidden" name="ReviewStatus" value="Approved" />
                                            <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                            <button type="submit" class="btn btn-success">Belgeyi onayla</button>
                                        </form>
                                        <form asp-action="ReviewDocument" method="post" data-disable-on-submit="true">
                                            <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                            <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                            <input type="hidden" name="ReviewStatus" value="Rejected" />
                                            <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                            <label for="rejection-@current.PublicId" class="form-label">Türkçe ret gerekçesi</label>
                                            <textarea id="rejection-@current.PublicId" name="RejectionReason" class="form-control" rows="3" maxlength="500" required></textarea>
                                            <button type="submit" class="btn btn-danger mt-2">Belgeyi reddet</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <p class="admin-readonly-note" data-document-review-readonly>
                                        Bu belge için işlem formu gösterilmiyor. Belge kararı tamamlanmış veya başvuru incelemeye açık bir durumda değil.
                                    </p>
                                }
                            </div>
                        }

                        @if (requirement.Versions.Count > 1)
                        {
                            <details class="mt-3">
                                <summary>Geçmiş belge sürümleri</summary>
                                <ul class="list-group list-group-flush mt-2">
                                    @foreach (var version in requirement.Versions.Where(item => !item.IsCurrent))
                                    {
                                        <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <span>Sürüm @version.VersionNumber · @version.ReviewStatus.ReviewName() · @IstanbulTime.FromUtc(version.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</span>
                                            <a asp-action="DownloadDocument" asp-route-applicationPublicId="@Model.PublicId" asp-route-documentPublicId="@version.PublicId" class="btn btn-sm btn-outline-secondary">Sürümü güvenli indir</a>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-section" aria-labelledby="allowed-actions-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="allowed-actions-heading">İzin verilen eylemler</h2>
                <p>Sunucu tarafındaki yaşam döngüsü, belge ve eşzamanlılık kontrolleri her istekte yeniden uygulanır.</p>
            </div>
        </div>
        @if (Model.UsesEvaluationWorkflow)
        {
            <div class="alert alert-info" role="note">Onay ve ret kararı, ilan değerlendirmesi kesinleştirilip yayımlandığında atomik olarak uygulanır.</div>
        }
        @if (transitions.Count == 0)
        {
            <p class="admin-readonly-note mb-0">Bu durumdan yönetici tarafından yapılabilecek başka bir geçiş yok.</p>
        }
        else
        {
            <form asp-action="UpdateStatus" method="post" class="row g-3" novalidate data-disable-on-submit="true">
                <input type="hidden" name="PublicId" value="@Model.PublicId" />
                <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                <div class="col-12 col-md-4">
                    <label for="NewStatus" class="form-label">Yeni durum</label>
                    <select id="NewStatus" name="NewStatus" class="form-select" required>
                        @foreach (var status in transitions)
                        {
                            if (status != ApplicationStatus.Approved || allRequiredDocumentsApproved)
                            {
                                <option value="@status">@status.DisplayName()</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-8">
                    <label for="Notes" class="form-label">Yönetici notu</label>
                    <textarea id="Notes" name="Notes" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Başvuru durumunu güncelle</button>
                    @if (transitions.Contains(ApplicationStatus.Approved) && !allRequiredDocumentsApproved)
                    {
                        <p class="small text-warning mt-2 mb-0">Tüm zorunlu güncel belgeler onaylanmadan başvuru onaylanamaz.</p>
                    }
                </div>
            </form>
        }
    </section>
</div>
