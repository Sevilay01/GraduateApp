@model AdminApplicationDetailViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Detail.Title");
    var transitions = Model.UsesEvaluationWorkflow
        ? Model.CurrentStatus.AllowedAdminTransitions().Where(item => item == ApplicationStatus.UnderReview).ToArray()
        : Model.CurrentStatus.AllowedAdminTransitions();
    var allRequiredDocumentsApproved = !Model.UsesDocumentWorkflow || Model.DocumentRequirements
        .Where(item => item.IsRequired)
        .All(item => item.CurrentDocument?.ReviewStatus == DocumentReviewStatus.Approved);
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Admin.Applications.Eyebrow")</span>
            <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Detail.Title")</h1>
            <p class="page-heading__description">@Model.ProgramName · @Model.AcademicYear · @UiText.LocalizeAcademicTerm(Context, Model.TermName)</p>
        </div>
        <div class="page-heading__actions">
            <partial name="_ApplicationStatusBadge" model="Model.CurrentStatus" />
            <a asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Detail.Back")</a>
        </div>
    </header>

    <section class="admin-summary-grid" aria-label="@UiText.Get(Context, "Admin.Detail.SummaryAria")">
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Detail.SummaryHeading")</h2>
            <dl>
                <dt>@UiText.Get(Context, "Admin.Applications.ApplicationDate")</dt>
                <dd><time datetime="@Model.ApplicationDateUtc.ToString("O")">@IstanbulTime.FromUtc(Model.ApplicationDateUtc).ToString("g")</time></dd>
                <dt>@UiText.Get(Context, "Admin.Detail.CurrentStatus")</dt>
                <dd>@UiText.LocalizeApplicationStatus(Context, Model.CurrentStatus)</dd>
                <dt>@UiText.Get(Context, "Admin.Detail.DocumentWorkflow")</dt>
                <dd>@(Model.UsesDocumentWorkflow ? UiText.Get(Context, "Admin.Detail.WorkflowEnabled") : UiText.Get(Context, "Admin.Detail.LegacyWorkflow"))</dd>
                <dt>@UiText.Get(Context, "Admin.Detail.Evaluation")</dt>
                <dd>@(Model.UsesEvaluationWorkflow ? UiText.Get(Context, "Admin.Detail.RankedWorkflow") : UiText.Get(Context, "Admin.Detail.StandardWorkflow"))</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Detail.StudentHeading")</h2>
            <dl>
                <dt>@UiText.Get(Context, "Admin.Detail.FullName")</dt>
                <dd>@Model.StudentFullName</dd>
                <dt>@UiText.Get(Context, "Admin.Students.MaskedIdentity")</dt>
                <dd>@Model.MaskedTc</dd>
                <dt>@UiText.Get(Context, "Field.Email")</dt>
                <dd>@Model.Email</dd>
            </dl>
        </article>
        <article class="admin-summary-card">
            <h2>@UiText.Get(Context, "Admin.Detail.ProgramHeading")</h2>
            <dl>
                <dt>@UiText.Get(Context, "Admin.Institutes.Institute")</dt>
                <dd>@Model.InstituteName</dd>
                <dt>@UiText.Get(Context, "Admin.Institutes.Program")</dt>
                <dd>@Model.ProgramName</dd>
                <dt>@UiText.Get(Context, "Admin.Detail.AcademicPeriod")</dt>
                <dd>@Model.AcademicYear · @UiText.LocalizeAcademicTerm(Context, Model.TermName)</dd>
            </dl>
        </article>
    </section>

    <section class="admin-section" aria-labelledby="application-lifecycle-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="application-lifecycle-heading">@UiText.Get(Context, "Admin.Detail.LifecycleHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Detail.LifecycleLead")</p>
            </div>
        </div>
        @if (Model.History.Count == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Detail.NoHistoryHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Detail.NoHistoryLead")</p>
            </div>
        }
        else
        {
            <ol class="admin-lifecycle">
                @foreach (var history in Model.History.OrderByDescending(item => item.ChangedAtUtc))
                {
                    <li>
                        <strong>@UiText.LocalizeApplicationStatus(Context, history.CurrentStatus)</strong>
                        <time datetime="@history.ChangedAtUtc.ToString("O")">@IstanbulTime.FromUtc(history.ChangedAtUtc).ToString("g") (@UiText.Get(Context, "Admin.Detail.IstanbulTime"))</time>
                        @if (!string.IsNullOrWhiteSpace(history.Notes))
                        {
                            <p class="mb-0 mt-1">@history.Notes</p>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    <section class="admin-section" aria-labelledby="scores-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="scores-heading">@UiText.Get(Context, "Admin.Detail.ScoresHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Detail.ScoresLead")</p>
            </div>
        </div>
        @if (Model.ScoreSnapshots.Count == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Detail.NoScoresHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Detail.NoScoresLead")</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table table-sm responsive-table">
                        <caption class="visually-hidden">@UiText.Get(Context, "Admin.Detail.ScoresCaption")</caption>
                        <thead>
                            <tr>
                                <th scope="col">@UiText.Get(Context, "Admin.Detail.Exam")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Detail.Score")</th>
                                <th scope="col">@UiText.Get(Context, "Admin.Detail.ExamDate")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var score in Model.ScoreSnapshots)
                            {
                                <tr>
                                    <td data-label="@UiText.Get(Context, "Admin.Detail.Exam")">@score.ExamName</td>
                                    <td data-label="@UiText.Get(Context, "Admin.Detail.Score")">@score.Score</td>
                                    <td data-label="@UiText.Get(Context, "Admin.Detail.ExamDate")">@score.ExamDate?.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <section class="admin-section" aria-labelledby="documents-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="documents-heading">@UiText.Get(Context, "Admin.Detail.DocumentsHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Detail.DocumentsLead")</p>
            </div>
        </div>

        @if (!Model.UsesDocumentWorkflow)
        {
            <div class="alert alert-info mb-0" role="note">@UiText.Get(Context, "Admin.Detail.LegacyDocumentExempt")</div>
        }
        else if (Model.DocumentRequirements.Count == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Detail.NoRequirementsHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Detail.NoRequirementsLead")</p>
            </div>
        }
        else
        {
            <div class="document-list">
                @foreach (var requirement in Model.DocumentRequirements)
                {
                    var current = requirement.CurrentDocument;
                    var reviewClass = current?.ReviewStatus switch
                    {
                        DocumentReviewStatus.Approved => "admin-state--success",
                        DocumentReviewStatus.Rejected => "admin-state--danger",
                        _ => "admin-state--info"
                    };
                    <article class="document-card @(requirement.IsRequired ? "document-card--required" : null)">
                        <header>
                            <div>
                                <span class="eyebrow">@(requirement.IsRequired ? UiText.Get(Context, "Admin.Detail.RequiredDocument") : UiText.Get(Context, "Admin.Detail.OptionalDocument"))</span>
                                <h3>@requirement.DisplayName</h3>
                                @if (!string.IsNullOrWhiteSpace(requirement.Description))
                                {
                                    <p class="text-muted mb-0">@requirement.Description</p>
                                }
                            </div>
                            <span class="admin-state @reviewClass">@(current is null ? UiText.Get(Context, "Admin.Detail.NotUploaded") : UiText.LocalizeDocumentReview(Context, current.ReviewStatus))</span>
                        </header>

                        @if (current is null)
                        {
                            <p class="empty-inline">@UiText.Get(Context, "Admin.Detail.NoCurrentDocument")</p>
                        }
                        else
                        {
                            <div class="document-current">
                                <dl class="meta-grid">
                                    <div><dt>@UiText.Get(Context, "Admin.Detail.FileName")</dt><dd>@current.OriginalFileName</dd></div>
                                    <div><dt>@UiText.Get(Context, "Admin.Detail.Version")</dt><dd>@current.VersionNumber</dd></div>
                                    <div><dt>@UiText.Get(Context, "Admin.Detail.UploadedAt")</dt><dd><time datetime="@current.UploadedAtUtc.ToString("O")">@IstanbulTime.FromUtc(current.UploadedAtUtc).ToString("g")</time></dd></div>
                                    <div><dt>@UiText.Get(Context, "Admin.Detail.ReviewStatus")</dt><dd>@UiText.LocalizeDocumentReview(Context, current.ReviewStatus)</dd></div>
                                </dl>

                                @if (current.ReviewStatus == DocumentReviewStatus.Rejected)
                                {
                                    <div class="alert alert-danger py-2"><strong>@UiText.Get(Context, "Admin.Detail.RejectionReason")</strong> @current.RejectionReason</div>
                                }

                                <a asp-action="DownloadDocument"
                                   asp-route-applicationPublicId="@Model.PublicId"
                                   asp-route-documentPublicId="@current.PublicId"
                                   class="btn btn-sm btn-outline-secondary">@UiText.Get(Context, "Admin.Detail.DownloadCurrent")</a>

                                @if (Model.CurrentStatus.CanReviewDocument(current.ReviewStatus))
                                {
                                    <div class="admin-review-actions" data-document-review-actions>
                                        <form asp-action="ReviewDocument" method="post" data-disable-on-submit="true">
                                            <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                            <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                            <input type="hidden" name="ReviewStatus" value="Approved" />
                                            <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                            <button type="submit" class="btn btn-success">@UiText.Get(Context, "Admin.Detail.ApproveDocument")</button>
                                        </form>
                                        <form asp-action="ReviewDocument" method="post" data-disable-on-submit="true">
                                            <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                            <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                            <input type="hidden" name="ReviewStatus" value="Rejected" />
                                            <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                            <label for="rejection-@current.PublicId" class="form-label">@UiText.Get(Context, "Admin.Detail.TurkishRejectionReason")</label>
                                            <textarea id="rejection-@current.PublicId" name="RejectionReason" class="form-control" rows="3" maxlength="500" required></textarea>
                                            <button type="submit" class="btn btn-danger mt-2">@UiText.Get(Context, "Admin.Detail.RejectDocument")</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <p class="admin-readonly-note" data-document-review-readonly>
                                        @UiText.Get(Context, "Admin.Detail.ReviewReadonly")
                                    </p>
                                }
                            </div>
                        }

                        @if (requirement.Versions.Count > 1)
                        {
                            <details class="mt-3">
                                <summary>@UiText.Get(Context, "Admin.Detail.PreviousVersions")</summary>
                                <ul class="list-group list-group-flush mt-2">
                                    @foreach (var version in requirement.Versions.Where(item => !item.IsCurrent))
                                    {
                                        <li class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <span>@UiText.Format(Context, "Admin.Detail.VersionSummary", version.VersionNumber, UiText.LocalizeDocumentReview(Context, version.ReviewStatus), IstanbulTime.FromUtc(version.UploadedAtUtc).ToString("g"))</span>
                                            <a asp-action="DownloadDocument" asp-route-applicationPublicId="@Model.PublicId" asp-route-documentPublicId="@version.PublicId" class="btn btn-sm btn-outline-secondary">@UiText.Get(Context, "Admin.Detail.DownloadVersion")</a>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="admin-section" aria-labelledby="allowed-actions-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="allowed-actions-heading">@UiText.Get(Context, "Admin.Detail.ActionsHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Detail.ActionsLead")</p>
            </div>
        </div>
        @if (Model.UsesEvaluationWorkflow)
        {
            <div class="alert alert-info" role="note">@UiText.Get(Context, "Admin.Detail.EvaluationDecisionNote")</div>
        }
        @if (transitions.Count == 0)
        {
            <p class="admin-readonly-note mb-0">@UiText.Get(Context, "Admin.Detail.NoTransitions")</p>
        }
        else
        {
            <form asp-action="UpdateStatus" method="post" class="row g-3" novalidate data-disable-on-submit="true">
                <input type="hidden" name="PublicId" value="@Model.PublicId" />
                <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                <div class="col-12 col-md-4">
                    <label for="NewStatus" class="form-label">@UiText.Get(Context, "Admin.Detail.NewStatus")</label>
                    <select id="NewStatus" name="NewStatus" class="form-select" required>
                        @foreach (var status in transitions)
                        {
                            if (status != ApplicationStatus.Approved || allRequiredDocumentsApproved)
                            {
                                <option value="@status">@UiText.LocalizeApplicationStatus(Context, status)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-8">
                    <label for="Notes" class="form-label">@UiText.Get(Context, "Admin.Detail.AdminNote")</label>
                    <textarea id="Notes" name="Notes" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Admin.Detail.UpdateStatus")</button>
                    @if (transitions.Contains(ApplicationStatus.Approved) && !allRequiredDocumentsApproved)
                    {
                        <p class="small text-warning mt-2 mb-0">@UiText.Get(Context, "Admin.Detail.RequiredDocumentsWarning")</p>
                    }
                </div>
            </form>
        }
    </section>
</div>
