@model AdminApplicationDetailViewModel
@{
    ViewData["Title"] = "Başvuru detayı";
    var transitions = Model.CurrentStatus.AllowedAdminTransitions();
    var allRequiredDocumentsApproved = !Model.UsesDocumentWorkflow || Model.DocumentRequirements
        .Where(item => item.IsRequired)
        .All(item => item.CurrentDocument?.ReviewStatus == DocumentReviewStatus.Approved);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h2 mb-0">Başvuru detayı</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Listeye dön</a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <section class="card shadow-sm" aria-labelledby="application-info-heading">
            <div class="card-body">
                <h2 id="application-info-heading" class="h4">Başvuru bilgileri</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Öğrenci</dt><dd class="col-sm-8">@Model.StudentFullName</dd>
                    <dt class="col-sm-4">TC kimlik numarası</dt><dd class="col-sm-8">@Model.MaskedTc</dd>
                    <dt class="col-sm-4">E-posta</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Enstitü</dt><dd class="col-sm-8">@Model.InstituteName</dd>
                    <dt class="col-sm-4">Program</dt><dd class="col-sm-8">@Model.ProgramName</dd>
                    <dt class="col-sm-4">Akademik dönem</dt><dd class="col-sm-8">@Model.AcademicYear · @Model.TermName</dd>
                    <dt class="col-sm-4">Başvuru tarihi</dt><dd class="col-sm-8">@IstanbulTime.FromUtc(Model.ApplicationDateUtc).ToString("dd.MM.yyyy HH:mm") (İstanbul)</dd>
                    <dt class="col-sm-4">Durum</dt><dd class="col-sm-8"><strong>@Model.CurrentStatus.DisplayName()</strong></dd>
                </dl>
            </div>
        </section>

        <section class="card shadow-sm mt-4" aria-labelledby="scores-heading">
            <div class="card-body">
                <h2 id="scores-heading" class="h4">Başvuru anındaki sınav sonuçları</h2>
                @if (Model.ScoreSnapshots.Count == 0)
                {
                    <p class="text-muted mb-0">Bu başvuru için kaydedilmiş sınav sonucu bulunmuyor.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead><tr><th>Sınav</th><th>Puan</th><th>Sınav tarihi</th></tr></thead>
                            <tbody>
                                @foreach (var score in Model.ScoreSnapshots)
                                {
                                    <tr><td>@score.ExamName</td><td>@score.Score</td><td>@score.ExamDate?.ToString("dd.MM.yyyy")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <section class="card shadow-sm mt-4" aria-labelledby="history-heading">
            <div class="card-body">
                <h2 id="history-heading" class="h4">Durum geçmişi</h2>
                @if (Model.History.Count == 0)
                {
                    <p class="text-muted mb-0">Henüz durum geçmişi bulunmuyor.</p>
                }
                else
                {
                    <ol class="list-group list-group-numbered">
                        @foreach (var history in Model.History)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between gap-3">
                                    <strong>@history.CurrentStatus.DisplayName()</strong>
                                    <time class="small text-muted" datetime="@history.ChangedAtUtc.ToString("O")">@IstanbulTime.FromUtc(history.ChangedAtUtc).ToString("dd.MM.yyyy HH:mm") (İstanbul)</time>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(history.Notes))
                                {
                                    <p class="mb-0 mt-1">@history.Notes</p>
                                }
                            </li>
                        }
                    </ol>
                }
            </div>
        </section>

        @if (Model.UsesDocumentWorkflow)
        {
            <section class="card shadow-sm mt-4" aria-labelledby="documents-heading">
                <div class="card-body">
                    <h2 id="documents-heading" class="h4">Başvuru belgeleri</h2>
                    @foreach (var requirement in Model.DocumentRequirements)
                    {
                        var current = requirement.CurrentDocument;
                        <article class="border rounded p-3 mb-3">
                            <div class="d-flex justify-content-between gap-2">
                                <h3 class="h6">@requirement.DisplayName</h3>
                                <span class="badge @(requirement.IsRequired ? "text-bg-danger" : "text-bg-light")">@(requirement.IsRequired ? "Zorunlu" : "İsteğe bağlı")</span>
                            </div>
                            @if (current is null)
                            {
                                <p class="text-muted mb-0">Güncel belge bulunmuyor.</p>
                            }
                            else
                            {
                                <div class="small mb-2">
                                    <span>@current.OriginalFileName</span> ·
                                    <span>Sürüm @current.VersionNumber</span> ·
                                    <span>@current.ReviewStatus.ReviewName()</span> ·
                                    <time datetime="@current.UploadedAtUtc.ToString("O")">@IstanbulTime.FromUtc(current.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</time>
                                </div>
                                @if (current.ReviewStatus == DocumentReviewStatus.Rejected)
                                {
                                    <div class="alert alert-danger py-2"><strong>Ret gerekçesi:</strong> @current.RejectionReason</div>
                                }
                                <a asp-action="DownloadDocument"
                                   asp-route-applicationPublicId="@Model.PublicId"
                                   asp-route-documentPublicId="@current.PublicId"
                                   class="btn btn-sm btn-outline-secondary">Güncel belgeyi indir</a>

                                @if (Model.CurrentStatus.CanReviewDocument(current.ReviewStatus))
                                {
                                    <div class="row g-2 mt-2">
                                        <div class="col-auto">
                                            <form asp-action="ReviewDocument" method="post">
                                                <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                                <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                                <input type="hidden" name="ReviewStatus" value="Approved" />
                                                <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                                <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                                            </form>
                                        </div>
                                        <div class="col-12 col-md">
                                            <form asp-action="ReviewDocument" method="post" class="d-flex gap-2">
                                                <input type="hidden" name="ApplicationPublicId" value="@Model.PublicId" />
                                                <input type="hidden" name="DocumentPublicId" value="@current.PublicId" />
                                                <input type="hidden" name="ReviewStatus" value="Rejected" />
                                                <input type="hidden" name="RowVersion" value="@current.RowVersion" />
                                                <input name="RejectionReason" class="form-control form-control-sm" maxlength="500" placeholder="Türkçe ret gerekçesi" required />
                                                <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            }

                            @if (requirement.Versions.Count > 1)
                            {
                                <details class="mt-3">
                                    <summary>Geçmiş sürümler</summary>
                                    <ul class="list-group list-group-flush mt-2">
                                        @foreach (var version in requirement.Versions.Where(item => !item.IsCurrent))
                                        {
                                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                                <span>Sürüm @version.VersionNumber · @version.ReviewStatus.ReviewName() · @IstanbulTime.FromUtc(version.UploadedAtUtc).ToString("dd.MM.yyyy HH:mm")</span>
                                                <a asp-action="DownloadDocument" asp-route-applicationPublicId="@Model.PublicId" asp-route-documentPublicId="@version.PublicId" class="btn btn-sm btn-outline-secondary">İndir</a>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </article>
                    }
                </div>
            </section>
        }
        else
        {
            <div class="alert alert-info mt-4">Bu legacy başvuru yeni belge onay koşullarından muaftır.</div>
        }
    </div>

    <div class="col-12 col-lg-5">
        <section class="card shadow-sm" aria-labelledby="update-heading">
            <div class="card-body">
                <h2 id="update-heading" class="h4">Durumu güncelle</h2>
                @if (transitions.Count == 0)
                {
                    <p class="text-muted mb-0">Bu durumdan izin verilen başka bir geçiş yok.</p>
                }
                else
                {
                    <form asp-action="UpdateStatus" method="post" novalidate>
                        <input type="hidden" name="PublicId" value="@Model.PublicId" />
                        <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                        <div class="mb-3">
                            <label for="NewStatus" class="form-label">Yeni durum</label>
                            <select id="NewStatus" name="NewStatus" class="form-select" required>
                                @foreach (var status in transitions)
                                {
                                    if (status != ApplicationStatus.Approved || allRequiredDocumentsApproved)
                                    {
                                        <option value="@status">@status.DisplayName()</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="Notes" class="form-label">Not</label>
                            <textarea id="Notes" name="Notes" class="form-control" rows="4" maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Durumu güncelle</button>
                        @if (transitions.Contains(ApplicationStatus.Approved) && !allRequiredDocumentsApproved)
                        {
                            <p class="small text-warning mt-2 mb-0">Tüm zorunlu güncel belgeler onaylanmadan başvuru onaylanamaz.</p>
                        }
                    </form>
                }
            </div>
        </section>
    </div>
</div>
