@model InstitutePageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Institutes.Title");
}

<header class="page-heading">
    <div>
        <span class="eyebrow">@UiText.Get(Context, "Admin.Catalog.Eyebrow")</span>
        <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Institutes.Heading")</h1>
        <p class="page-heading__description">@UiText.Get(Context, "Admin.Institutes.Lead")</p>
    </div>
    <div class="page-heading__actions admin-tab-links">
        <a asp-action="Institutes" class="btn btn-outline-primary" aria-current="page">@UiText.Get(Context, "Admin.Catalog.Institutes")</a>
        <a asp-action="Programs" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Programs")</a>
        <a asp-action="Universities" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Universities")</a>
    </div>
</header>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<div class="alert alert-info" role="note">
    @UiText.Get(Context, "Admin.Institutes.Note")
</div>

<form method="get" class="admin-filter-panel mb-4" aria-labelledby="institute-filter-heading">
    <h2 id="institute-filter-heading" class="admin-filter-panel__heading">@UiText.Get(Context, "Admin.Institutes.FilterHeading")</h2>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
            <label asp-for="Search" class="form-label">@UiText.Get(Context, "Admin.Institutes.Name")</label>
            <input asp-for="Search" class="form-control" placeholder="@UiText.Get(Context, "Admin.Institutes.SearchPlaceholder")" />
        </div>
        <div class="col-12 col-md-3">
            <label asp-for="IsActive" class="form-label">@UiText.Get(Context, "Admin.Common.Status")</label>
            <select asp-for="IsActive" class="form-select">
                <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                <option value="true">@UiText.Get(Context, "Admin.Common.Active")</option>
                <option value="false">@UiText.Get(Context, "Admin.Common.Inactive")</option>
            </select>
        </div>
        <div class="col-12 col-md-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Common.Filter")</button>
            <a asp-action="Institutes" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Clear")</a>
        </div>
    </div>
</form>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty-state">
                <h2>@UiText.Get(Context, "Admin.Institutes.EmptyHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Institutes.EmptyLead")</p>
            </div>
        }
        else
        {
        <div class="table-shell">
            <div class="table-responsive">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">@UiText.Get(Context, "Admin.Institutes.Caption")</caption>
                <thead>
                    <tr><th scope="col">@UiText.Get(Context, "Admin.Institutes.Institute")</th><th scope="col">@UiText.Get(Context, "Admin.Institutes.Program")</th><th scope="col">@UiText.Get(Context, "Admin.Common.Status")</th><th scope="col" class="text-end">@UiText.Get(Context, "Admin.Common.Actions")</th></tr>
                </thead>
                <tbody>
                    @foreach (var institute in Model.Result.Items)
                    {
                        <tr>
                            <td data-label="@UiText.Get(Context, "Admin.Institutes.Institute")">@institute.InstituteName</td>
                            <td data-label="@UiText.Get(Context, "Admin.Institutes.Program")">@institute.ProgramCount</td>
                            <td data-label="@UiText.Get(Context, "Admin.Common.Status")"><span class="admin-state @(institute.IsActive ? "admin-state--success" : null)">@(institute.IsActive ? UiText.Get(Context, "Admin.Common.Active") : UiText.Get(Context, "Admin.Common.Inactive"))</span></td>
                            <td data-label="">
                                <div class="admin-action-stack">
                                    <a asp-action="Institutes" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-page="@Model.Result.Page" asp-route-pageSize="@Model.Result.PageSize" asp-route-editId="@institute.InstituteId" class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Common.Edit")</a>
                                    @if (institute.IsActive)
                                    {
                                        <form asp-action="DeactivateInstitute" method="post" data-disable-on-submit="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@institute.InstituteId" />
                                            <input type="hidden" name="rowVersion" value="@institute.RowVersion" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">@UiText.Get(Context, "Admin.Institutes.Deactivate")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivateInstitute" method="post" data-disable-on-submit="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@institute.InstituteId" />
                                            <input type="hidden" name="rowVersion" value="@institute.RowVersion" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">@UiText.Get(Context, "Admin.Institutes.Activate")</button>
                                        </form>
                                    }
                                    <a asp-action="DeleteInstitute" asp-route-id="@institute.InstituteId" class="btn btn-sm btn-outline-danger">@UiText.Get(Context, "Admin.Institutes.DeleteDetails")</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <nav aria-label="@UiText.Get(Context, "Admin.Institutes.Pagination")">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Institutes" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.Result.Page - 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Common.Previous")</a></li>
                    <li class="page-item disabled"><span class="page-link">@Model.Result.Page / @Model.Result.TotalPages</span></li>
                    <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Institutes" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-page="@(Model.Result.Page + 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Common.Next")</a></li>
                </ul>
            </nav>
        }
    </div>

    <div class="col-12 col-xl-4">
        <section class="admin-section">
                <h2 class="h4">@(Model.Form.InstituteId > 0 ? UiText.Get(Context, "Admin.Institutes.EditHeading") : UiText.Get(Context, "Admin.Institutes.NewHeading"))</h2>
                <form asp-action="SaveInstitute" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <input asp-for="Form.InstituteId" type="hidden" />
                    @if (Model.Form.InstituteId > 0)
                    {
                        <input asp-for="Form.RowVersion" type="hidden" />
                    }
                    <div class="mb-3">
                        <label asp-for="Form.InstituteName" class="form-label">@UiText.Get(Context, "Admin.Institutes.Name")</label>
                        <input asp-for="Form.InstituteName" class="form-control" maxlength="100" autocomplete="off" />
                        <span asp-validation-for="Form.InstituteName" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">@(Model.Form.InstituteId > 0 ? UiText.Get(Context, "Admin.Common.SaveChanges") : UiText.Get(Context, "Admin.Institutes.Create"))</button>
                        @if (Model.Form.InstituteId > 0)
                        {
                            <a asp-action="Institutes" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Cancel")</a>
                        }
                    </div>
                </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
