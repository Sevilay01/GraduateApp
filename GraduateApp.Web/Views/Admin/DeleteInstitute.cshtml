@model InstituteAdminViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.DeleteInstitute.Title");
}

<div class="danger-zone mx-auto" style="max-width: 42rem;">
    <div class="card-body">
        <h1 class="h3">@UiText.Get(Context, "Admin.DeleteInstitute.Heading")</h1>
        <p><strong>@Model.InstituteName</strong> @UiText.Get(Context, "Admin.DeleteInstitute.IntroSuffix")</p>
        @if (Model.ProgramCount > 0)
        {
            <div class="alert alert-warning" role="alert">
                @UiText.Format(Context, "Admin.DeleteInstitute.LinkedPrograms", Model.ProgramCount)
            </div>
        }
        else
        {
            <div class="alert alert-danger" role="alert">@UiText.Get(Context, "Admin.DeleteInstitute.Irreversible")</div>
        }
        <form asp-action="ConfirmDeleteInstitute" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.InstituteId" />
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button class="btn btn-danger" type="submit" disabled="@(Model.ProgramCount > 0)">@UiText.Get(Context, "Admin.Delete.Permanent")</button>
            <a asp-action="Institutes" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Cancel")</a>
        </form>
    </div>
</div>
