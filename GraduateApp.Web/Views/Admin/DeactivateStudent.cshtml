@model AdminStudentDetailViewModel
@{
    ViewData["Title"] = "Öğrenciyi pasifleştir";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <section class="card border-danger" aria-labelledby="confirmation-heading">
            <div class="card-body">
                <h1 id="confirmation-heading" class="h3 text-danger">Öğrenciyi pasifleştirmeyi onaylayın</h1>
                <p>
                    <strong>@Model.FullName</strong> (@Model.MaskedTc) öğrencisinin hesabı pasifleştirilecek.
                    Mevcut API tokenları ve Web oturumu güvenlik damgası yenilenerek geçersiz kılınacak.
                </p>
                <dl class="row">
                    <dt class="col-sm-4">E-posta</dt><dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Başvuru sayısı</dt><dd class="col-sm-8">@Model.ApplicationCount</dd>
                    <dt class="col-sm-4">Sınav sonucu sayısı</dt><dd class="col-sm-8">@Model.ExamScoreCount</dd>
                </dl>
                <div class="alert alert-warning" role="alert">
                    Bu işlem katalog verilerini veya öğrencinin geçmiş başvuru kayıtlarını silmez.
                </div>
                <form asp-action="ConfirmDeactivateStudent" method="post">
                    <input type="hidden" name="publicId" value="@Model.PublicId" />
                    <button type="submit" class="btn btn-danger">Evet, öğrenciyi pasifleştir</button>
                    <a asp-action="Students" class="btn btn-outline-secondary">Vazgeç</a>
                </form>
            </div>
        </section>
    </div>
</div>
