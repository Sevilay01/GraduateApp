@model AdminStudentListViewModel
@{
    ViewData["Title"] = "Öğrenci yönetimi";
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">Hesap yönetimi</span>
            <h1 class="page-heading__title">Öğrenciler</h1>
            <p class="page-heading__description">Maskelenmiş kimlik bilgileriyle öğrenci hesaplarını bulun ve erişim durumunu güvenli onay ekranlarından yönetin.</p>
        </div>
        <div class="page-heading__actions">
            <a asp-action="Accounts" class="btn btn-outline-primary">Yöneticiler</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }

    <form method="get" class="admin-filter-panel" role="search" aria-labelledby="student-filter-heading">
        <h2 id="student-filter-heading" class="admin-filter-panel__heading">Öğrenci ara</h2>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-8">
                <label for="student-search" class="form-label">Ad, soyad veya e-posta</label>
                <input id="student-search" name="search" value="@Model.Search" class="form-control" autocomplete="off" />
            </div>
            <div class="col-12 col-md-4 admin-form-actions">
                <button type="submit" class="btn btn-primary">Ara</button>
                <a asp-action="Students" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="active-filters" aria-label="Aktif filtreler">
                <span class="active-filters__label">Aktif filtre</span>
                <span class="filter-chip">Arama: @Model.Search</span>
            </div>
        }
    </form>

    <section aria-labelledby="student-results-heading">
        <div class="admin-results-heading mb-3">
            <div>
                <h2 id="student-results-heading">Öğrenci hesapları</h2>
                <p class="admin-results-count" role="status">@Model.Result.TotalCount öğrenci bulundu</p>
            </div>
        </div>
        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty-state">
                <h3>Öğrenci bulunamadı</h3>
                <p>Arama ifadesini değiştirin veya tüm öğrencileri görmek için filtreyi temizleyin.</p>
            </div>
        }
        else
        {
            <div class="table-shell">
                <div class="table-responsive">
                    <table class="table table-hover align-middle responsive-table">
                        <caption class="visually-hidden">Filtrelenmiş öğrenci hesapları</caption>
                        <thead>
                            <tr>
                                <th scope="col">Öğrenci</th>
                                <th scope="col">Maskelenmiş TC</th>
                                <th scope="col">E-posta</th>
                                <th scope="col">Durum</th>
                                <th scope="col"><span class="visually-hidden">İşlem</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Result.Items)
                            {
                                <tr>
                                    <td data-label="Öğrenci">@student.FullName</td>
                                    <td data-label="Maskelenmiş TC">@student.MaskedTc</td>
                                    <td data-label="E-posta">@student.Email</td>
                                    <td data-label="Durum">
                                        <span class="admin-state @(student.IsActive ? "admin-state--success" : null)">@(student.IsActive ? "Aktif" : "Pasif")</span>
                                    </td>
                                    <td data-label="">
                                        @if (student.IsActive)
                                        {
                                            <a asp-action="DeactivateStudent" asp-route-publicId="@student.PublicId" class="btn btn-sm btn-outline-danger">Öğrenci hesabını pasifleştir</a>
                                        }
                                        else
                                        {
                                            <a asp-action="ActivateStudent" asp-route-publicId="@student.PublicId" class="btn btn-sm btn-outline-success">Öğrenci hesabını aktifleştir</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    @if (Model.Result.TotalPages > 1)
    {
        <nav aria-label="Öğrenci listesi sayfaları">
            <ul class="pagination justify-content-center">
                @for (var pageNumber = 1; pageNumber <= Model.Result.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Result.Page ? "active" : null)">
                        <a class="page-link" aria-current="@(pageNumber == Model.Result.Page ? "page" : null)" asp-action="Students" asp-route-search="@Model.Search" asp-route-page="@pageNumber" asp-route-pageSize="@Model.Result.PageSize">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
