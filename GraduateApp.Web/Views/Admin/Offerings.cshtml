@model ProgramOfferingListPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Offerings.Title");
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Title")</span>
            <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Offerings.Heading")</h1>
            <p class="page-heading__description">@UiText.Get(Context, "Admin.Offerings.Lead")</p>
        </div>
        <div class="page-heading__actions">
            <a asp-action="EditOffering" class="btn btn-primary">@UiText.Get(Context, "Admin.Offerings.New")</a>
            <a asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.Back")</a>
        </div>
    </header>

    <form method="get" class="admin-filter-panel" role="search" aria-labelledby="offering-filter-heading">
        <h2 id="offering-filter-heading" class="admin-filter-panel__heading">@UiText.Get(Context, "Admin.Offerings.FilterHeading")</h2>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-4">
                <label asp-for="AcademicYearStart" class="form-label">@UiText.Get(Context, "Admin.Offerings.YearStart")</label>
                <input asp-for="AcademicYearStart" class="form-control" min="2000" max="2200" />
            </div>
            <div class="col-12 col-sm-4">
                <label asp-for="Term" class="form-label">@UiText.Get(Context, "Admin.Offerings.Term")</label>
                <select asp-for="Term" class="form-select">
                    <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                    @foreach (var term in Enum.GetValues<AcademicTerm>().Where(item => item != AcademicTerm.LegacyUnspecified))
                    {
                        <option value="@term">@UiText.Get(Context, $"AcademicTerm.{term}")</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-4">
                <div class="form-check mb-2">
                    <input asp-for="IncludeArchived" class="form-check-input" />
                    <label asp-for="IncludeArchived" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.IncludeArchived")</label>
                </div>
            </div>
            <div class="col-12 admin-form-actions">
                <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Admin.Common.Filter")</button>
                <a asp-action="Offerings" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Clear")</a>
            </div>
        </div>
    </form>

    <section aria-labelledby="offering-list-heading">
        <div class="admin-results-heading mb-3">
            <div>
                <h2 id="offering-list-heading">@UiText.Get(Context, "Admin.Offerings.ListHeading")</h2>
                <p class="admin-results-count" role="status">@UiText.Format(Context, "Admin.Offerings.Showing", Model.Offerings.Count)</p>
            </div>
        </div>
        @if (Model.ErrorMessage is not null)
        {
            <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
        }
        else if (Model.Offerings.Count == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Offerings.EmptyHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.EmptyLead")</p>
            </div>
        }
        else
        {
            <div class="admin-card-list">
                @foreach (var offering in Model.Offerings)
                {
                    var stateKey = offering.IsArchived
                        ? "Admin.Offerings.State.Archived"
                        : offering.IsOpen ? "Admin.Offerings.State.Open" : "Admin.Offerings.State.Closed";
                    <article class="admin-item-card">
                        <header>
                            <div>
                                <span class="eyebrow">@UiText.Format(Context, "Admin.Offerings.OfferingNumber", offering.ProgramOfferingId)</span>
                                <h3>@UiText.SelectLocalized(Context, offering.ProgramName, offering.ProgramNameEnglish)</h3>
                                <p class="text-muted mb-0">
                                    @UiText.LocalizeDegreeType(Context, offering.DegreeType) · @offering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, offering.TermName)
                                </p>
                            </div>
                            <span class="admin-state @(offering.IsOpen ? "admin-state--success" : offering.IsArchived ? "admin-state--warning" : null)">@UiText.Get(Context, stateKey)</span>
                        </header>
                        <dl class="meta-grid">
                            <div><dt>@UiText.Get(Context, "Admin.Offerings.Quota")</dt><dd>@offering.Quota</dd></div>
                            <div><dt>@UiText.Get(Context, "Admin.Offerings.DocumentRequirements")</dt><dd>@offering.DocumentRequirementCount</dd></div>
                            <div><dt>@UiText.Get(Context, "Admin.OfferingNav.Applications")</dt><dd>@offering.SubmittedOrLaterApplicationCount</dd></div>
                        </dl>
                        <div class="admin-item-card__actions">
                            <a asp-action="OfferingOverview" asp-route-id="@offering.ProgramOfferingId" class="btn btn-sm btn-primary">@UiText.Get(Context, "Admin.OfferingNav.Open")</a>
                            <a asp-action="EditOffering" asp-route-id="@offering.ProgramOfferingId" class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Common.Edit")</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>
