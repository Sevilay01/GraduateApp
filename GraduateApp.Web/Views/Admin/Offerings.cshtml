@model ProgramOfferingPageViewModel
@{
    ViewData["Title"] = "İlanlar ve değerlendirme";
    var formOffering = Model.Offerings.SingleOrDefault(item => item.ProgramOfferingId == Model.Form.ProgramOfferingId);
    var selectedRequirementOffering = Model.RequirementOfferingId.HasValue
        ? Model.Offerings.SingleOrDefault(item => item.ProgramOfferingId == Model.RequirementOfferingId.Value)
        : null;
    var selectedOfferingRequirements = selectedRequirementOffering is not null
        && Model.DocumentRequirements.TryGetValue(selectedRequirementOffering.ProgramOfferingId, out var requirements)
        ? requirements
        : (IReadOnlyList<OfferingDocumentRequirementViewModel>)[];
    var formOfferingHasActiveRequiredRequirement =
        formOffering?.HasActiveRequiredDocumentRequirement ?? false;
    var hasActiveFilters = Model.AcademicYearStart.HasValue || Model.Term.HasValue || Model.IncludeArchived;
    var legacyOfferingCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.LegacyOutsideDocumentWorkflow);
    var healthyOpenOfferingCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenHealthy);
    var invalidWithoutApplicationsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidNoApplications);
    var invalidWithDraftsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts);
    var invalidWithSubmittedApplicationsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidWithSubmittedApplications);
    var invalidOpenOfferings = Model.Offerings.Where(item =>
        item.DocumentConfigurationHealth is
            OfferingDocumentConfigurationHealth.OpenInvalidNoApplications
            or OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts
            or OfferingDocumentConfigurationHealth.OpenInvalidWithSubmittedApplications).ToArray();
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">İlanlar ve değerlendirme</span>
            <h1 class="page-heading__title">Dönemsel program ilanları</h1>
            <p class="page-heading__description">İlan tarihlerini, kontenjanı, belge ve sınav koşullarını mevcut güvenlik ve eşzamanlılık sözleşmeleriyle yönetin.</p>
        </div>
        <div class="page-heading__actions">
            <a asp-action="Offerings"
               asp-route-academicYearStart="@Model.AcademicYearStart"
               asp-route-term="@Model.Term"
               asp-route-includeArchived="@Model.IncludeArchived"
               asp-fragment="offering-form"
               class="btn btn-primary">Yeni ilan oluştur</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Başvurulara dön</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>İlan verileri yüklenemedi.</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="get" class="admin-filter-panel" aria-labelledby="offering-filters-heading">
        <h2 id="offering-filters-heading" class="admin-filter-panel__heading">İlanları filtrele</h2>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="AcademicYearStart" class="form-label">Akademik yıl başlangıcı</label>
                <input asp-for="AcademicYearStart" class="form-control" min="2000" max="2200" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="Term" class="form-label">Dönem</label>
                <select asp-for="Term" class="form-select" asp-items="Html.GetEnumSelectList<AcademicTerm>()">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-12 col-lg-3">
                <div class="form-check">
                    <input asp-for="IncludeArchived" class="form-check-input" />
                    <label asp-for="IncludeArchived" class="form-check-label">Arşivlenen ilanları göster</label>
                </div>
            </div>
            <div class="col-12 col-lg-3 admin-form-actions">
                <button class="btn btn-primary" type="submit">Filtreleri uygula</button>
                <a asp-action="Offerings" class="btn btn-outline-secondary">Temizle</a>
            </div>
        </div>
        @if (hasActiveFilters)
        {
            <div class="active-filters" aria-label="Aktif filtreler">
                <span class="active-filters__label">Aktif filtreler</span>
                @if (Model.AcademicYearStart.HasValue)
                {
                    <span class="filter-chip">Yıl: @Model.AcademicYearStart</span>
                }
                @if (Model.Term.HasValue)
                {
                    <span class="filter-chip">Dönem: @Model.Term.Value.DisplayName()</span>
                }
                @if (Model.IncludeArchived)
                {
                    <span class="filter-chip">Arşivlenenler dahil</span>
                }
            </div>
        }
    </form>

    <section id="offering-configuration-health"
             class="admin-section"
             aria-labelledby="offering-configuration-health-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="offering-configuration-health-heading">İlan yapılandırma sağlığı</h2>
                <p>Salt-okunur özet, açık ilanların aktif ve zorunlu belge koşulu ile mevcut başvuru riskini gösterir.</p>
            </div>
        </div>

        <div class="admin-summary-grid" data-offering-health-summary>
            <article class="admin-summary-card" data-health-category="A">
                <span class="eyebrow">A · Legacy</span>
                <h3>@legacyOfferingCount ilan</h3>
                <p>Belge iş akışı dışında kalan legacy ilanlar. Mevcut davranışları değiştirilmez.</p>
            </article>
            <article class="admin-summary-card" data-health-category="B">
                <span class="eyebrow">B · Sağlıklı</span>
                <h3>@healthyOpenOfferingCount ilan</h3>
                <p>Açık ve en az bir aktif zorunlu belge koşulu bulunan ilanlar.</p>
            </article>
            <article class="admin-summary-card" data-health-category="C">
                <span class="eyebrow">C · Başvuru yok</span>
                <h3>@invalidWithoutApplicationsCount ilan</h3>
                <p>Açık, belge akışı etkin, aktif zorunlu koşulu ve başvurusu olmayan ilanlar.</p>
            </article>
            <article class="admin-summary-card" data-health-category="D">
                <span class="eyebrow">D · Taslak var</span>
                <h3>@invalidWithDraftsCount ilan</h3>
                <p>Aktif zorunlu koşulu bulunmayan ve mevcut taslakları olan açık ilanlar.</p>
            </article>
            <article class="admin-summary-card" data-health-category="E">
                <span class="eyebrow">E · İleri başvuru var</span>
                <h3>@invalidWithSubmittedApplicationsCount ilan</h3>
                <p>Aktif zorunlu koşulu bulunmayan ve gönderilmiş veya daha ileri başvuruları olan açık ilanlar.</p>
            </article>
        </div>

        @if (invalidOpenOfferings.Length == 0)
        {
            <div class="alert alert-success mt-4" role="status" data-offering-health-clear>
                Filtrelenen ilanlarda açık ve eksik belge yapılandırmasına sahip workflow ilanı bulunmuyor.
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-4" role="alert">
                <strong>@invalidOpenOfferings.Length açık ilanda yapılandırma riski bulundu.</strong>
                Bu ilanlar yeni öğrenci program listesinde gösterilmez. Otomatik veri düzeltmesi yapılmaz.
            </div>
            <div class="admin-card-list mt-4">
                @foreach (var offering in invalidOpenOfferings)
                {
                    var healthGroup = offering.DocumentConfigurationHealth switch
                    {
                        OfferingDocumentConfigurationHealth.OpenInvalidNoApplications => "C",
                        OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts => "D",
                        _ => "E"
                    };
                    <article class="admin-item-card"
                             data-offering-health-risk
                             data-health-category="@healthGroup">
                        <header>
                            <div>
                                <span class="eyebrow">@healthGroup grubu · İlan #@offering.ProgramOfferingId</span>
                                <h3>@offering.ProgramName</h3>
                                <p class="text-muted mb-0">
                                    @offering.InstituteName · @offering.DegreeType · @offering.AcademicYear · @offering.TermName
                                </p>
                            </div>
                            <span class="admin-state admin-state--danger">Açık · Eksik koşul</span>
                        </header>

                        <dl class="meta-grid">
                            <div class="meta-item">
                                <dt>Aktif zorunlu koşul</dt>
                                <dd>@offering.ActiveRequiredDocumentRequirementCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>Toplam belge koşulu</dt>
                                <dd>@offering.DocumentRequirementCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>Taslak</dt>
                                <dd>@offering.DraftApplicationCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>Gönderilmiş ve ileri</dt>
                                <dd>@offering.SubmittedOrLaterApplicationCount</dd>
                            </div>
                        </dl>

                        @if (offering.DraftApplicationCount + offering.SubmittedOrLaterApplicationCount > 0)
                        {
                            <div class="alert alert-danger" role="alert" data-existing-application-snapshot-warning>
                                Bu ilana daha önce oluşturulmuş taslak veya gönderilmiş başvurular bulunmaktadır.
                                Yeni belge koşulları mevcut başvuru snapshot’larını değiştirmez.
                                Mevcut başvurular için enstitü kararı verilmeden otomatik veri değişikliği yapılmamalıdır.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning" role="note">
                                İlan öğrenciye gösterilmez ve doğrudan taslak oluşturma API tarafından reddedilir.
                            </div>
                        }

                        <ol class="configuration-steps">
                            <li>İlanı yeni başvurulara kapatın.</li>
                            <li>İlgili enstitünün güncel dönem ve program kılavuzunu doğrulayın.</li>
                            <li>Belge koşullarını mevcut güvenli admin akışından ekleyin.</li>
                            <li>En az bir aktif ve zorunlu koşul bulunduğunu doğrulayın.</li>
                            <li>İlanı güncel RowVersion ve API invariant kontrolleriyle yeniden açın.</li>
                        </ol>

                        <div class="admin-item-card__actions">
                            <a asp-action="Offerings"
                               asp-route-editId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="offering-readiness-heading"
                               class="btn btn-sm btn-outline-danger">İlanı kapat</a>
                            <a asp-action="Offerings"
                               asp-route-requirementOfferingId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="document-requirements"
                               class="btn btn-sm btn-primary">Belge koşullarını yapılandır</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section aria-labelledby="offering-list-heading">
        <div class="admin-results-heading mb-3">
            <div>
                <h2 id="offering-list-heading">İlanlar</h2>
                <p class="admin-results-count" role="status">@Model.Offerings.Count ilan gösteriliyor</p>
            </div>
        </div>
        @if (Model.Offerings.Count == 0)
        {
            <div class="empty-state">
                <h3>İlan bulunamadı</h3>
                <p>Filtreleri değiştirin veya sağlanan formdan yeni ve kapalı bir ilan oluşturun.</p>
            </div>
        }
        else
        {
            <div class="admin-card-list">
                @foreach (var offering in Model.Offerings)
                {
                    var catalogProgram = Model.Form.Programs.SingleOrDefault(item => item.ProgramId == offering.ProgramId);
                    var stateClass = offering.IsArchived
                        ? "admin-state--danger"
                        : offering.IsOpen
                            ? "admin-state--success"
                            : "admin-state--warning";
                    var stateName = offering.IsArchived ? "Arşivli" : offering.IsOpen ? "Açık" : "Kapalı";

                    <article class="admin-item-card" data-offering-card>
                        <header>
                            <div>
                                <span class="eyebrow">@(string.IsNullOrWhiteSpace(offering.InstituteName) ? catalogProgram?.InstituteName : offering.InstituteName)</span>
                                <h3>@offering.ProgramName</h3>
                                <p class="text-muted mb-0">@offering.AcademicYear · @offering.TermName</p>
                            </div>
                            <span class="admin-state @stateClass">@stateName</span>
                        </header>

                        <dl class="meta-grid">
                            <div class="meta-item">
                                <dt>Başvuru başlangıcı</dt>
                                <dd>
                                    @if (offering.ApplicationStartUtc.HasValue)
                                    {
                                        <time datetime="@offering.ApplicationStartUtc.Value.ToString("O")">@IstanbulTime.FromUtc(offering.ApplicationStartUtc.Value).ToString("dd.MM.yyyy HH:mm")</time>
                                    }
                                    else
                                    {
                                        <span>Belirtilmemiş</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item">
                                <dt>Son başvuru</dt>
                                <dd>
                                    @if (offering.ApplicationDeadlineUtc.HasValue)
                                    {
                                        <time datetime="@offering.ApplicationDeadlineUtc.Value.ToString("O")">@IstanbulTime.FromUtc(offering.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm")</time>
                                    }
                                    else
                                    {
                                        <span>Belirtilmemiş</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item"><dt>Kontenjan</dt><dd>@offering.Quota</dd></div>
                            <div class="meta-item">
                                <dt>Belge akışı</dt>
                                <dd>
                                    @if (!offering.UsesDocumentWorkflow)
                                    {
                                        <span>Legacy akış · kapsam dışı</span>
                                    }
                                    else
                                    {
                                        <span>@(offering.HasActiveRequiredDocumentRequirement ? "Hazır" : "Eksik") · @offering.DocumentRequirementCount koşul</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item"><dt>Değerlendirme akışı</dt><dd>@(offering.UsesEvaluationWorkflow ? offering.EvaluationState.DisplayName() : "Kullanılmıyor")</dd></div>
                            <div class="meta-item"><dt>Sınav koşulları</dt><dd>@offering.ExamRequirements.Count koşul</dd></div>
                        </dl>

                        <div class="admin-summary-card">
                            <h4>İlanı açma önkoşulları</h4>
                            <ul class="readiness-list">
                                <li class="@(offering.HasActiveRequiredDocumentRequirement ? "is-ready" : "is-blocked")">
                                    <strong>Zorunlu belge koşulu:</strong>
                                    @(offering.HasActiveRequiredDocumentRequirement ? "En az bir aktif zorunlu koşul var." : "İlan açılmadan önce en az bir zorunlu belge koşulu tanımlayın.")
                                </li>
                                @if (offering.UsesEvaluationWorkflow)
                                {
                                    <li>
                                        <strong>Kriter politikası:</strong> Toplam ağırlık 10.000 bp olmalı ve her sınav puanı kriteri bağlı aktif zorunlu sınav koşuluna sahip olmalıdır.
                                    </li>
                                }
                                else
                                {
                                    <li class="is-ready"><strong>Değerlendirme politikası:</strong> Bu ilan sıralamalı değerlendirme akışını kullanmıyor.</li>
                                }
                            </ul>
                        </div>

                        <div class="admin-item-card__actions">
                            <a asp-action="Offerings"
                               asp-route-editId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="offering-form"
                               class="btn btn-sm btn-primary">Genel bilgileri düzenle</a>
                            <a asp-action="Offerings"
                               asp-route-requirementOfferingId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="document-requirements"
                               class="btn btn-sm btn-outline-primary">Belge koşulları</a>
                            <a asp-action="Offerings"
                               asp-route-editId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="exam-requirements-heading"
                               class="btn btn-sm btn-outline-primary">Sınav koşulları</a>
                            @if (offering.UsesEvaluationWorkflow)
                            {
                                <a asp-action="Evaluation" asp-route-id="@offering.ProgramOfferingId" class="btn btn-sm btn-outline-secondary">Değerlendirme</a>
                            }
                            <a asp-action="Offerings"
                               asp-route-editId="@offering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="offering-readiness-heading"
                               class="btn btn-sm btn-outline-secondary">İlanı açma kontrolü</a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section id="offering-form" class="admin-section" aria-labelledby="offering-form-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="offering-form-heading"
                    tabindex="-1"
                    data-fragment-focus
                    data-auto-focus="@(Model.AutoFocusTarget == "offering-form-heading" ? "true" : "false")">
                    @(Model.Form.ProgramOfferingId > 0 ? "İlanı düzenle" : "Yeni ilan oluştur")
                </h2>
                <p>Yeni ilan güvenli başlangıç davranışı olarak önce kapalı oluşturulur.</p>
            </div>
        </div>
        @if (formOffering is not null)
        {
            <div class="alert alert-info" role="status" data-selected-offering-context>
                <strong>Düzenlenen ilan:</strong>
                @formOffering.ProgramName · @formOffering.AcademicYear · @formOffering.TermName · İlan #@formOffering.ProgramOfferingId
            </div>
            <nav class="admin-summary-card mb-4" aria-label="İlan yapılandırma adımları">
                <h3 class="h5">İlan yapılandırması</h3>
                <ol class="configuration-steps">
                    <li><a href="#offering-general-heading">Genel bilgiler</a></li>
                    <li>
                        <a asp-action="Offerings"
                           asp-route-requirementOfferingId="@formOffering.ProgramOfferingId"
                           asp-route-academicYearStart="@Model.AcademicYearStart"
                           asp-route-term="@Model.Term"
                           asp-route-includeArchived="@Model.IncludeArchived"
                           asp-fragment="document-requirements">Belge koşulları</a>
                    </li>
                    <li><a href="#exam-requirements-heading">Sınav koşulları</a></li>
                    <li>
                        @if (formOffering.UsesEvaluationWorkflow)
                        {
                            <a asp-action="Evaluation" asp-route-id="@formOffering.ProgramOfferingId">Değerlendirme kriterleri</a>
                        }
                        else
                        {
                            <span>Değerlendirme kullanılmıyor</span>
                        }
                    </li>
                    <li><a href="#offering-readiness-heading">Gözden geçir ve aç</a></li>
                </ol>
            </nav>
        }
        <form asp-action="SaveOffering" method="post" novalidate data-disable-on-submit="true">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <input asp-for="Form.ProgramOfferingId" type="hidden" />
            <input asp-for="Form.RowVersion" type="hidden" />

            <section aria-labelledby="offering-general-heading">
                <h3 id="offering-general-heading" class="h5" tabindex="-1" data-fragment-focus>Genel bilgiler</h3>
                <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label asp-for="Form.ProgramId" class="form-label"></label>
                    <select asp-for="Form.ProgramId" class="form-select">
                        @foreach (var program in Model.Form.Programs)
                        {
                            <option value="@program.ProgramId">@program.InstituteName · @program.ProgramName · @program.DegreeType</option>
                        }
                    </select>
                    <span asp-validation-for="Form.ProgramId" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Form.AcademicYearStart" class="form-label"></label>
                    <input asp-for="Form.AcademicYearStart" class="form-control" type="number" min="2000" max="2200" />
                    <span asp-validation-for="Form.AcademicYearStart" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Form.Term" class="form-label"></label>
                    <select asp-for="Form.Term" class="form-select">
                        @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                        {
                            <option value="@((int)term)">@term.DisplayName()</option>
                        }
                    </select>
                    <span asp-validation-for="Form.Term" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Form.ApplicationStartLocal" class="form-label"></label>
                    <input asp-for="Form.ApplicationStartLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Form.ApplicationStartLocal" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Form.ApplicationDeadlineLocal" class="form-label"></label>
                    <input asp-for="Form.ApplicationDeadlineLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Form.ApplicationDeadlineLocal" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Form.Quota" class="form-label"></label>
                    <input asp-for="Form.Quota" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Form.Quota" class="text-danger"></span>
                </div>
                <div class="col-12 col-lg-9">
                    <div class="form-check mt-2">
                        <input asp-for="Form.UsesEvaluationWorkflow" class="form-check-input" />
                        <label asp-for="Form.UsesEvaluationWorkflow" class="form-check-label"></label>
                    </div>
                    <div class="form-text">Etkinleştirildikten sonra kapatılamaz; mevcut ilan yalnızca hiç başvurusu yoksa bu akışa geçirilebilir.</div>
                </div>
                </div>
            </section>

            <fieldset class="mt-4" aria-labelledby="exam-requirements-heading">
                <legend id="exam-requirements-heading" class="h3 fs-5" tabindex="-1" data-fragment-focus>Sınav koşulları</legend>
                <p class="text-muted">Yalnızca seçili sınavlar ilan koşulu olarak gönderilir. Zorunlu sınavlar ExamScore kriterlerine bağlanabilir.</p>
                <div class="admin-summary-grid">
                    @for (var index = 0; index < Model.Form.Exams.Count; index++)
                    {
                        var exam = Model.Form.Exams[index];
                        <div class="admin-summary-card">
                            <input asp-for="Form.ExamRequirements[index].ExamId" value="@exam.ExamId" type="hidden" />
                            <h3>@exam.ExamName</h3>
                            <div class="form-check">
                                <input asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-input" />
                                <label asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-label">Koşulu kullan</label>
                            </div>
                            <div class="form-check mt-2">
                                <input asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-input" />
                                <label asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-label">Zorunlu sınav</label>
                            </div>
                            <label asp-for="Form.ExamRequirements[index].MinimumScore" class="form-label mt-3">Minimum puan</label>
                            <input asp-for="Form.ExamRequirements[index].MinimumScore" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Form.ExamRequirements[index].MinimumScore" class="text-danger"></span>
                            <label asp-for="Form.ExamRequirements[index].MinimumValidityDate" class="form-label mt-3">Minimum geçerlilik tarihi</label>
                            <input asp-for="Form.ExamRequirements[index].MinimumValidityDate" class="form-control" type="date" />
                        </div>
                    }
                </div>
            </fieldset>

            <section class="mt-4" aria-labelledby="offering-readiness-heading">
                <h3 id="offering-readiness-heading" class="h5" tabindex="-1" data-fragment-focus>Gözden geçir ve aç</h3>
                @if (Model.Form.ProgramOfferingId == 0)
                {
                    <div class="alert alert-info" data-new-offering-closed>
                        <strong>Yeni ilan önce kapalı oluşturulur.</strong>
                        <div class="form-check">
                            <input asp-for="Form.IsOpen" class="form-check-input" disabled />
                            <label asp-for="Form.IsOpen" class="form-check-label">Yeni ilan kapalı oluşturulacak</label>
                        </div>
                        <p class="mb-0 mt-2">En az bir aktif zorunlu belge koşulu tanımladıktan ve değerlendirme önkoşullarını tamamladıktan sonra ilanı düzenleyerek açabilirsiniz.</p>
                    </div>
                }
                else
                {
                    <div class="form-check">
                        <input asp-for="Form.IsOpen" class="form-check-input" disabled="@(!formOfferingHasActiveRequiredRequirement)" />
                        <label asp-for="Form.IsOpen" class="form-check-label"></label>
                    </div>
                    @if (!formOfferingHasActiveRequiredRequirement)
                    {
                        <p class="text-warning mt-2">İlan açılmadan önce en az bir zorunlu belge koşulu tanımlayın.</p>
                    }
                    <div class="danger-zone">
                        <h4 class="h5">Arşivleme alanı</h4>
                        <p>Arşivlenen ilan yeni işlemlerde gösterilmez; geçmiş başvuru ve audit kayıtları korunur.</p>
                        <div class="form-check">
                            <input asp-for="Form.IsArchived" class="form-check-input" />
                            <label asp-for="Form.IsArchived" class="form-check-label">İlanı arşivle</label>
                        </div>
                    </div>
                }
            </section>

            <div class="admin-form-actions mt-4">
                <button class="btn btn-primary" type="submit">@(Model.Form.ProgramOfferingId > 0 ? "İlan değişikliklerini kaydet" : "Kapalı ilanı oluştur")</button>
                @if (Model.Form.ProgramOfferingId > 0)
                {
                    <a asp-action="Offerings" class="btn btn-outline-secondary">Düzenlemeden vazgeç</a>
                }
            </div>
        </form>
    </section>

    <section id="document-requirements" class="admin-section" aria-labelledby="document-requirements-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="document-requirements-heading"
                    tabindex="-1"
                    data-fragment-focus
                    data-auto-focus="@(Model.AutoFocusTarget == "document-requirements-heading" ? "true" : "false")">
                    İlan belge koşulları
                </h2>
                <p>Mevcut taslak ve başvuruların snapshot koşulları değişmez. Koşul değişiklikleri yalnızca daha sonra oluşturulan taslakları etkiler.</p>
            </div>
        </div>
        <div class="alert alert-info" role="note">
            Belge koşulu değişiklikleri yalnızca yeni taslakları etkiler. Açık ilan için son aktif zorunlu koşulu pasifleştirme isteği API tarafından güvenli biçimde reddedilir.
        </div>
        <div class="admin-summary-card mb-4" data-document-guidance>
            <h3 class="h5">Kılavuz doğrulaması</h3>
            <p>Belge koşullarını, ilgili enstitünün güncel ilan kılavuzuna göre tanımlayın. Programlara özel ek belgeler bulunabilir.</p>
            <p class="mb-0">
                Evrak listesini bütün ilanlara kopyalamayın.
                <a href="https://sosyalbilimler.cu.edu.tr/storage/Belgeler/ilanlar/2026_2027_guz/cu_sosbil_2026_2027_guz_6_temmuz.pdf"
                   target="_blank"
                   rel="noopener noreferrer">Sosyal Bilimler Enstitüsü 2026–2027 Güz kılavuzu</a>
                ve
                <a href="https://iso.cu.edu.tr/haber-detay/84/2026-2027-guz-yariyili-lisansustu-programlara-uluslararasi-ogrenci-basvurulari"
                   target="_blank"
                   rel="noopener noreferrer">uluslararası öğrenci duyurusu</a>
                gibi başvuru türüne uygun resmî kaynağı kullanın.
            </p>
        </div>

        @if (selectedRequirementOffering is null)
        {
            <div class="empty-state">
                <h3>Belge koşulları için ilan seçin</h3>
                <p>Yalnızca yöneteceğiniz ilan kartındaki “Belge koşulları” eylemini kullanın. Tam koşul listesi seçilen ilan için yüklenir.</p>
            </div>
        }
        else
        {
            var activeRequiredCount = selectedOfferingRequirements.Count(item => item.IsActive && item.IsRequired);
            <article class="admin-item-card" data-selected-requirement-offering>
                <header>
                    <div>
                        <span class="eyebrow">Seçili ilan · #@selectedRequirementOffering.ProgramOfferingId</span>
                        <h3>@selectedRequirementOffering.ProgramName</h3>
                        <p class="text-muted mb-0">@selectedRequirementOffering.AcademicYear · @selectedRequirementOffering.TermName</p>
                    </div>
                    <span class="admin-state @(activeRequiredCount > 0 ? "admin-state--success" : "admin-state--danger")">@activeRequiredCount aktif zorunlu</span>
                </header>
                @if (selectedOfferingRequirements.Count == 0)
                {
                    <div class="empty-state">
                        <h4>Belge koşulu tanımlanmamış</h4>
                        <p>İlan açılmadan önce en az bir zorunlu belge koşulu tanımlayın.</p>
                    </div>
                }
                else
                {
                    <div class="table-shell">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle responsive-table">
                                <caption class="visually-hidden">@selectedRequirementOffering.ProgramName ilanının belge koşulları</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Koşul</th>
                                        <th scope="col">Açıklama</th>
                                        <th scope="col">Tür ve sınır</th>
                                        <th scope="col">Durum</th>
                                        <th scope="col">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var requirement in selectedOfferingRequirements)
                                    {
                                        var isLastActiveRequired = selectedRequirementOffering.IsOpen
                                            && requirement.IsActive
                                            && requirement.IsRequired
                                            && activeRequiredCount == 1;
                                        <tr>
                                            <td data-label="Koşul">
                                                <code>@requirement.DocumentCode</code>
                                                <div class="fw-semibold">@requirement.DisplayName</div>
                                                <small>@(requirement.IsRequired ? "Zorunlu" : "İsteğe bağlı")</small>
                                            </td>
                                            <td data-label="Açıklama">@(string.IsNullOrWhiteSpace(requirement.Description) ? "Açıklama yok" : requirement.Description)</td>
                                            <td data-label="Tür ve sınır">@requirement.AllowedContentCategory.CategoryName() · @DocumentPresentation.FileSize(requirement.MaximumBytes)</td>
                                            <td data-label="Durum">
                                                <span class="admin-state @(requirement.IsActive ? "admin-state--success" : null)">@(requirement.IsActive ? "Aktif" : "Pasif")</span>
                                                <small class="d-block mt-1">Eşzamanlılık korumalı</small>
                                            </td>
                                            <td data-label="">
                                                <div class="admin-action-stack">
                                                    <a asp-action="Offerings"
                                                       asp-route-requirementOfferingId="@selectedRequirementOffering.ProgramOfferingId"
                                                       asp-route-editRequirementId="@requirement.PublicId"
                                                       asp-route-academicYearStart="@Model.AcademicYearStart"
                                                       asp-route-term="@Model.Term"
                                                       asp-route-includeArchived="@Model.IncludeArchived"
                                                       asp-fragment="document-requirements"
                                                       class="btn btn-sm btn-outline-primary">Koşulu düzenle</a>
                                                    <form asp-action="SetDocumentRequirementActive" method="post" data-disable-on-submit="true">
                                                        <input type="hidden" name="programOfferingId" value="@selectedRequirementOffering.ProgramOfferingId" />
                                                        <input type="hidden" name="publicId" value="@requirement.PublicId" />
                                                        <input type="hidden" name="isActive" value="@((!requirement.IsActive).ToString().ToLowerInvariant())" />
                                                        <input type="hidden" name="rowVersion" value="@requirement.RowVersion" />
                                                        <button type="submit"
                                                                class="btn btn-sm @(requirement.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                                aria-label="@(requirement.IsActive ? "Pasifleştir" : "Aktifleştir") belge koşulu: @requirement.DisplayName">
                                                            @(requirement.IsActive ? "Koşulu pasifleştir" : "Koşulu aktifleştir")
                                                        </button>
                                                    </form>
                                                </div>
                                                @if (isLastActiveRequired)
                                                {
                                                    <small class="text-warning d-block mt-2">Açık ilandaki son aktif zorunlu koşul kaldırılamaz.</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </article>

            <div class="admin-summary-card mt-4">
                <h3>@(Model.DocumentRequirementForm.PublicId == Guid.Empty ? "Yeni belge koşulu" : "Belge koşulunu düzenle")</h3>
                <p class="text-muted">
                    @selectedRequirementOffering.ProgramName · @selectedRequirementOffering.AcademicYear · @selectedRequirementOffering.TermName · İlan #@selectedRequirementOffering.ProgramOfferingId
                </p>
                <form asp-action="SaveDocumentRequirement" method="post" novalidate data-disable-on-submit="true">
                    <input asp-for="DocumentRequirementForm.ProgramOfferingId" type="hidden" />
                    <input asp-for="DocumentRequirementForm.PublicId" type="hidden" />
                    <input asp-for="DocumentRequirementForm.RowVersion" type="hidden" />
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label asp-for="DocumentRequirementForm.DocumentCode" class="form-label">Belge kodu</label>
                            <input asp-for="DocumentRequirementForm.DocumentCode" class="form-control" placeholder="TRANSCRIPT" />
                        </div>
                        <div class="col-12 col-sm-6 col-lg-5">
                            <label asp-for="DocumentRequirementForm.DisplayName" class="form-label">Türkçe görünen ad</label>
                            <input asp-for="DocumentRequirementForm.DisplayName" class="form-control" placeholder="Transkript" />
                        </div>
                        <div class="col-12">
                            <label asp-for="DocumentRequirementForm.Description" class="form-label">Açıklama</label>
                            <textarea asp-for="DocumentRequirementForm.Description" class="form-control" rows="3" maxlength="500"></textarea>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-label">İzin verilen tür</label>
                            <select asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-select">
                                <option value="PdfOnly">PDF</option>
                                <option value="ImageOnly">JPEG veya PNG</option>
                                <option value="PdfOrImage">PDF, JPEG veya PNG</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="DocumentRequirementForm.MaximumBytes" class="form-label">Maksimum boyut (bayt)</label>
                            <input asp-for="DocumentRequirementForm.MaximumBytes" type="number" min="1" max="104857600" class="form-control" />
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input asp-for="DocumentRequirementForm.IsRequired" class="form-check-input" />
                                <label asp-for="DocumentRequirementForm.IsRequired" class="form-check-label">Zorunlu belge</label>
                            </div>
                        </div>
                    </div>
                    <div class="admin-form-actions mt-3">
                        <button type="submit" class="btn btn-primary">Belge koşulunu kaydet</button>
                        @if (Model.DocumentRequirementForm.PublicId != Guid.Empty)
                        {
                            <a asp-action="Offerings"
                               asp-route-requirementOfferingId="@selectedRequirementOffering.ProgramOfferingId"
                               asp-route-academicYearStart="@Model.AcademicYearStart"
                               asp-route-term="@Model.Term"
                               asp-route-includeArchived="@Model.IncludeArchived"
                               asp-fragment="document-requirements"
                               class="btn btn-outline-secondary">Düzenlemeden vazgeç</a>
                        }
                    </div>
                </form>
            </div>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
