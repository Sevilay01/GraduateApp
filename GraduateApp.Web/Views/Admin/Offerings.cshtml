                    <input asp-for="Form.AcademicYearStart" class="form-control" type="number" min="2000" max="2200" />
                    <span asp-validation-for="Form.AcademicYearStart" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Form.Term" class="form-label">@UiText.Get(Context, "Admin.Offerings.Term")</label>
                    <select asp-for="Form.Term" class="form-select">
                        @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                        {
                            <option value="@((int)term)">@UiText.Get(Context, $"AcademicTerm.{term}")</option>
                        }
                    </select>
                    <span asp-validation-for="Form.Term" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Form.ApplicationStartLocal" class="form-label">@UiText.Get(Context, "Admin.Offerings.StartIstanbul")</label>
                    <input asp-for="Form.ApplicationStartLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                    <span asp-validation-for="Form.ApplicationStartLocal" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Form.ApplicationDeadlineLocal" class="form-label">@UiText.Get(Context, "Admin.Offerings.DeadlineIstanbul")</label>
                    <input asp-for="Form.ApplicationDeadlineLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" id="application-deadline-local" />
                    <span asp-validation-for="Form.ApplicationDeadlineLocal" class="text-danger"></span>
                </div>
                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Form.Quota" class="form-label">@UiText.Get(Context, "Admin.Offerings.Quota")</label>
                    <input asp-for="Form.Quota" type="number" min="1" class="form-control" />
                    <span asp-validation-for="Form.Quota" class="text-danger"></span>
                </div>
                <div class="col-12 col-lg-9">
                    <div class="form-check mt-2">
                        <input asp-for="Form.UsesEvaluationWorkflow" class="form-check-input" />
                        <label asp-for="Form.UsesEvaluationWorkflow" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.UseEvaluation")</label>
                    </div>
                    <div class="form-text">@UiText.Get(Context, "Admin.Offerings.EvaluationImmutable")</div>
                </div>
                </div>
            </section>

            <fieldset class="mt-4" aria-labelledby="exam-requirements-heading">
                <legend id="exam-requirements-heading" class="h3 fs-5" tabindex="-1" data-fragment-focus>@UiText.Get(Context, "Admin.Offerings.ExamRequirements")</legend>
                <p class="text-muted">@UiText.Get(Context, "Admin.Offerings.ExamLead")</p>
                <div class="admin-summary-grid">
                    @for (var index = 0; index < Model.Form.Exams.Count; index++)
                    {
                        var exam = Model.Form.Exams[index];
                        var isAles = exam.IsAles;
                        <div class="admin-summary-card"
                             data-exam-requirement
                             data-ales-validity="@(isAles ? "true" : "false")">
                            <input asp-for="Form.ExamRequirements[index].ExamId" value="@exam.ExamId" type="hidden" />
                            <h3>@exam.ExamName</h3>
                            <div class="form-check">
                                <input asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-input" />
                                <label asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.UseCondition")</label>
                            </div>
                            <div class="form-check mt-2">
                                <input asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-input" />
                                <label asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.RequiredExam")</label>
                            </div>
                            <label asp-for="Form.ExamRequirements[index].MinimumScore" class="form-label mt-3">@UiText.Get(Context, "Admin.Offerings.MinimumScore")</label>
                            <input asp-for="Form.ExamRequirements[index].MinimumScore" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Form.ExamRequirements[index].MinimumScore" class="text-danger"></span>
                            <label asp-for="Form.ExamRequirements[index].MinimumValidityDate" class="form-label mt-3">@UiText.Get(Context, "Admin.Offerings.MinimumDate")</label>
                            <input asp-for="Form.ExamRequirements[index].MinimumValidityDate"
                                   class="form-control"
                                   type="date"
                                   data-validity-date />
                            <div class="form-text">@UiText.Get(Context, "Admin.Offerings.MinimumDateHelp")</div>
                            @if (isAles)
                            {
                                <div class="form-text" data-ales-validity-help>
                                    @UiText.Get(Context, "Admin.Offerings.AlesHelp")
                                    <span class="d-block fw-semibold" data-ales-validity-suggestion></span>
                                </div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary mt-2"
                                        data-apply-ales-validity>
                                    @UiText.Get(Context, "Admin.Offerings.ApplyFiveYears")
                                </button>
                            }
                        </div>
                    }
                </div>
            </fieldset>

            <section class="mt-4" aria-labelledby="offering-readiness-heading">
                <h3 id="offering-readiness-heading" class="h5" tabindex="-1" data-fragment-focus>@UiText.Get(Context, "Admin.Offerings.ReviewOpen")</h3>
                @if (Model.Form.ProgramOfferingId == 0)
                {
                    <div class="alert alert-info" data-new-offering-closed>
                        <strong>@UiText.Get(Context, "Admin.Offerings.NewClosedHeading")</strong>
                        <div class="form-check">
                            <input asp-for="Form.IsOpen" class="form-check-input" disabled />
                            <label asp-for="Form.IsOpen" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.NewClosedLabel")</label>
                        </div>
                        <p class="mb-0 mt-2">@UiText.Get(Context, "Admin.Offerings.NewClosedLead")</p>
                    </div>
                }
                else
                {
                    <div class="form-check">
                        <input asp-for="Form.IsOpen" class="form-check-input" disabled="@(!formOfferingHasActiveRequiredRequirement)" />
                        <label asp-for="Form.IsOpen" class="form-check-label"></label>
                    </div>
                    @if (!formOfferingHasActiveRequiredRequirement)
                    {
                        <p class="text-warning mt-2">@UiText.Get(Context, "Admin.Offerings.RequiredMissing")</p>
                    }
                    <div class="danger-zone">
                        <h4 class="h5">@UiText.Get(Context, "Admin.Offerings.ArchiveHeading")</h4>
                        <p>@UiText.Get(Context, "Admin.Offerings.ArchiveLead")</p>
                        <div class="form-check">
                            <input asp-for="Form.IsArchived" class="form-check-input" />
                            <label asp-for="Form.IsArchived" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.Archive")</label>
                        </div>
                    </div>
                }
            </section>

            <div class="admin-form-actions mt-4">
                <button class="btn btn-primary" type="submit">@(Model.Form.ProgramOfferingId > 0 ? UiText.Get(Context, "Admin.Offerings.Save") : UiText.Get(Context, "Admin.Offerings.CreateClosed"))</button>
                @if (Model.Form.ProgramOfferingId > 0)
                {
                    <a asp-action="Offerings" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.CancelEdit")</a>
                }
            </div>
        </form>
    </section>

    <section id="document-requirements" class="admin-section" aria-labelledby="document-requirements-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="document-requirements-heading"
                    tabindex="-1"
                    data-fragment-focus
                    data-auto-focus="@(Model.AutoFocusTarget == "document-requirements-heading" ? "true" : "false")">
                    @UiText.Get(Context, "Admin.Requirements.Heading")
                </h2>
                <p>@UiText.Get(Context, "Admin.Requirements.SnapshotLead")</p>
            </div>
        </div>
        <div class="alert alert-info" role="note">
            @UiText.Get(Context, "Admin.Requirements.Invariant")
        </div>
        <div class="admin-summary-card mb-4" data-document-guidance>
            <h3 class="h5">@UiText.Get(Context, "Admin.Requirements.GuideHeading")</h3>
            <p>@UiText.Get(Context, "Admin.Requirements.GuideLead")</p>
            <p class="mb-0">
                @UiText.Get(Context, "Admin.Requirements.GuidePrefix")
                <a href="https://sosyalbilimler.cu.edu.tr/storage/Belgeler/ilanlar/2026_2027_guz/cu_sosbil_2026_2027_guz_6_temmuz.pdf"
                   target="_blank"
                   rel="noopener noreferrer">@UiText.Get(Context, "Admin.Requirements.SocialGuide")</a>
                @UiText.Get(Context, "Admin.Requirements.And")
                <a href="https://iso.cu.edu.tr/haber-detay/84/2026-2027-guz-yariyili-lisansustu-programlara-uluslararasi-ogrenci-basvurulari"
                   target="_blank"
                   rel="noopener noreferrer">@UiText.Get(Context, "Admin.Requirements.InternationalGuide")</a>
                @UiText.Get(Context, "Admin.Requirements.GuideSuffix")
            </p>
        </div>

        @if (selectedRequirementOffering is null)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Requirements.SelectHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Requirements.SelectLead")</p>
            </div>
        }
        else
        {
            var activeRequiredCount = selectedOfferingRequirements.Count(item => item.IsActive && item.IsRequired);
            <article class="admin-item-card" data-selected-requirement-offering>
                <header>
                    <div>
                        <span class="eyebrow">@UiText.Format(Context, "Admin.Requirements.Selected", selectedRequirementOffering.ProgramOfferingId)</span>
                        <h3>@selectedRequirementOffering.ProgramName</h3>
                        <p class="text-muted mb-0">@selectedRequirementOffering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, selectedRequirementOffering.TermName)</p>
                    </div>
                    <span class="admin-state @(activeRequiredCount > 0 ? "admin-state--success" : "admin-state--danger")">@UiText.Format(Context, "Admin.Requirements.ActiveRequired", activeRequiredCount)</span>
                </header>
                @if (selectedRequirementOfferingIsLocked)
                {
                    <div class="alert alert-info" role="note" data-document-requirements-read-only>
                        @UiText.Get(Context, "Admin.Requirements.Locked")
                    </div>
                }
                @if (selectedOfferingRequirements.Count == 0)
                {
                    <div class="empty-state">
                        <h4>@UiText.Get(Context, "Admin.Requirements.EmptyHeading")</h4>
                        @if (selectedRequirementOfferingIsLocked)
                        {
                            <p>@UiText.Get(Context, "Admin.Requirements.HistoricalLocked")</p>
                        }
                        else
                        {
                            <p>@UiText.Get(Context, "Admin.Offerings.RequiredMissing")</p>
                        }
                    </div>
                }
                else
                {
                    <div class="table-shell">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle responsive-table">
                                <caption class="visually-hidden">@UiText.Format(Context, "Admin.Requirements.Caption", selectedRequirementOffering.ProgramName)</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">@UiText.Get(Context, "Admin.Requirements.Requirement")</th>
                                        <th scope="col">@UiText.Get(Context, "Admin.Requirements.Description")</th>
                                        <th scope="col">@UiText.Get(Context, "Admin.Requirements.TypeLimit")</th>
                                        <th scope="col">@UiText.Get(Context, "Admin.Common.Status")</th>
                                        <th scope="col">@UiText.Get(Context, "Admin.Requirements.Action")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var requirement in selectedOfferingRequirements)
                                    {
                                        var isLastActiveRequired = selectedRequirementOffering.IsOpen
                                            && requirement.IsActive
                                            && requirement.IsRequired
                                            && activeRequiredCount == 1;
                                        <tr>
                                            <td data-label="@UiText.Get(Context, "Admin.Requirements.Requirement")">
                                                <code>@requirement.DocumentCode</code>
                                                <div class="fw-semibold">@requirement.DisplayName</div>
                                                <small>@(requirement.IsRequired ? UiText.Get(Context, "Admin.Requirements.Required") : UiText.Get(Context, "Admin.Requirements.Optional"))</small>
                                            </td>
                                            <td data-label="@UiText.Get(Context, "Admin.Requirements.Description")">@(string.IsNullOrWhiteSpace(requirement.Description) ? UiText.Get(Context, "Admin.Requirements.NoDescription") : requirement.Description)</td>
                                            <td data-label="@UiText.Get(Context, "Admin.Requirements.TypeLimit")">@UiText.LocalizeDocumentCategory(Context, requirement.AllowedContentCategory) · @DocumentPresentation.FileSize(requirement.MaximumBytes)</td>
                                            <td data-label="@UiText.Get(Context, "Admin.Common.Status")">
                                                <span class="admin-state @(requirement.IsActive ? "admin-state--success" : null)">@(requirement.IsActive ? UiText.Get(Context, "Admin.Common.Active") : UiText.Get(Context, "Admin.Common.Inactive"))</span>
                                                <small class="d-block mt-1">@UiText.Get(Context, "Admin.Requirements.ConcurrencyProtected")</small>
                                            </td>
                                            <td data-label="">
                                                @if (selectedRequirementOfferingIsLocked)
                                                {
                                                    <span class="text-muted">@UiText.Get(Context, "Admin.Requirements.ReadOnly")</span>
                                                }
                                                else
                                                {
                                                    <div class="admin-action-stack">
                                                        <a asp-action="Offerings"
                                                           asp-route-requirementOfferingId="@selectedRequirementOffering.ProgramOfferingId"
                                                           asp-route-editRequirementId="@requirement.PublicId"
                                                           asp-route-academicYearStart="@Model.AcademicYearStart"
                                                           asp-route-term="@Model.Term"
                                                           asp-route-includeArchived="@Model.IncludeArchived"
                                                           asp-fragment="document-requirements"
                                                           class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Requirements.Edit")</a>
                                                        <form asp-action="SetDocumentRequirementActive" method="post" data-disable-on-submit="true">
                                                            <input type="hidden" name="programOfferingId" value="@selectedRequirementOffering.ProgramOfferingId" />
                                                            <input type="hidden" name="publicId" value="@requirement.PublicId" />
                                                            <input type="hidden" name="isActive" value="@((!requirement.IsActive).ToString().ToLowerInvariant())" />
                                                            <input type="hidden" name="rowVersion" value="@requirement.RowVersion" />
                                                            <button type="submit"
                                                                    class="btn btn-sm @(requirement.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                                    aria-label="@(requirement.IsActive ? UiText.Format(Context, "Admin.Requirements.DeactivateAria", requirement.DisplayName) : UiText.Format(Context, "Admin.Requirements.ActivateAria", requirement.DisplayName))">
                                                                @(requirement.IsActive ? UiText.Get(Context, "Admin.Requirements.Deactivate") : UiText.Get(Context, "Admin.Requirements.Activate"))
                                                            </button>
                                                        </form>
                                                    </div>
                                                    @if (isLastActiveRequired)
                                                    {
                                                        <small class="text-warning d-block mt-2">@UiText.Get(Context, "Admin.Requirements.LastRequired")</small>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </article>

            @if (!selectedRequirementOfferingIsLocked)
            {
                <div class="admin-summary-card mt-4">
                    <h3>@(Model.DocumentRequirementForm.PublicId == Guid.Empty ? UiText.Get(Context, "Admin.Requirements.NewHeading") : UiText.Get(Context, "Admin.Requirements.EditHeading"))</h3>
                    <p class="text-muted">
                        @selectedRequirementOffering.ProgramName · @selectedRequirementOffering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, selectedRequirementOffering.TermName) · @UiText.Format(Context, "Admin.Offerings.OfferingNumber", selectedRequirementOffering.ProgramOfferingId)
                    </p>
                    <form asp-action="SaveDocumentRequirement" method="post" novalidate data-disable-on-submit="true">
                        <input asp-for="DocumentRequirementForm.ProgramOfferingId" type="hidden" />
                        <input asp-for="DocumentRequirementForm.PublicId" type="hidden" />
                        <input asp-for="DocumentRequirementForm.RowVersion" type="hidden" />
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-6 col-lg-3">
                                <label asp-for="DocumentRequirementForm.DocumentCode" class="form-label">@UiText.Get(Context, "Admin.Requirements.Code")</label>
                                <input asp-for="DocumentRequirementForm.DocumentCode" class="form-control" placeholder="TRANSCRIPT" />
                            </div>
                            <div class="col-12 col-sm-6 col-lg-5">
                                <label asp-for="DocumentRequirementForm.DisplayName" class="form-label">@UiText.Get(Context, "Admin.Requirements.DisplayNameTurkish")</label>
                                <input asp-for="DocumentRequirementForm.DisplayName" class="form-control" placeholder="Transkript" />
                            </div>
                            <div class="col-12">
                                <label asp-for="DocumentRequirementForm.Description" class="form-label">@UiText.Get(Context, "Admin.Requirements.Description")</label>
                                <textarea asp-for="DocumentRequirementForm.Description" class="form-control" rows="3" maxlength="500"></textarea>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-label">@UiText.Get(Context, "Admin.Requirements.AllowedType")</label>
                                <select asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-select">
                                    <option value="PdfOnly">@UiText.LocalizeDocumentCategory(Context, DocumentContentCategory.PdfOnly)</option>
                                    <option value="ImageOnly">@UiText.LocalizeDocumentCategory(Context, DocumentContentCategory.ImageOnly)</option>
                                    <option value="PdfOrImage">@UiText.LocalizeDocumentCategory(Context, DocumentContentCategory.PdfOrImage)</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="DocumentRequirementForm.MaximumBytes" class="form-label">@UiText.Get(Context, "Admin.Requirements.MaximumBytes")</label>
                                <input asp-for="DocumentRequirementForm.MaximumBytes" type="number" min="1" max="104857600" class="form-control" />
                            </div>
                            <div class="col-12 col-md-4 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    <input asp-for="DocumentRequirementForm.IsRequired" class="form-check-input" />
                                    <label asp-for="DocumentRequirementForm.IsRequired" class="form-check-label">@UiText.Get(Context, "Admin.Requirements.RequiredDocument")</label>
                                </div>
                            </div>
                        </div>
                        <div class="admin-form-actions mt-3">
                            <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Admin.Requirements.Save")</button>
                            @if (Model.DocumentRequirementForm.PublicId != Guid.Empty)
                            {
                                <a asp-action="Offerings"
                                   asp-route-requirementOfferingId="@selectedRequirementOffering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="document-requirements"
                                   class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.CancelEdit")</a>
                            }
                        </div>
                    </form>
                </div>
            }
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const suggestedDateFormat = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(UiText.Get(Context, "Admin.Offerings.AlesSuggestion")));
            const deadlineRequiredText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(UiText.Get(Context, "Admin.Offerings.AlesNeedDeadline")));
            const deadlineInput = document.getElementById('application-deadline-local');
            const alesCards = document.querySelectorAll('[data-ales-validity="true"]');

            const subtractYears = (value, years) => {
                const datePart = value?.slice(0, 10);
                const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(datePart ?? '');
                if (!match) {
                    return null;
                }

                const targetYear = Number(match[1]) - years;
                const month = Number(match[2]);
                const day = Number(match[3]);
                const lastDay = new Date(targetYear, month, 0).getDate();
                return [
                    String(targetYear).padStart(4, '0'),
                    String(month).padStart(2, '0'),
                    String(Math.min(day, lastDay)).padStart(2, '0')
                ].join('-');
            };

            const formatDate = value => {
                if (!value) {
                    return '';
                }

                const [year, month, day] = value.split('-');
                return `${day}.${month}.${year}`;
            };

            const refreshSuggestions = () => {
                const suggestedDate = subtractYears(deadlineInput?.value, 5);
                alesCards.forEach(card => {
                    const suggestion = card.querySelector('[data-ales-validity-suggestion]');
                    const button = card.querySelector('[data-apply-ales-validity]');
                    if (suggestion) {
                        suggestion.textContent = suggestedDate
                            ? suggestedDateFormat.replace('{0}', formatDate(suggestedDate))
                            : deadlineRequiredText;
                    }
                    if (button) {
                        button.disabled = !suggestedDate;
                        button.dataset.suggestedDate = suggestedDate ?? '';
                    }
                });
            };

            alesCards.forEach(card => {
                const button = card.querySelector('[data-apply-ales-validity]');
                const validityInput = card.querySelector('[data-validity-date]');
                button?.addEventListener('click', () => {
                    const suggestedDate = button.dataset.suggestedDate;
                    if (!suggestedDate || !validityInput) {
                        return;
                    }

                    validityInput.value = suggestedDate;
                    validityInput.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });

            deadlineInput?.addEventListener('input', refreshSuggestions);
            deadlineInput?.addEventListener('change', refreshSuggestions);
            refreshSuggestions();
        })();
    </script>
}
