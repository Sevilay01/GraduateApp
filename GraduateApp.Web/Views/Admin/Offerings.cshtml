@model ProgramOfferingPageViewModel
@{
    ViewData["Title"] = "Dönemsel program ilanları";
    var formRequirements = Model.DocumentRequirements.TryGetValue(Model.Form.ProgramOfferingId, out var selectedRequirements)
        ? selectedRequirements
        : (IReadOnlyList<OfferingDocumentRequirementViewModel>)[];
    var formOfferingHasActiveRequiredRequirement = formRequirements.Any(item => item.IsActive && item.IsRequired);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Dönemsel program ilanları</h1>
        <p class="text-muted mb-0">Akademik yıl, dönem, kontenjan ve sınav koşullarını yönetin.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Başvurulara dön</a>
</div>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <label asp-for="AcademicYearStart" class="form-label">Akademik yıl başlangıcı</label>
            <input asp-for="AcademicYearStart" class="form-control" min="2000" max="2200" />
        </div>
        <div class="col-12 col-md-3">
            <label asp-for="Term" class="form-label">Dönem</label>
            <select asp-for="Term" class="form-select" asp-items="Html.GetEnumSelectList<AcademicTerm>()">
                <option value="">Tümü</option>
            </select>
        </div>
        <div class="col-12 col-md-3 form-check ms-2">
            <input asp-for="IncludeArchived" class="form-check-input" />
            <label asp-for="IncludeArchived" class="form-check-label">Arşivlenenleri göster</label>
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-primary" type="submit">Filtrele</button>
        </div>
    </div>
</form>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Program</th><th>Dönem</th><th>Son tarih</th><th>Kontenjan</th><th>Durum</th><th><span class="visually-hidden">İşlem</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var offering in Model.Offerings)
                    {
                        var offeringRequirements = Model.DocumentRequirements.TryGetValue(offering.ProgramOfferingId, out var listedRequirements)
                            ? listedRequirements
                            : (IReadOnlyList<OfferingDocumentRequirementViewModel>)[];
                        var hasActiveRequiredRequirement = offeringRequirements.Any(item => item.IsActive && item.IsRequired);
                        <tr>
                            <td>@offering.ProgramName</td>
                            <td>@offering.AcademicYear · @offering.TermName</td>
                            <td>
                                @if (offering.ApplicationDeadlineUtc.HasValue)
                                {
                                    <time datetime="@offering.ApplicationDeadlineUtc.Value.ToString("O")">
                                        @IstanbulTime.FromUtc(offering.ApplicationDeadlineUtc.Value).ToString("dd.MM.yyyy HH:mm")
                                    </time>
                                }
                                else
                                {
                                    <span>Belirtilmemiş</span>
                                }
                            </td>
                            <td>@offering.Quota</td>
                            <td>
                                <div>@(offering.IsArchived ? "Arşivli" : offering.IsOpen ? "Açık" : "Kapalı")</div>
                                @if (!hasActiveRequiredRequirement)
                                {
                                    <div class="small text-warning">İlan açılmadan önce en az bir zorunlu belge koşulu tanımlayın.</div>
                                }
                            </td>
                            <td><a asp-action="Offerings" asp-route-editId="@offering.ProgramOfferingId" class="btn btn-sm btn-outline-primary">Düzenle</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card">
            <div class="card-body">
                <h2 class="h4">@(Model.Form.ProgramOfferingId > 0 ? "İlanı düzenle" : "Yeni ilan")</h2>
                <form asp-action="SaveOffering" method="post" novalidate>
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <input asp-for="Form.ProgramOfferingId" type="hidden" />
                    <input asp-for="Form.RowVersion" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Form.ProgramId" class="form-label"></label>
                        <select asp-for="Form.ProgramId" class="form-select">
                            @foreach (var program in Model.Form.Programs)
                            {
                                <option value="@program.ProgramId">@program.InstituteName · @program.ProgramName · @program.DegreeType</option>
                            }
                        </select>
                        <span asp-validation-for="Form.ProgramId" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <label asp-for="Form.AcademicYearStart" class="form-label"></label>
                            <input asp-for="Form.AcademicYearStart" class="form-control" type="number" min="2000" max="2200" />
                            <span asp-validation-for="Form.AcademicYearStart" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label asp-for="Form.Term" class="form-label"></label>
                            <select asp-for="Form.Term" class="form-select">
                                @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                                {
                                    <option value="@((int)term)">@term.DisplayName()</option>
                                }
                            </select>
                            <span asp-validation-for="Form.Term" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Form.ApplicationStartLocal" class="form-label"></label>
                        <input asp-for="Form.ApplicationStartLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Form.ApplicationStartLocal" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Form.ApplicationDeadlineLocal" class="form-label"></label>
                        <input asp-for="Form.ApplicationDeadlineLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
                        <span asp-validation-for="Form.ApplicationDeadlineLocal" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        <label asp-for="Form.Quota" class="form-label"></label>
                        <input asp-for="Form.Quota" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Form.Quota" class="text-danger"></span>
                    </div>

                    <fieldset class="mt-3">
                        <legend class="h6">Sınav koşulları</legend>
                        @for (var index = 0; index < Model.Form.Exams.Count; index++)
                        {
                            var exam = Model.Form.Exams[index];
                            <div class="border rounded p-2 mb-2">
                                <input asp-for="Form.ExamRequirements[index].ExamId" value="@exam.ExamId" type="hidden" />
                                <div class="form-check">
                                    <input asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-input" />
                                    <label asp-for="Form.ExamRequirements[index].IsConfigured" class="form-check-label">@exam.ExamName koşulunu kullan</label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-input" />
                                    <label asp-for="Form.ExamRequirements[index].IsRequired" class="form-check-label">@exam.ExamName zorunlu</label>
                                </div>
                                <label asp-for="Form.ExamRequirements[index].MinimumScore" class="form-label small">Minimum puan</label>
                                <input asp-for="Form.ExamRequirements[index].MinimumScore" class="form-control form-control-sm" type="number" step="0.01" min="0" />
                                <span asp-validation-for="Form.ExamRequirements[index].MinimumScore" class="text-danger"></span>
                                <label asp-for="Form.ExamRequirements[index].MinimumValidityDate" class="form-label small">Minimum geçerlilik tarihi</label>
                                <input asp-for="Form.ExamRequirements[index].MinimumValidityDate" class="form-control form-control-sm" type="date" />
                            </div>
                        }
                    </fieldset>

                    @if (Model.Form.ProgramOfferingId == 0)
                    {
                        <div class="form-check mt-3">
                            <input asp-for="Form.IsOpen" class="form-check-input" disabled />
                            <label asp-for="Form.IsOpen" class="form-check-label"></label>
                        </div>
                        <p class="small text-muted">Yeni ilan önce kapalı oluşturulur. En az bir aktif ve zorunlu belge koşulu tanımladıktan sonra ilanı düzenleyerek açabilirsiniz.</p>
                    }
                    else
                    {
                        <div class="form-check mt-3">
                            <input asp-for="Form.IsOpen" class="form-check-input" disabled="@(!formOfferingHasActiveRequiredRequirement)" />
                            <label asp-for="Form.IsOpen" class="form-check-label"></label>
                        </div>
                        @if (!formOfferingHasActiveRequiredRequirement)
                        {
                            <p class="small text-warning">İlan açılmadan önce en az bir zorunlu belge koşulu tanımlayın.</p>
                        }
                    }
                    @if (Model.Form.ProgramOfferingId > 0)
                    {
                        <div class="form-check">
                            <input asp-for="Form.IsArchived" class="form-check-input" />
                            <label asp-for="Form.IsArchived" class="form-check-label"></label>
                        </div>
                    }

                    <button class="btn btn-primary mt-3" type="submit">Kaydet</button>
                </form>
            </div>
        </section>
    </div>
</div>

<section class="card mt-4" aria-labelledby="document-requirements-heading">
    <div class="card-body">
        <h2 id="document-requirements-heading" class="h4">İlan belge koşulları</h2>
        <div class="alert alert-info">
            Belge koşulu değişiklikleri yalnızca değişiklikten sonra oluşturulan taslakları etkiler. Mevcut taslak ve başvuruların snapshot koşulları değişmez.
        </div>

        @foreach (var offering in Model.Offerings)
        {
            var requirements = Model.DocumentRequirements.TryGetValue(offering.ProgramOfferingId, out var items)
                ? items
                : (IReadOnlyList<OfferingDocumentRequirementViewModel>)[];
            <div class="border rounded p-3 mb-3">
                <h3 class="h6">@offering.ProgramName · @offering.AcademicYear · @offering.TermName</h3>
                @if (requirements.Count == 0)
                {
                    <p class="text-muted">Belge koşulu tanımlanmamış.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Kod</th><th>Ad</th><th>Tür / sınır</th><th>Durum</th><th>İşlem</th></tr></thead>
                            <tbody>
                            @foreach (var requirement in requirements)
                            {
                                <tr>
                                    <td><code>@requirement.DocumentCode</code></td>
                                    <td>@requirement.DisplayName · @(requirement.IsRequired ? "Zorunlu" : "İsteğe bağlı")</td>
                                    <td>@requirement.AllowedContentCategory.CategoryName() · @DocumentPresentation.FileSize(requirement.MaximumBytes)</td>
                                    <td>@(requirement.IsActive ? "Aktif" : "Pasif")</td>
                                    <td class="d-flex gap-1">
                                        <a asp-action="Offerings"
                                           asp-route-requirementOfferingId="@offering.ProgramOfferingId"
                                           asp-route-editRequirementId="@requirement.PublicId"
                                           asp-route-includeArchived="true"
                                           class="btn btn-sm btn-outline-primary">Düzenle</a>
                                        <form asp-action="SetDocumentRequirementActive" method="post">
                                            <input type="hidden" name="programOfferingId" value="@offering.ProgramOfferingId" />
                                            <input type="hidden" name="publicId" value="@requirement.PublicId" />
                                            <input type="hidden" name="isActive" value="@((!requirement.IsActive).ToString().ToLowerInvariant())" />
                                            <input type="hidden" name="rowVersion" value="@requirement.RowVersion" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">@(requirement.IsActive ? "Pasifleştir" : "Aktifleştir")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <h3 class="h5">@(Model.DocumentRequirementForm.PublicId == Guid.Empty ? "Yeni belge koşulu" : "Belge koşulunu düzenle")</h3>
        <form asp-action="SaveDocumentRequirement" method="post" novalidate>
            <input asp-for="DocumentRequirementForm.PublicId" type="hidden" />
            <input asp-for="DocumentRequirementForm.RowVersion" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="DocumentRequirementForm.ProgramOfferingId" class="form-label">İlan</label>
                    <select asp-for="DocumentRequirementForm.ProgramOfferingId" class="form-select">
                        @foreach (var offering in Model.Offerings)
                        {
                            <option value="@offering.ProgramOfferingId">@offering.ProgramName · @offering.AcademicYear · @offering.TermName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="DocumentRequirementForm.DocumentCode" class="form-label">Belge kodu</label>
                    <input asp-for="DocumentRequirementForm.DocumentCode" class="form-control" placeholder="TRANSCRIPT" />
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="DocumentRequirementForm.DisplayName" class="form-label">Türkçe görünen ad</label>
                    <input asp-for="DocumentRequirementForm.DisplayName" class="form-control" placeholder="Transkript" />
                </div>
                <div class="col-12">
                    <label asp-for="DocumentRequirementForm.Description" class="form-label">Açıklama</label>
                    <textarea asp-for="DocumentRequirementForm.Description" class="form-control" maxlength="500"></textarea>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-label">İzin verilen tür</label>
                    <select asp-for="DocumentRequirementForm.AllowedContentCategory" class="form-select">
                        <option value="PdfOnly">PDF</option>
                        <option value="ImageOnly">JPEG veya PNG</option>
                        <option value="PdfOrImage">PDF, JPEG veya PNG</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label asp-for="DocumentRequirementForm.MaximumBytes" class="form-label">Maksimum boyut (bayt)</label>
                    <input asp-for="DocumentRequirementForm.MaximumBytes" type="number" min="1" max="104857600" class="form-control" />
                </div>
                <div class="col-12 col-md-4 form-check align-self-end mb-2 ms-2">
                    <input asp-for="DocumentRequirementForm.IsRequired" class="form-check-input" />
                    <label asp-for="DocumentRequirementForm.IsRequired" class="form-check-label">Zorunlu belge</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Belge koşulunu kaydet</button>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
