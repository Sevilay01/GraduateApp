@model ProgramOfferingPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Offerings.Title");
    var formOffering = Model.Offerings.SingleOrDefault(item => item.ProgramOfferingId == Model.Form.ProgramOfferingId);
    var selectedRequirementOffering = Model.RequirementOfferingId.HasValue
        ? Model.Offerings.SingleOrDefault(item => item.ProgramOfferingId == Model.RequirementOfferingId.Value)
        : null;
    var selectedOfferingRequirements = selectedRequirementOffering is not null
        && Model.DocumentRequirements.TryGetValue(selectedRequirementOffering.ProgramOfferingId, out var requirements)
        ? requirements
        : (IReadOnlyList<OfferingDocumentRequirementViewModel>)[];
    var selectedRequirementOfferingIsLocked = selectedRequirementOffering is not null
        && selectedRequirementOffering.UsesEvaluationWorkflow
        && selectedRequirementOffering.EvaluationState != OfferingEvaluationState.Configuring;
    var formOfferingHasActiveRequiredRequirement =
        formOffering?.HasActiveRequiredDocumentRequirement ?? false;
    var hasActiveFilters = Model.AcademicYearStart.HasValue || Model.Term.HasValue || Model.IncludeArchived;
    var legacyOfferingCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.LegacyOutsideDocumentWorkflow);
    var healthyOpenOfferingCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenHealthy);
    var invalidWithoutApplicationsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidNoApplications);
    var invalidWithDraftsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts);
    var invalidWithSubmittedApplicationsCount = Model.Offerings.Count(item =>
        item.DocumentConfigurationHealth == OfferingDocumentConfigurationHealth.OpenInvalidWithSubmittedApplications);
    var invalidOpenOfferings = Model.Offerings.Where(item =>
        item.DocumentConfigurationHealth is
            OfferingDocumentConfigurationHealth.OpenInvalidNoApplications
            or OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts
            or OfferingDocumentConfigurationHealth.OpenInvalidWithSubmittedApplications).ToArray();
}

<div class="admin-page">
    <header class="page-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Title")</span>
            <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Offerings.Heading")</h1>
            <p class="page-heading__description">@UiText.Get(Context, "Admin.Offerings.Lead")</p>
        </div>
        <div class="page-heading__actions">
            <a asp-action="Offerings"
               asp-route-academicYearStart="@Model.AcademicYearStart"
               asp-route-term="@Model.Term"
               asp-route-includeArchived="@Model.IncludeArchived"
               asp-fragment="offering-form"
               class="btn btn-primary">@UiText.Get(Context, "Admin.Offerings.New")</a>
            <a asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.Back")</a>
        </div>
    </header>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@UiText.Get(Context, "Admin.Offerings.LoadFailed")</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }

    <form method="get" class="admin-filter-panel" aria-labelledby="offering-filters-heading">
        <h2 id="offering-filters-heading" class="admin-filter-panel__heading">@UiText.Get(Context, "Admin.Offerings.FilterHeading")</h2>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="AcademicYearStart" class="form-label">@UiText.Get(Context, "Admin.Offerings.YearStart")</label>
                <input asp-for="AcademicYearStart" class="form-control" min="2000" max="2200" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label asp-for="Term" class="form-label">@UiText.Get(Context, "Admin.Offerings.Term")</label>
                <select asp-for="Term" class="form-select">
                    <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                    @foreach (var term in Enum.GetValues<AcademicTerm>())
                    {
                        <option value="@term">@UiText.Get(Context, $"AcademicTerm.{term}")</option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-3">
                <div class="form-check">
                    <input asp-for="IncludeArchived" class="form-check-input" />
                    <label asp-for="IncludeArchived" class="form-check-label">@UiText.Get(Context, "Admin.Offerings.IncludeArchived")</label>
                </div>
            </div>
            <div class="col-12 col-lg-3 admin-form-actions">
                <button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Applications.ApplyFilters")</button>
                <a asp-action="Offerings" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Clear")</a>
            </div>
        </div>
        @if (hasActiveFilters)
        {
            <div class="active-filters" aria-label="@UiText.Get(Context, "Admin.Applications.ActiveFilters")">
                <span class="active-filters__label">@UiText.Get(Context, "Admin.Applications.ActiveFilters")</span>
                @if (Model.AcademicYearStart.HasValue)
                {
                    <span class="filter-chip">@UiText.Format(Context, "Admin.Applications.YearFilter", Model.AcademicYearStart)</span>
                }
                @if (Model.Term.HasValue)
                {
                    <span class="filter-chip">@UiText.Format(Context, "Admin.Applications.TermFilter", UiText.Get(Context, $"AcademicTerm.{Model.Term.Value}"))</span>
                }
                @if (Model.IncludeArchived)
                {
                    <span class="filter-chip">@UiText.Get(Context, "Admin.Offerings.ArchivedIncluded")</span>
                }
            </div>
        }
    </form>

    <section id="offering-configuration-health"
             class="admin-section"
             aria-labelledby="offering-configuration-health-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="offering-configuration-health-heading">@UiText.Get(Context, "Admin.Offerings.HealthHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Offerings.HealthLead")</p>
            </div>
        </div>

        <div class="admin-summary-grid" data-offering-health-summary>
            <article class="admin-summary-card" data-health-category="A">
                <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Health.A")</span>
                <h3>@UiText.Format(Context, "Admin.Offerings.Count", legacyOfferingCount)</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.Health.ALead")</p>
            </article>
            <article class="admin-summary-card" data-health-category="B">
                <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Health.B")</span>
                <h3>@UiText.Format(Context, "Admin.Offerings.Count", healthyOpenOfferingCount)</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.Health.BLead")</p>
            </article>
            <article class="admin-summary-card" data-health-category="C">
                <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Health.C")</span>
                <h3>@UiText.Format(Context, "Admin.Offerings.Count", invalidWithoutApplicationsCount)</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.Health.CLead")</p>
            </article>
            <article class="admin-summary-card" data-health-category="D">
                <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Health.D")</span>
                <h3>@UiText.Format(Context, "Admin.Offerings.Count", invalidWithDraftsCount)</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.Health.DLead")</p>
            </article>
            <article class="admin-summary-card" data-health-category="E">
                <span class="eyebrow">@UiText.Get(Context, "Admin.Offerings.Health.E")</span>
                <h3>@UiText.Format(Context, "Admin.Offerings.Count", invalidWithSubmittedApplicationsCount)</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.Health.ELead")</p>
            </article>
        </div>

        @if (invalidOpenOfferings.Length == 0)
        {
            <div class="alert alert-success mt-4" role="status" data-offering-health-clear>
                @UiText.Get(Context, "Admin.Offerings.Health.Clear")
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-4" role="alert">
                <strong>@UiText.Format(Context, "Admin.Offerings.Health.Risk", invalidOpenOfferings.Length)</strong>
                @UiText.Get(Context, "Admin.Offerings.Health.RiskLead")
            </div>
            <div class="admin-card-list mt-4">
                @foreach (var offering in invalidOpenOfferings)
                {
                    var healthGroup = offering.DocumentConfigurationHealth switch
                    {
                        OfferingDocumentConfigurationHealth.OpenInvalidNoApplications => "C",
                        OfferingDocumentConfigurationHealth.OpenInvalidWithDrafts => "D",
                        _ => "E"
                    };
                    var hasCompletedEvaluation = offering.UsesEvaluationWorkflow
                        && offering.EvaluationState is OfferingEvaluationState.Finalized
                            or OfferingEvaluationState.Published;
                    <article class="admin-item-card"
                             data-offering-health-risk
                             data-health-category="@healthGroup">
                        <header>
                            <div>
                                <span class="eyebrow">@UiText.Format(Context, "Admin.Offerings.Health.Group", healthGroup, offering.ProgramOfferingId)</span>
                                <h3>@offering.ProgramName</h3>
                                <p class="text-muted mb-0">
                                    @offering.InstituteName · @UiText.LocalizeDegreeType(Context, offering.DegreeType) · @offering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, offering.TermName)
                                </p>
                            </div>
                            <span class="admin-state admin-state--danger">@UiText.Get(Context, "Admin.Offerings.Health.OpenInvalid")</span>
                        </header>

                        <dl class="meta-grid">
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Health.ActiveRequired")</dt>
                                <dd>@offering.ActiveRequiredDocumentRequirementCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Health.TotalRequirements")</dt>
                                <dd>@offering.DocumentRequirementCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Health.Drafts")</dt>
                                <dd>@offering.DraftApplicationCount</dd>
                            </div>
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Health.Submitted")</dt>
                                <dd>@offering.SubmittedOrLaterApplicationCount</dd>
                            </div>
                        </dl>

                        @if (offering.DraftApplicationCount + offering.SubmittedOrLaterApplicationCount > 0)
                        {
                            <div class="alert alert-danger" role="alert" data-existing-application-snapshot-warning>
                                @UiText.Get(Context, "Admin.Offerings.Health.SnapshotWarning")
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning" role="note">
                                @UiText.Get(Context, "Admin.Offerings.Health.Hidden")
                            </div>
                        }

                        @if (hasCompletedEvaluation)
                        {
                            <div class="alert alert-warning" role="note" data-completed-evaluation-remediation>
                                @UiText.Get(Context, "Admin.Offerings.Health.CompletedEvaluation")
                            </div>
                            <ol class="configuration-steps">
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepClose")</li>
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepReview")</li>
                            </ol>
                        }
                        else
                        {
                            <ol class="configuration-steps">
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepClose")</li>
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepGuide")</li>
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepDocuments")</li>
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepRequired")</li>
                                <li>@UiText.Get(Context, "Admin.Offerings.Health.StepReopen")</li>
                            </ol>
                        }

                        <div class="admin-item-card__actions">
                            <form asp-action="CloseInvalidOfferingForRemediation"
                                  method="post"
                                  class="d-inline"
                                  data-remediation-close-form>
                                <input type="hidden" name="programOfferingId" value="@offering.ProgramOfferingId" />
                                <input type="hidden" name="rowVersion" value="@offering.RowVersion" />
                                <input type="hidden" name="academicYearStart" value="@Model.AcademicYearStart" />
                                <input type="hidden" name="term" value="@Model.Term" />
                                <input type="hidden" name="includeArchived" value="@Model.IncludeArchived.ToString().ToLowerInvariant()" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        data-disable-on-submit="true">
                                    @(hasCompletedEvaluation ? UiText.Get(Context, "Admin.Offerings.Health.CloseReview") : UiText.Get(Context, "Admin.Offerings.Health.Close"))
                                </button>
                            </form>
                            @if (!hasCompletedEvaluation)
                            {
                                <a asp-action="Offerings"
                                   asp-route-requirementOfferingId="@offering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="document-requirements"
                                   class="btn btn-sm btn-primary">@UiText.Get(Context, "Admin.Offerings.Health.ConfigureDocuments")</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section aria-labelledby="offering-list-heading">
        <div class="admin-results-heading mb-3">
            <div>
                <h2 id="offering-list-heading">@UiText.Get(Context, "Admin.Offerings.ListHeading")</h2>
                <p class="admin-results-count" role="status">@UiText.Format(Context, "Admin.Offerings.Showing", Model.Offerings.Count)</p>
            </div>
        </div>
        @if (Model.Offerings.Count == 0)
        {
            <div class="empty-state">
                <h3>@UiText.Get(Context, "Admin.Offerings.EmptyHeading")</h3>
                <p>@UiText.Get(Context, "Admin.Offerings.EmptyLead")</p>
            </div>
        }
        else
        {
            <div class="admin-card-list">
                @foreach (var offering in Model.Offerings)
                {
                    var catalogProgram = Model.Form.Programs.SingleOrDefault(item => item.ProgramId == offering.ProgramId);
                    var stateClass = offering.IsArchived
                        ? "admin-state--danger"
                        : offering.IsOpen
                            ? "admin-state--success"
                            : "admin-state--warning";
                    var stateName = offering.IsArchived
                        ? UiText.Get(Context, "Admin.Offerings.State.Archived")
                        : offering.IsOpen
                            ? UiText.Get(Context, "Admin.Offerings.State.Open")
                            : UiText.Get(Context, "Admin.Offerings.State.Closed");
                    var isConfigurationLocked = offering.UsesEvaluationWorkflow
                        && offering.EvaluationState != OfferingEvaluationState.Configuring;

                    <article class="admin-item-card" data-offering-card>
                        <header>
                            <div>
                                <span class="eyebrow">@(string.IsNullOrWhiteSpace(offering.InstituteName) ? catalogProgram?.InstituteName : offering.InstituteName)</span>
                                <h3>@offering.ProgramName</h3>
                                <p class="text-muted mb-0">@offering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, offering.TermName)</p>
                            </div>
                            <span class="admin-state @stateClass">@stateName</span>
                        </header>

                        <dl class="meta-grid">
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Start")</dt>
                                <dd>
                                    @if (offering.ApplicationStartUtc.HasValue)
                                    {
                                        <time datetime="@offering.ApplicationStartUtc.Value.ToString("O")">@IstanbulTime.FromUtc(offering.ApplicationStartUtc.Value).ToString("g")</time>
                                    }
                                    else
                                    {
                                        <span>@UiText.Get(Context, "Admin.Offerings.Unspecified")</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.Deadline")</dt>
                                <dd>
                                    @if (offering.ApplicationDeadlineUtc.HasValue)
                                    {
                                        <time datetime="@offering.ApplicationDeadlineUtc.Value.ToString("O")">@IstanbulTime.FromUtc(offering.ApplicationDeadlineUtc.Value).ToString("g")</time>
                                    }
                                    else
                                    {
                                        <span>@UiText.Get(Context, "Admin.Offerings.Unspecified")</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item"><dt>@UiText.Get(Context, "Admin.Offerings.Quota")</dt><dd>@offering.Quota</dd></div>
                            <div class="meta-item">
                                <dt>@UiText.Get(Context, "Admin.Offerings.DocumentWorkflow")</dt>
                                <dd>
                                    @if (!offering.UsesDocumentWorkflow)
                                    {
                                        <span>@UiText.Get(Context, "Admin.Offerings.LegacyOutside")</span>
                                    }
                                    else
                                    {
                                        <span>@(offering.HasActiveRequiredDocumentRequirement ? UiText.Get(Context, "Admin.Offerings.Ready") : UiText.Get(Context, "Admin.Offerings.Incomplete")) · @UiText.Format(Context, "Admin.Offerings.RequirementCount", offering.DocumentRequirementCount)</span>
                                    }
                                </dd>
                            </div>
                            <div class="meta-item"><dt>@UiText.Get(Context, "Admin.Offerings.EvaluationWorkflow")</dt><dd>@(offering.UsesEvaluationWorkflow ? UiText.LocalizeEvaluationState(Context, offering.EvaluationState) : UiText.Get(Context, "Admin.Offerings.NotUsed"))</dd></div>
                            <div class="meta-item"><dt>@UiText.Get(Context, "Admin.Offerings.ExamRequirements")</dt><dd>@UiText.Format(Context, "Admin.Offerings.RequirementCount", offering.ExamRequirements.Count)</dd></div>
                        </dl>

                        <div class="admin-summary-card">
                            <h4>@UiText.Get(Context, "Admin.Offerings.ReadinessHeading")</h4>
                            <ul class="readiness-list">
                                <li class="@(offering.HasActiveRequiredDocumentRequirement ? "is-ready" : "is-blocked")">
                                    <strong>@UiText.Get(Context, "Admin.Offerings.RequiredCondition")</strong>
                                    @(offering.HasActiveRequiredDocumentRequirement ? UiText.Get(Context, "Admin.Offerings.RequiredReady") : UiText.Get(Context, "Admin.Offerings.RequiredMissing"))
                                </li>
                                @if (offering.UsesEvaluationWorkflow)
                                {
                                    <li>
                                        <strong>@UiText.Get(Context, "Admin.Offerings.CriteriaPolicy")</strong> @UiText.Get(Context, "Admin.Offerings.CriteriaPolicyLead")
                                    </li>
                                }
                                else
                                {
                                    <li class="is-ready"><strong>@UiText.Get(Context, "Admin.Offerings.EvaluationPolicy")</strong> @UiText.Get(Context, "Admin.Offerings.EvaluationPolicyLead")</li>
                                }
                            </ul>
                        </div>

                        @if (isConfigurationLocked)
                        {
                            <div class="alert alert-info" role="note" data-offering-configuration-locked>
                                @UiText.Get(Context, "Admin.Offerings.ConfigurationLocked")
                            </div>
                        }

                        <div class="admin-item-card__actions">
                            @if (!isConfigurationLocked)
                            {
                                <a asp-action="Offerings"
                                   asp-route-editId="@offering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="offering-form"
                                   class="btn btn-sm btn-primary">@UiText.Get(Context, "Admin.Offerings.EditGeneral")</a>
                                <a asp-action="Offerings"
                                   asp-route-requirementOfferingId="@offering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="document-requirements"
                                   class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Offerings.DocumentRequirements")</a>
                                <a asp-action="Offerings"
                                   asp-route-editId="@offering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="exam-requirements-heading"
                                   class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Offerings.ExamRequirements")</a>
                            }
                            @if (offering.UsesEvaluationWorkflow)
                            {
                                <a asp-action="Evaluation" asp-route-id="@offering.ProgramOfferingId" class="btn btn-sm btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.Evaluation")</a>
                            }
                            @if (!isConfigurationLocked)
                            {
                                <a asp-action="Offerings"
                                   asp-route-editId="@offering.ProgramOfferingId"
                                   asp-route-academicYearStart="@Model.AcademicYearStart"
                                   asp-route-term="@Model.Term"
                                   asp-route-includeArchived="@Model.IncludeArchived"
                                   asp-fragment="offering-readiness-heading"
                                   class="btn btn-sm btn-outline-secondary">@UiText.Get(Context, "Admin.Offerings.OpenCheck")</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section id="offering-form" class="admin-section" aria-labelledby="offering-form-heading">
        <div class="admin-section-heading">
            <div>
                <h2 id="offering-form-heading"
                    tabindex="-1"
                    data-fragment-focus
                    data-auto-focus="@(Model.AutoFocusTarget == "offering-form-heading" ? "true" : "false")">
                    @(Model.Form.ProgramOfferingId > 0 ? UiText.Get(Context, "Admin.Offerings.EditHeading") : UiText.Get(Context, "Admin.Offerings.NewHeading"))
                </h2>
                <p>@UiText.Get(Context, "Admin.Offerings.NewLead")</p>
            </div>
        </div>
        @if (formOffering is not null)
        {
            <div class="alert alert-info" role="status" data-selected-offering-context>
                <strong>@UiText.Get(Context, "Admin.Offerings.Editing")</strong>
                @formOffering.ProgramName · @formOffering.AcademicYear · @UiText.LocalizeAcademicTerm(Context, formOffering.TermName) · @UiText.Format(Context, "Admin.Offerings.OfferingNumber", formOffering.ProgramOfferingId)
            </div>
            <nav class="admin-summary-card mb-4" aria-label="@UiText.Get(Context, "Admin.Offerings.StepsAria")">
                <h3 class="h5">@UiText.Get(Context, "Admin.Offerings.Configuration")</h3>
                <ol class="configuration-steps">
                    <li><a href="#offering-general-heading">@UiText.Get(Context, "Admin.Offerings.General")</a></li>
                    <li>
                        <a asp-action="Offerings"
                           asp-route-requirementOfferingId="@formOffering.ProgramOfferingId"
                           asp-route-academicYearStart="@Model.AcademicYearStart"
                           asp-route-term="@Model.Term"
                           asp-route-includeArchived="@Model.IncludeArchived"
                           asp-fragment="document-requirements">@UiText.Get(Context, "Admin.Offerings.DocumentRequirements")</a>
                    </li>
                    <li><a href="#exam-requirements-heading">@UiText.Get(Context, "Admin.Offerings.ExamRequirements")</a></li>
                    <li>
                        @if (formOffering.UsesEvaluationWorkflow)
                        {
                            <a asp-action="Evaluation" asp-route-id="@formOffering.ProgramOfferingId">@UiText.Get(Context, "Admin.Offerings.EvaluationCriteria")</a>
                        }
                        else
                        {
                            <span>@UiText.Get(Context, "Admin.Offerings.EvaluationNotUsed")</span>
                        }
                    </li>
                    <li><a href="#offering-readiness-heading">@UiText.Get(Context, "Admin.Offerings.ReviewOpen")</a></li>
                </ol>
            </nav>
        }
        <form asp-action="SaveOffering" method="post" novalidate data-disable-on-submit="true">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <input asp-for="Form.ProgramOfferingId" type="hidden" />
            <input asp-for="Form.RowVersion" type="hidden" />

            <section aria-labelledby="offering-general-heading">
                <h3 id="offering-general-heading" class="h5" tabindex="-1" data-fragment-focus>@UiText.Get(Context, "Admin.Offerings.General")</h3>
                <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <label asp-for="Form.ProgramId" class="form-label">@UiText.Get(Context, "Admin.Offerings.Program")</label>
                    <select asp-for="Form.ProgramId" class="form-select">
                        @foreach (var program in Model.Form.Programs)
                        {
                            <option value="@program.ProgramId">@program.InstituteName · @program.ProgramName · @UiText.LocalizeDegreeType(Context, program.DegreeType)</option>
