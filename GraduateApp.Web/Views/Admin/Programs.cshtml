@model ProgramPageViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Admin.Programs.Title");
}

<header class="page-heading">
    <div>
        <span class="eyebrow">@UiText.Get(Context, "Admin.Catalog.Eyebrow")</span>
        <h1 class="page-heading__title">@UiText.Get(Context, "Admin.Programs.Heading")</h1>
        <p class="page-heading__description">@UiText.Get(Context, "Admin.Programs.Lead")</p>
    </div>
    <div class="page-heading__actions admin-tab-links">
        <a asp-action="Institutes" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Institutes")</a>
        <a asp-action="Programs" class="btn btn-outline-primary" aria-current="page">@UiText.Get(Context, "Admin.Catalog.Programs")</a>
        <a asp-action="ProgramTranslations" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.ProgramTranslations")</a>
        <a asp-action="Universities" class="btn btn-outline-primary">@UiText.Get(Context, "Admin.Catalog.Universities")</a>
    </div>
</header>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<div class="alert alert-info" role="note">
    @UiText.Get(Context, "Admin.Programs.Note")
</div>

<form method="get" class="admin-filter-panel mb-4" aria-labelledby="program-filter-heading">
    <h2 id="program-filter-heading" class="admin-filter-panel__heading">@UiText.Get(Context, "Admin.Programs.FilterHeading")</h2>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-lg-3">
            <label asp-for="Search" class="form-label">@UiText.Get(Context, "Admin.Programs.Name")</label>
            <input asp-for="Search" class="form-control" placeholder="@UiText.Get(Context, "Admin.Programs.SearchPlaceholder")" />
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <label asp-for="InstituteId" class="form-label">@UiText.Get(Context, "Admin.Institutes.Institute")</label>
            <select asp-for="InstituteId" class="form-select">
                <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                @foreach (var institute in Model.Institutes)
                {
                    <option value="@institute.InstituteId">@institute.InstituteName@(!institute.IsActive ? UiText.Get(Context, "Admin.Common.InactiveSuffix") : string.Empty)</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4 col-lg-3">
            <label asp-for="DegreeType" class="form-label">@UiText.Get(Context, "Admin.Common.DegreeType")</label>
            <select asp-for="DegreeType" class="form-select">
                <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                @foreach (var degreeType in Model.DegreeTypes)
                {
                    <option value="@degreeType">@UiText.LocalizeDegreeType(Context, degreeType)</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4 col-lg-2">
            <label asp-for="IsActive" class="form-label">@UiText.Get(Context, "Admin.Programs.RecordStatus")</label>
            <select asp-for="IsActive" class="form-select">
                <option value="">@UiText.Get(Context, "Admin.Common.All")</option>
                <option value="true">@UiText.Get(Context, "Admin.Common.Active")</option>
                <option value="false">@UiText.Get(Context, "Admin.Common.Inactive")</option>
            </select>
        </div>
        <div class="col-12 col-lg-1 d-flex gap-2">
            <button class="btn btn-primary" type="submit">@UiText.Get(Context, "Admin.Common.Filter")</button>
        </div>
    </div>
    <div class="mt-3"><a asp-action="Programs" class="link-secondary">@UiText.Get(Context, "Admin.Programs.ClearFilters")</a></div>
</form>

<div class="row g-4">
    <div class="col-12 col-xxl-8">
        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty-state">
                <h2>@UiText.Get(Context, "Admin.Programs.EmptyHeading")</h2>
                <p>@UiText.Get(Context, "Admin.Programs.EmptyLead")</p>
            </div>
        }
        else
        {
        <div class="table-shell">
            <div class="table-responsive">
            <table class="table table-hover align-middle responsive-table">
                <caption class="visually-hidden">@UiText.Get(Context, "Admin.Programs.Caption")</caption>
                <thead>
                    <tr><th scope="col">@UiText.Get(Context, "Admin.Institutes.Institute")</th><th scope="col">@UiText.Get(Context, "Admin.Institutes.Program")</th><th scope="col">@UiText.Get(Context, "Admin.Common.Degree")</th><th scope="col">@UiText.Get(Context, "Admin.Common.Offering")</th><th scope="col">@UiText.Get(Context, "Admin.Common.Status")</th><th scope="col" class="text-end">@UiText.Get(Context, "Admin.Common.Actions")</th></tr>
                </thead>
                <tbody>
                    @foreach (var program in Model.Result.Items)
                    {
                        <tr>
                            <td data-label="@UiText.Get(Context, "Admin.Institutes.Institute")">@program.InstituteName</td>
                            <td data-label="@UiText.Get(Context, "Admin.Institutes.Program")">
                                <div>@program.ProgramName</div>
                                @if (string.IsNullOrWhiteSpace(program.ProgramNameEnglish))
                                {
                                    <small class="text-warning">@UiText.Get(Context, "Admin.Programs.MissingEnglish")</small>
                                }
                                else
                                {
                                    <small class="text-body-secondary" lang="en">@program.ProgramNameEnglish</small>
                                }
                            </td>
                            <td data-label="@UiText.Get(Context, "Admin.Common.Degree")">@UiText.LocalizeDegreeType(Context, program.DegreeType)</td>
                            <td data-label="@UiText.Get(Context, "Admin.Common.Offering")">@program.OfferingCount</td>
                            <td data-label="@UiText.Get(Context, "Admin.Common.Status")">
                                @if (program.IsEffectivelyActive)
                                {
                                    <span class="admin-state admin-state--success">@UiText.Get(Context, "Admin.Common.Active")</span>
                                }
                                else if (program.IsActive)
                                {
                                    <span class="admin-state admin-state--warning">@UiText.Get(Context, "Admin.Programs.InstituteInactive")</span>
                                }
                                else
                                {
                                    <span class="admin-state">@UiText.Get(Context, "Admin.Common.Inactive")</span>
                                }
                            </td>
                            <td data-label="">
                                <div class="admin-action-stack">
                                    <a asp-action="Programs" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-instituteId="@Model.InstituteId" asp-route-degreeType="@Model.DegreeType" asp-route-page="@Model.Result.Page" asp-route-pageSize="@Model.Result.PageSize" asp-route-editId="@program.ProgramId" class="btn btn-sm btn-outline-primary">@UiText.Get(Context, "Admin.Common.Edit")</a>
                                    @if (program.IsActive)
                                    {
                                        <form asp-action="DeactivateProgram" method="post" data-disable-on-submit="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@program.ProgramId" />
                                            <input type="hidden" name="rowVersion" value="@program.RowVersion" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">@UiText.Get(Context, "Admin.Programs.Deactivate")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivateProgram" method="post" data-disable-on-submit="true">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@program.ProgramId" />
                                            <input type="hidden" name="rowVersion" value="@program.RowVersion" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">@UiText.Get(Context, "Admin.Programs.Activate")</button>
                                        </form>
                                    }
                                    <a asp-action="DeleteProgram" asp-route-id="@program.ProgramId" class="btn btn-sm btn-outline-danger">@UiText.Get(Context, "Admin.Programs.DeleteDetails")</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
        }

        @if (Model.Result.TotalPages > 1)
        {
            <nav aria-label="@UiText.Get(Context, "Admin.Programs.Pagination")">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : null)"><a class="page-link" asp-action="Programs" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-instituteId="@Model.InstituteId" asp-route-degreeType="@Model.DegreeType" asp-route-page="@(Model.Result.Page - 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Common.Previous")</a></li>
                    <li class="page-item disabled"><span class="page-link">@Model.Result.Page / @Model.Result.TotalPages</span></li>
                    <li class="page-item @(Model.Result.Page >= Model.Result.TotalPages ? "disabled" : null)"><a class="page-link" asp-action="Programs" asp-route-search="@Model.Search" asp-route-isActive="@Model.IsActive" asp-route-instituteId="@Model.InstituteId" asp-route-degreeType="@Model.DegreeType" asp-route-page="@(Model.Result.Page + 1)" asp-route-pageSize="@Model.Result.PageSize">@UiText.Get(Context, "Admin.Common.Next")</a></li>
                </ul>
            </nav>
        }
    </div>

    <div class="col-12 col-xxl-4">
        <section class="admin-section">
                <h2 class="h4">@(Model.Form.ProgramId > 0 ? UiText.Get(Context, "Admin.Programs.EditHeading") : UiText.Get(Context, "Admin.Programs.NewHeading"))</h2>
                <form asp-action="SaveProgram" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    <input asp-for="Form.ProgramId" type="hidden" />
                    @if (Model.Form.ProgramId > 0)
                    {
                        <input asp-for="Form.RowVersion" type="hidden" />
                    }
                    <div class="mb-3">
                        <label asp-for="Form.InstituteId" class="form-label">@UiText.Get(Context, "Admin.Institutes.Institute")</label>
                        <select asp-for="Form.InstituteId" class="form-select">
                            @foreach (var institute in Model.Institutes)
                            {
                                <option value="@institute.InstituteId">@institute.InstituteName@(!institute.IsActive ? UiText.Get(Context, "Admin.Common.InactiveSuffix") : string.Empty)</option>
                            }
                        </select>
                        <span asp-validation-for="Form.InstituteId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.ProgramName" class="form-label">@UiText.Get(Context, "Admin.Programs.NameTurkish")</label>
                        <input asp-for="Form.ProgramName" class="form-control" maxlength="100" autocomplete="off" />
                        <span asp-validation-for="Form.ProgramName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.ProgramNameEnglish" class="form-label">@UiText.Get(Context, "Admin.Programs.NameEnglish")</label>
                        <input asp-for="Form.ProgramNameEnglish"
                               class="form-control"
                               maxlength="100"
                               autocomplete="off"
                               lang="en"
                               placeholder="@UiText.Get(Context, "Admin.Programs.EnglishPlaceholder")" />
                        <div class="form-text">@UiText.Get(Context, "Admin.Programs.EnglishFallbackHelp")</div>
                        <span asp-validation-for="Form.ProgramNameEnglish" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.DegreeType" class="form-label">@UiText.Get(Context, "Admin.Common.DegreeType")</label>
                        <select asp-for="Form.DegreeType" class="form-select">
                            @foreach (var degreeType in Model.DegreeTypes)
                            {
                                <option value="@degreeType">@UiText.LocalizeDegreeType(Context, degreeType)</option>
                            }
                        </select>
                        <span asp-validation-for="Form.DegreeType" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" type="submit">@(Model.Form.ProgramId > 0 ? UiText.Get(Context, "Admin.Common.SaveChanges") : UiText.Get(Context, "Admin.Programs.Create"))</button>
                        @if (Model.Form.ProgramId > 0)
                        {
                            <a asp-action="Programs" class="btn btn-outline-secondary">@UiText.Get(Context, "Admin.Common.Cancel")</a>
                        }
                    </div>
                </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
