@model ResetPasswordViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Reset.Title");
}

<div class="auth-shell auth-shell--student">
    <section class="auth-intro" aria-labelledby="reset-password-heading">
        <span class="eyebrow">@UiText.Get(Context, "Reset.Eyebrow")</span>
        <h1 id="reset-password-heading" class="h2">@UiText.Get(Context, "Reset.Heading")</h1>
        <p class="mb-0">@UiText.Get(Context, "Reset.Lead")</p>
    </section>
    <section class="card auth-card" aria-label="@UiText.Get(Context, "Reset.Aria")">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="ResetPassword" method="post" novalidate>
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">@UiText.Get(Context, "Field.NewPassword")</label>
                    <div class="password-control">
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus data-password-reveal />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">@UiText.Get(Context, "Field.ConfirmPassword")</label>
                    <div class="password-control">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" data-password-reveal />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">@UiText.Get(Context, "Reset.Submit")</button>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
