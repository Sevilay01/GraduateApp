@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Parola sıfırlama";
}

<div class="auth-shell auth-shell--student">
    <section class="auth-intro" aria-labelledby="reset-password-heading">
        <span class="eyebrow">Hesap güvenliği</span>
        <h1 id="reset-password-heading" class="h2">Yeni parolanızı belirleyin</h1>
        <p class="mb-0">Başka hesaplarda kullanmadığınız, en az 12 karakterli güçlü bir parola seçin.</p>
    </section>
    <section class="card auth-card" aria-label="Yeni parola">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="ResetPassword" method="post" novalidate>
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <div class="password-control">
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus data-password-reveal />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="password-control">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" data-password-reveal />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Parolayı güncelle</button>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
