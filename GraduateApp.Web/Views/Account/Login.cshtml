@model LoginViewModel
@{
    var isAdminLogin = Model.AccountType == LoginAccountType.Admin;
    var loginAction = isAdminLogin ? "AdminLogin" : "Login";
    ViewData["Title"] = isAdminLogin ? "Yönetici girişi" : "Öğrenci girişi";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">@(isAdminLogin ? "Yönetici girişi" : "Öğrenci girişi")</h1>
                <p class="text-muted">
                    @(isAdminLogin
                        ? "Yöneticiler e-posta adresiyle giriş yapar."
                        : "Öğrenciler TC kimlik numarası veya e-posta adresiyle giriş yapar.")
                </p>
                @if (Model.HasExistingSession)
                {
                    <div class="alert alert-info" role="status">
                        Şu anda <strong>@(Model.ExistingRoleDisplay ?? "başka bir")</strong> hesabıyla oturumunuz açık.
                    </div>
                    <form asp-action="SwitchAccount" method="post">
                        <input type="hidden" name="accountType" value="@Model.AccountType" />
                        <button type="submit" class="btn btn-outline-primary w-100">Farklı hesapla giriş yap</button>
                    </form>
                }
                else
                {
                <form asp-action="@loginAction" method="post" novalidate>
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
                </form>
                }
                <div class="d-flex justify-content-between mt-3 small">
                    <a asp-action="ForgotPassword">Parolamı unuttum</a>
                    @if (isAdminLogin)
                    {
                        <a asp-action="Login">Öğrenci girişi</a>
                    }
                    else
                    {
                        <a asp-action="AdminLogin">Yönetici girişi</a>
                    }
                </div>
                @if (!isAdminLogin)
                {
                    <div class="mt-2 text-end small"><a asp-action="Register">Öğrenci kaydı</a></div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
