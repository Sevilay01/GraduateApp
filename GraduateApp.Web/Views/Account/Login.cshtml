@model LoginViewModel
@{
    var isAdminLogin = Model.AccountType == LoginAccountType.Admin;
    var loginAction = isAdminLogin ? "AdminLogin" : "Login";
    ViewData["Title"] = isAdminLogin ? "Yönetici girişi" : "Öğrenci girişi";
}

<div class="auth-shell @(isAdminLogin ? "auth-shell--admin" : "auth-shell--student")">
    <section class="auth-intro" aria-labelledby="login-heading">
        <span class="eyebrow">@(isAdminLogin ? "Yetkili erişimi" : "Öğrenci erişimi")</span>
        <h1 id="login-heading" class="h2">@(isAdminLogin ? "Yönetici girişi" : "Öğrenci girişi")</h1>
        <p class="mb-0">
            @(isAdminLogin
                ? "Bu alan yalnızca yetkilendirilmiş enstitü ve sistem yöneticileri içindir."
                : "Başvurularınızı oluşturmak, belgelerinizi yönetmek ve sonuçlarınızı takip etmek için giriş yapın.")
        </p>
    </section>

    <section class="card auth-card" aria-label="Giriş bilgileri">
        <div class="card-body p-4 p-lg-5">
            <span class="auth-context">@(isAdminLogin ? "Yönetici hesabı" : "Öğrenci hesabı")</span>
            <p class="text-muted">
                @(isAdminLogin
                    ? "Yöneticiler kurumsal e-posta adresiyle giriş yapar."
                    : "TC kimlik numaranızı veya kayıtlı e-posta adresinizi kullanabilirsiniz.")
            </p>
            @if (Model.HasExistingSession)
            {
                <div class="alert alert-info" role="status">
                    Şu anda <strong>@(Model.ExistingRoleDisplay ?? "başka bir")</strong> hesabıyla oturumunuz açık.
                </div>
                <form asp-action="SwitchAccount" method="post">
                    <input type="hidden" name="accountType" value="@Model.AccountType" />
                    <button type="submit" class="btn btn-outline-primary w-100">Farklı hesapla giriş yap</button>
                </form>
            }
            else
            {
                <form asp-action="@loginAction" method="post" novalidate>
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="password-control">
                            <input asp-for="Password" class="form-control" autocomplete="current-password" data-password-reveal />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Giriş yap</button>
                </form>
            }
            <div class="d-flex flex-wrap justify-content-between gap-2 mt-4 small">
                <a asp-action="ForgotPassword">Parolamı unuttum</a>
                @if (isAdminLogin)
                {
                    <a asp-action="Login">Öğrenci girişine geç</a>
                }
                else
                {
                    <a asp-action="AdminLogin">Yönetici girişine geç</a>
                }
            </div>
            @if (!isAdminLogin)
            {
                <hr class="my-4" />
                <p class="mb-0 small">Henüz hesabınız yok mu? <a asp-action="Register">Öğrenci kaydı oluşturun.</a></p>
            }
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
