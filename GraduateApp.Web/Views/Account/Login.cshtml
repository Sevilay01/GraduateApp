@model LoginViewModel
@{
    var isAdminLogin = Model.AccountType == LoginAccountType.Admin;
    var loginAction = isAdminLogin ? "AdminLogin" : "Login";
    ViewData["Title"] = isAdminLogin
        ? UiText.Get(Context, "Login.AdminTitle")
        : UiText.Get(Context, "Login.StudentTitle");
    var existingRoleDisplay = Model.ExistingRoleDisplay == "Yönetici"
        ? UiText.Get(Context, "Role.Admin")
        : Model.ExistingRoleDisplay == "Öğrenci"
            ? UiText.Get(Context, "Role.Student")
            : UiText.Get(Context, "Login.OtherAccount");
}

<div class="auth-shell @(isAdminLogin ? "auth-shell--admin" : "auth-shell--student")">
    <section class="auth-intro" aria-labelledby="login-heading">
        <span class="eyebrow">@(isAdminLogin ? UiText.Get(Context, "Login.AdminEyebrow") : UiText.Get(Context, "Login.StudentEyebrow"))</span>
        <h1 id="login-heading" class="h2">@(isAdminLogin ? UiText.Get(Context, "Login.AdminTitle") : UiText.Get(Context, "Login.StudentTitle"))</h1>
        <p class="mb-0">
            @(isAdminLogin
                ? UiText.Get(Context, "Login.AdminIntro")
                : UiText.Get(Context, "Login.StudentIntro"))
        </p>
    </section>

    <section class="card auth-card" aria-label="@UiText.Get(Context, "Login.Submit")">
        <div class="card-body p-4 p-lg-5">
            <span class="auth-context">@(isAdminLogin ? UiText.Get(Context, "Login.AdminContext") : UiText.Get(Context, "Login.StudentContext"))</span>
            <p class="text-muted">
                @(isAdminLogin
                    ? UiText.Get(Context, "Login.AdminHint")
                    : UiText.Get(Context, "Login.StudentHint"))
            </p>
            @if (Model.HasExistingSession)
            {
                <div class="alert alert-info" role="status">
                    @Html.Raw(UiText.Format(
                        Context,
                        "Login.ExistingSession",
                        $"<strong>{Html.Encode(existingRoleDisplay)}</strong>"))
                </div>
                <form asp-action="SwitchAccount" method="post">
                    <input type="hidden" name="accountType" value="@Model.AccountType" />
                    <button type="submit" class="btn btn-outline-primary w-100">@UiText.Get(Context, "Login.SwitchAccount")</button>
                </form>
            }
            else
            {
                <form asp-action="@loginAction" method="post" novalidate>
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label for="Username" class="form-label">@UiText.Get(Context, "Login.Username")</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Password" class="form-label">@UiText.Get(Context, "Login.Password")</label>
                        <div class="password-control">
                            <input asp-for="Password" class="form-control" autocomplete="current-password" data-password-reveal />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label for="RememberMe" class="form-check-label">@UiText.Get(Context, "Login.RememberMe")</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">@UiText.Get(Context, "Login.Submit")</button>
                </form>
            }
            <div class="d-flex flex-wrap justify-content-between gap-2 mt-4 small">
                <a asp-action="ForgotPassword">@UiText.Get(Context, "Login.ForgotPassword")</a>
                @if (isAdminLogin)
                {
                    <a asp-action="Login">@UiText.Get(Context, "Login.GoStudent")</a>
                }
                else
                {
                    <a asp-action="AdminLogin">@UiText.Get(Context, "Login.GoAdmin")</a>
                }
            </div>
            @if (!isAdminLogin)
            {
                <hr class="my-4" />
                <p class="mb-0 small">
                    @UiText.Get(Context, "Login.NoAccount")
                    <a asp-action="Register">@UiText.Get(Context, "Login.CreateRegistration")</a>
                </p>
            }
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
