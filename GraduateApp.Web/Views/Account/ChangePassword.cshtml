@model ChangePasswordViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Change.Title");
}

<div class="auth-shell auth-shell--student">
    <section class="auth-intro" aria-labelledby="change-password-heading">
        <span class="eyebrow">@UiText.Get(Context, "Change.Eyebrow")</span>
        <h1 id="change-password-heading" class="h2">@UiText.Get(Context, "Change.Heading")</h1>
        <p class="mb-0">@UiText.Get(Context, "Change.Lead")</p>
    </section>
    <section class="card auth-card" aria-label="@UiText.Get(Context, "Change.Aria")">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">@UiText.Get(Context, "Field.CurrentPassword")</label>
                    <div class="password-control">
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" data-password-reveal />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">@UiText.Get(Context, "Field.NewPassword")</label>
                    <div class="password-control">
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" data-password-reveal />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">@UiText.Get(Context, "Field.ConfirmPassword")</label>
                    <div class="password-control">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" data-password-reveal />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Change.Submit")</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-link">@UiText.Get(Context, "Common.Cancel")</a>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
