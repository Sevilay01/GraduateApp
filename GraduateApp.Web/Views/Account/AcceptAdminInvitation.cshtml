@model AcceptAdminInvitationViewModel
@{
    ViewData["Title"] = "Yönetici davetini kabul et";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <form asp-action="AcceptAdminInvitation" method="post" class="card card-body shadow-sm" novalidate data-disable-on-submit="true">
            <h1 class="h3">Yönetici parolanızı belirleyin</h1>
            <p class="text-muted">Davetinizi tamamlamak için güçlü ve yalnızca size ait bir parola belirleyin.</p>
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Daveti kabul et</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
