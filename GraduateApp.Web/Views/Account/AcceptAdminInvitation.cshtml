@model AcceptAdminInvitationViewModel
@{
    ViewData["Title"] = "Yönetici davetini kabul et";
}

<div class="auth-shell auth-shell--admin">
    <section class="auth-intro" aria-labelledby="invitation-heading">
        <span class="eyebrow">Yetkili erişimi</span>
        <h1 id="invitation-heading" class="h2">Yönetici davetinizi tamamlayın</h1>
        <p class="mb-0">Bu alan yalnızca size gönderilen tek kullanımlık yönetici daveti içindir.</p>
    </section>
    <section class="card auth-card" aria-label="Yönetici parola belirleme">
        <div class="card-body p-4 p-lg-5">
        <form asp-action="AcceptAdminInvitation" method="post" novalidate data-disable-on-submit="true">
            <p class="text-muted">Güçlü ve yalnızca bu hesap için kullandığınız bir parola belirleyin.</p>
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="password-control">
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus data-password-reveal />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="password-control">
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" data-password-reveal />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Daveti kabul et</button>
        </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
