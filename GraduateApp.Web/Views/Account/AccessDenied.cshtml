@{
    ViewData["Title"] = UiText.Get(Context, "AccessDenied.Title");
}

<div class="text-center py-5" data-access-denied-actions>
    <div class="display-1 fw-bold text-danger" aria-hidden="true">403</div>
    <h1 class="h2">@UiText.Get(Context, "AccessDenied.Heading")</h1>
    <p class="text-muted">@UiText.Get(Context, "AccessDenied.Lead")</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var targetAccountType = User.IsInRole("Admin")
                ? LoginAccountType.Student
                : LoginAccountType.Admin;
            <form asp-action="SwitchAccount" method="post">
                <input type="hidden" name="accountType" value="@targetAccountType" />
                <button type="submit" class="btn btn-primary">
                    @(targetAccountType == LoginAccountType.Admin
                        ? UiText.Get(Context, "AccessDenied.Admin")
                        : UiText.Get(Context, "AccessDenied.Student"))
                </button>
            </form>
        }
        else
        {
            <a asp-action="Login" class="btn btn-primary">@UiText.Get(Context, "Session.StudentLogin")</a>
            <a asp-action="AdminLogin" class="btn btn-outline-primary">@UiText.Get(Context, "Session.AdminLogin")</a>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "AccessDenied.Home")</a>
    </div>
</div>
