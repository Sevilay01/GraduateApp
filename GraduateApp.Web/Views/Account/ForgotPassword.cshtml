@model ForgotPasswordViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Forgot.Title");
}

<div class="auth-shell auth-shell--student">
    <section class="auth-intro" aria-labelledby="forgot-password-heading">
        <span class="eyebrow">@UiText.Get(Context, "Forgot.Eyebrow")</span>
        <h1 id="forgot-password-heading" class="h2">@UiText.Get(Context, "Forgot.Heading")</h1>
        <p class="mb-0">@UiText.Get(Context, "Forgot.Lead")</p>
    </section>
    <section class="card auth-card" aria-label="@UiText.Get(Context, "Forgot.Aria")">
        <div class="card-body p-4 p-lg-5">
            @if (ViewData["RequestSubmitted"] is true)
            {
                <div class="alert alert-success" role="status">
                    @UiText.Get(Context, "Forgot.Submitted")
                </div>
            }
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label">@UiText.Get(Context, "Field.Email")</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">@UiText.Get(Context, "Forgot.Submit")</button>
            </form>
            <p class="small mt-4 mb-0"><a asp-action="Login">@UiText.Get(Context, "Forgot.Back")</a></p>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
