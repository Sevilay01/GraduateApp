@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Parolamı unuttum";
}

<div class="auth-shell auth-shell--student">
    <section class="auth-intro" aria-labelledby="forgot-password-heading">
        <span class="eyebrow">Hesap kurtarma</span>
        <h1 id="forgot-password-heading" class="h2">Parolanızı güvenle sıfırlayın</h1>
        <p class="mb-0">Kayıtlı e-posta adresinizi girin. Güvenlik nedeniyle hesabın varlığı hakkında ayrıntı paylaşılmaz.</p>
    </section>
    <section class="card auth-card" aria-label="Parola sıfırlama isteği">
        <div class="card-body p-4 p-lg-5">
            @if (ViewData["RequestSubmitted"] is true)
            {
                <div class="alert alert-success" role="status">
                    Hesap mevcutsa parola sıfırlama yönergeleri gönderildi.
                </div>
            }
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Sıfırlama bağlantısı iste</button>
            </form>
            <p class="small mt-4 mb-0"><a asp-action="Login">Giriş ekranına dön</a></p>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
