@model HomeViewModel
@{
    ViewData["Title"] = "Ana sayfa";
}

<section class="p-4 p-md-5 mb-4 rounded-3 bg-light border">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">Yüksek lisans başvurunuzu güvenle yönetin</h1>
        <p class="col-lg-8 fs-5 text-muted">Açık programları inceleyin, başvurunuzu oluşturun ve değerlendirme durumunu tek panelden takip edin.</p>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Öğrenci kaydı</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">Giriş yap</a>
        }
        else if (User.IsInRole("Student"))
        {
            <a asp-controller="Panel" asp-action="Index" class="btn btn-primary btn-lg">Öğrenci paneline git</a>
        }
    </div>
</section>

<section aria-labelledby="open-programs-title">
    <h2 id="open-programs-title" class="h3 mb-3">Açık yüksek lisans programları</h2>
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
    }
    else if (Model.OpenPrograms.Count == 0)
    {
        <p class="text-muted">Şu anda başvuruya açık program bulunmuyor.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var program in Model.OpenPrograms)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="h5">@program.ProgramName</h3>
                            <p class="mb-1">@program.InstituteName</p>
                            <p class="text-muted">@program.DegreeType</p>
                            <p class="mb-1"><strong>@program.AcademicYear · @program.TermName</strong></p>
                            <p class="small mb-0">Son başvuru: <time datetime="@program.ApplicationDeadlineUtc.ToString("O")">@IstanbulTime.FromUtc(program.ApplicationDeadlineUtc).ToString("dd.MM.yyyy HH:mm")</time> (İstanbul)</p>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
