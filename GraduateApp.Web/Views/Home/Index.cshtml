@model HomeViewModel
@{
    ViewData["Title"] = UiText.Get(Context, "Home.Title");
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__content">
        <span class="eyebrow">@UiText.Get(Context, "Home.Eyebrow")</span>
        <h1 id="hero-title">@UiText.Get(Context, "Home.HeroTitle")</h1>
        <p class="hero__lead">
            @UiText.Get(Context, "Home.HeroLead")
        </p>
        <div class="hero__actions">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">@UiText.Get(Context, "Home.CreateRegistration")</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">@UiText.Get(Context, "Home.StudentLogin")</a>
            }
            else if (User.IsInRole("Student"))
            {
                <a asp-controller="Panel" asp-action="Index" class="btn btn-primary btn-lg">@UiText.Get(Context, "Home.GoStudentPanel")</a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-lg">@UiText.Get(Context, "Home.GoAdminPanel")</a>
            }
        </div>
    </div>
</section>

<section aria-labelledby="open-programs-title">
    <div class="section-heading">
        <div>
            <span class="eyebrow">@UiText.Get(Context, "Home.Period")</span>
            <h2 id="open-programs-title">@UiText.Get(Context, "Home.OpenPrograms")</h2>
        </div>
        <p>@UiText.Get(Context, "Home.Compare")</p>
    </div>

    <form asp-action="Index" method="get" class="admin-filter-panel mb-4" role="search" aria-label="@UiText.Get(Context, "Home.SearchAria")">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-6">
                <label for="open-program-search" class="form-label">@UiText.Get(Context, "Home.SearchLabel")</label>
                <input id="open-program-search"
                       name="search"
                       value="@Model.ProgramSearch.Search"
                       maxlength="@OpenProgramSearchViewModel.MaximumSearchLength"
                       class="form-control"
                       placeholder="@UiText.Get(Context, "Home.SearchPlaceholder")" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-year" class="form-label">@UiText.Get(Context, "Home.YearLabel")</label>
                <input id="open-program-year"
                       name="academicYearStart"
                       value="@Model.ProgramSearch.AcademicYearStart"
                       type="number"
                       min="2000"
                       max="2200"
                       class="form-control"
                       placeholder="2026" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-term" class="form-label">@UiText.Get(Context, "Home.TermLabel")</label>
                <select id="open-program-term" name="term" class="form-select">
                    <option value="">@UiText.Get(Context, "Home.AllTerms")</option>
                    @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                    {
                        <option value="@term" selected="@(Model.ProgramSearch.Term == term ? "selected" : null)">@UiText.Get(Context, $"AcademicTerm.{term}")</option>
                    }
                </select>
            </div>
        </div>
        <div class="admin-form-actions mt-3">
            <button type="submit" class="btn btn-primary">@UiText.Get(Context, "Home.SearchButton")</button>
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">@UiText.Get(Context, "Home.ClearFilters")</a>
            }
        </div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning app-alert" role="alert">
            <strong>@UiText.Get(Context, "Home.LoadError")</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }
    else if (Model.OpenPrograms.Count == 0)
    {
        <div class="empty-state">
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <h3>@UiText.Get(Context, "Home.NoMatch")</h3>
                <p>@UiText.Get(Context, "Home.TryDifferent")</p>
                <a asp-action="Index" class="btn btn-outline-primary">@UiText.Get(Context, "Home.ShowAll")</a>
            }
            else
            {
                <h3>@UiText.Get(Context, "Home.NoPrograms")</h3>
                <p>@UiText.Get(Context, "Home.NoProgramsLead")</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var program in Model.OpenPrograms)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card program-card h-100">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="program-card__institute">@program.InstituteName</div>
                            <h3 class="h5 mb-2">@program.ProgramName</h3>
                            <p class="program-card__degree">@program.DegreeType</p>
                            <dl class="meta-grid">
                                <div class="meta-item">
                                    <dt>@UiText.Get(Context, "Home.AcademicPeriod")</dt>
                                    <dd>@program.AcademicYear · @UiText.Get(Context, $"AcademicTerm.{program.Term}")</dd>
                                </div>
                                <div class="meta-item">
                                    <dt>@UiText.Get(Context, "Home.Quota")</dt>
                                    <dd>@UiText.Format(Context, "Home.People", program.Quota)</dd>
                                </div>
                            </dl>
                            <div class="deadline-callout mt-auto">
                                <div>
                                    <div class="deadline-callout__label">@UiText.Get(Context, "Home.Deadline")</div>
                                    <time datetime="@program.ApplicationDeadlineUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(program.ApplicationDeadlineUtc).ToString("dd MMMM yyyy · HH:mm")
                                    </time>
                                    <span class="visually-hidden"> @UiText.Get(Context, "Home.IstanbulTime")</span>
                                </div>
                            </div>
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">@UiText.Get(Context, "Home.LoginToApply")</a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
