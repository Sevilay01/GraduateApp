@model HomeViewModel
@{
    ViewData["Title"] = "Ana sayfa";
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero__content">
        <span class="eyebrow">Çukurova Üniversitesi</span>
        <h1 id="hero-title">Lisansüstü eğitime giden yolunuzu güvenle yönetin</h1>
        <p class="hero__lead">
            Başvuruya açık programları inceleyin, belgelerinizi güvenli biçimde yükleyin ve başvurunuzun her adımını tek panelden takip edin.
        </p>
        <div class="hero__actions">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Öğrenci kaydı oluştur</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">Öğrenci girişi</a>
            }
            else if (User.IsInRole("Student"))
            {
                <a asp-controller="Panel" asp-action="Index" class="btn btn-primary btn-lg">Öğrenci paneline git</a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-lg">Yönetim paneline git</a>
            }
        </div>
    </div>
</section>

<section aria-labelledby="open-programs-title">
    <div class="section-heading">
        <div>
            <span class="eyebrow">2026–2027 akademik dönemi</span>
            <h2 id="open-programs-title">Başvuruya açık lisansüstü programlar</h2>
        </div>
        <p>Son başvuru tarihlerini ve temel program bilgilerini karşılaştırın.</p>
    </div>

    <form asp-action="Index" method="get" class="admin-filter-panel mb-4" role="search" aria-label="Açık programlarda ara">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-6">
                <label for="open-program-search" class="form-label">Program, enstitü veya derece ara</label>
                <input id="open-program-search"
                       name="search"
                       value="@Model.ProgramSearch.Search"
                       maxlength="@OpenProgramSearchViewModel.MaximumSearchLength"
                       class="form-control"
                       placeholder="Örn. Bilgisayar, Fen Bilimleri veya Doktora" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-year" class="form-label">Akademik yıl başlangıcı</label>
                <input id="open-program-year"
                       name="academicYearStart"
                       value="@Model.ProgramSearch.AcademicYearStart"
                       type="number"
                       min="2000"
                       max="2200"
                       class="form-control"
                       placeholder="2026" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="open-program-term" class="form-label">Dönem</label>
                <select id="open-program-term" name="term" class="form-select">
                    <option value="">Tüm dönemler</option>
                    @foreach (var term in AcademicTermDisplayExtensions.OfferingValues)
                    {
                        <option value="@term" selected="@(Model.ProgramSearch.Term == term ? "selected" : null)">@term.DisplayName()</option>
                    }
                </select>
            </div>
        </div>
        <div class="admin-form-actions mt-3">
            <button type="submit" class="btn btn-primary">Programları ara</button>
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Filtreleri temizle</a>
            }
        </div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning app-alert" role="alert">
            <strong>Program bilgileri alınamadı.</strong>
            <span>@Model.ErrorMessage</span>
        </div>
    }
    else if (Model.OpenPrograms.Count == 0)
    {
        <div class="empty-state">
            @if (Model.ProgramSearch.HasActiveFilters)
            {
                <h3>Arama ölçütlerine uygun açık program bulunamadı</h3>
                <p>Arama metnini veya akademik dönem filtrelerini değiştirerek yeniden deneyin.</p>
                <a asp-action="Index" class="btn btn-outline-primary">Tüm açık programları göster</a>
            }
            else
            {
                <h3>Şu anda açık program bulunmuyor</h3>
                <p>Yeni başvuru dönemleri açıldığında programlar bu alanda listelenecektir.</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var program in Model.OpenPrograms)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card program-card h-100">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="program-card__institute">@program.InstituteName</div>
                            <h3 class="h5 mb-2">@program.ProgramName</h3>
                            <p class="program-card__degree">@program.DegreeType</p>
                            <dl class="meta-grid">
                                <div class="meta-item">
                                    <dt>Akademik dönem</dt>
                                    <dd>@program.AcademicYear · @program.TermName</dd>
                                </div>
                                <div class="meta-item">
                                    <dt>Kontenjan</dt>
                                    <dd>@program.Quota kişi</dd>
                                </div>
                            </dl>
                            <div class="deadline-callout mt-auto">
                                <div>
                                    <div class="deadline-callout__label">Son başvuru</div>
                                    <time datetime="@program.ApplicationDeadlineUtc.ToString("O")">
                                        @IstanbulTime.FromUtc(program.ApplicationDeadlineUtc).ToString("dd MMMM yyyy · HH:mm")
                                    </time>
                                    <span class="visually-hidden"> İstanbul saati</span>
                                </div>
                            </div>
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary w-100">Başvuru için giriş yap</a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
