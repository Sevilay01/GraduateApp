@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var isHome = currentController == "Home" && currentAction == "Index";
    var isStudentPanel = currentController == "Panel" && currentAction is "Index" or "ApplicationDetail";
    var isExamScores = currentController == "Panel" && currentAction == "ExamScores";
    var isProfile = currentController == "Panel" && currentAction == "Profile";
    var isAdminApplications = currentController == "Admin"
        && currentAction is "Index" or "Detail";
    var isAdminOfferings = currentController == "Admin"
        && currentAction is "Offerings" or "Evaluation" or "PublishEvaluation";
    var isAdminCatalog = currentController == "Admin"
        && currentAction is "Institutes" or "Programs" or "ProgramTranslations" or "Universities" or "DeleteInstitute" or "DeleteProgram";
    var isAdminStudents = currentController == "Admin"
        && currentAction is "Students" or "ActivateStudent" or "DeactivateStudent";
    var isAdminAccounts = currentController == "Admin" && currentAction == "Accounts";
    var isAdminAccountManagement = isAdminStudents || isAdminAccounts;
    var roleDisplay = User.IsInRole("Admin")
        ? UiText.Get(Context, "Role.Admin")
        : UiText.Get(Context, "Role.Student");
    var currentCultureName = UiText.CurrentCultureName(Context);
    var htmlLanguage = currentCultureName == UiText.EnglishCultureName ? "en" : "tr";
    var returnUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}
<!DOCTYPE html>
<html lang="@htmlLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · @UiText.Get(Context, "University.Name") @UiText.Get(Context, "Application.Name")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main-content">@UiText.Get(Context, "Navigation.SkipToContent")</a>

    @if (HostEnvironment.IsDevelopment())
    {
        <div class="environment-banner" role="status">
            <div class="container">
                <strong>@UiText.Get(Context, "Environment.Development")</strong>
                <span>@UiText.Get(Context, "Environment.Warning")</span>
            </div>
        </div>
    }

    <header class="site-header">
        <nav class="navbar navbar-expand-xl navbar-dark" aria-label="@UiText.Get(Context, "Navigation.MainMenu")">
            <div class="container">
                <a class="site-brand" asp-controller="Home" asp-action="Index"
                   aria-label="@UiText.Get(Context, "Brand.HomeLabel")">
                    <img src="~/images/brand/cu_logo_tr.svg"
                         width="270" height="72"
                         alt="@UiText.Get(Context, "University.Name")"
                         class="site-brand__logo" />
                    <span class="site-brand__product">@UiText.Get(Context, "Application.Name")</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="@UiText.Get(Context, "Navigation.Toggle")">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav site-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : null)"
                               aria-current="@(isHome ? "page" : null)"
                               asp-controller="Home" asp-action="Index">@UiText.Get(Context, "Navigation.Home")</a>
                        </li>
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isStudentPanel ? "active" : null)"
                                   aria-current="@(isStudentPanel ? "page" : null)"
                                   asp-controller="Panel" asp-action="Index">@UiText.Get(Context, "Navigation.MyApplications")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isExamScores ? "active" : null)"
                                   aria-current="@(isExamScores ? "page" : null)"
                                   asp-controller="Panel" asp-action="ExamScores">@UiText.Get(Context, "Navigation.MyExamScores")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isProfile ? "active" : null)"
                                   aria-current="@(isProfile ? "page" : null)"
                                   asp-controller="Panel" asp-action="Profile">@UiText.Get(Context, "Navigation.MyProfile")</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isAdminApplications ? "active" : null)"
                                   aria-current="@(isAdminApplications ? "page" : null)"
                                   asp-controller="Admin" asp-action="Index">@UiText.Get(Context, "Navigation.Applications")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAdminOfferings ? "active" : null)"
                                   aria-current="@(isAdminOfferings ? "page" : null)"
                                   asp-controller="Admin" asp-action="Offerings">@UiText.Get(Context, "Navigation.Offerings")</a>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle @(isAdminCatalog ? "active" : null)"
                                        id="adminCatalogMenu"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    @UiText.Get(Context, "Navigation.AcademicCatalog")
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="adminCatalogMenu">
                                    <li>
                                        <a class="dropdown-item @(currentAction is "Institutes" or "Programs" or "ProgramTranslations" or "DeleteInstitute" or "DeleteProgram" ? "active" : null)"
                                           aria-current="@(currentAction is "Institutes" or "Programs" or "ProgramTranslations" or "DeleteInstitute" or "DeleteProgram" ? "page" : null)"
                                           asp-controller="Admin" asp-action="Institutes">@UiText.Get(Context, "Navigation.InstitutesPrograms")</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(currentAction == "ProgramTranslations" ? "active" : null)"
                                           aria-current="@(currentAction == "ProgramTranslations" ? "page" : null)"
                                           asp-controller="Admin" asp-action="ProgramTranslations">@UiText.Get(Context, "Navigation.ProgramTranslations")</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(currentAction == "Universities" ? "active" : null)"
                                           aria-current="@(currentAction == "Universities" ? "page" : null)"
                                           asp-controller="Admin" asp-action="Universities">@UiText.Get(Context, "Navigation.Universities")</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle @(isAdminAccountManagement ? "active" : null)"
                                        id="adminAccountsMenu"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    @UiText.Get(Context, "Navigation.AccountManagement")
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="adminAccountsMenu">
                                    <li>
                                        <a class="dropdown-item @(isAdminStudents ? "active" : null)"
                                           aria-current="@(isAdminStudents ? "page" : null)"
                                           asp-controller="Admin" asp-action="Students">@UiText.Get(Context, "Navigation.Students")</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(isAdminAccounts ? "active" : null)"
                                           aria-current="@(isAdminAccounts ? "page" : null)"
                                           asp-controller="Admin" asp-action="Accounts">@UiText.Get(Context, "Navigation.Administrators")</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>


                    <div class="header-utilities">
                        <form asp-controller="Language"
                              asp-action="Set"
                              method="post"
                              class="language-switcher"
                              data-language-form
                              aria-label="@UiText.Get(Context, "Language.Label")">
                            <span class="language-switcher__label">@UiText.Get(Context, "Language.Label")</span>
                            <div class="language-switcher__options"
                                 role="group"
                                 aria-label="@UiText.Get(Context, "Language.Label")">
                                <button type="submit"
                                        name="culture"
                                        value="@UiText.TurkishCultureName"
                                        lang="tr"
                                        class="language-switcher__option @(currentCultureName == UiText.TurkishCultureName ? "active" : null)"
                                        aria-pressed="@(currentCultureName == UiText.TurkishCultureName ? "true" : "false")"
                                        title="@UiText.Get(Context, "Language.Turkish")">
                                    TR
                                </button>
                                <button type="submit"
                                        name="culture"
                                        value="@UiText.EnglishCultureName"
                                        lang="en"
                                        class="language-switcher__option @(currentCultureName == UiText.EnglishCultureName ? "active" : null)"
                                        aria-pressed="@(currentCultureName == UiText.EnglishCultureName ? "true" : "false")"
                                        title="@UiText.Get(Context, "Language.English")">
                                    EN
                                </button>
                            </div>
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                        </form>

                        <div class="session-area">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="session-identity" aria-label="@UiText.Get(Context, "Session.Information")">
                                    <span class="session-identity__name">@User.Identity.Name</span>
                                    <span class="session-identity__role">@UiText.Format(Context, "Session.Account", roleDisplay)</span>
                                </div>
                                <div class="session-actions">
                                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="ChangePassword">
                                        @UiText.Get(Context, "Session.ChangePassword")
                                    </a>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-sm btn-light">@UiText.Get(Context, "Session.SecureLogout")</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="session-actions session-actions--anonymous" aria-label="@UiText.Get(Context, "Session.Actions")">
                                    <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">@UiText.Get(Context, "Session.StudentLogin")</a>
                                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="AdminLogin">@UiText.Get(Context, "Session.AdminLogin")</a>
                                    <a class="nav-register-link" asp-controller="Account" asp-action="Register">@UiText.Get(Context, "Session.StudentRegistration")</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container site-main flex-grow-1" id="main-content" tabindex="-1">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success app-alert" role="status">
                <strong>@UiText.Get(Context, "Alert.Success")</strong>
                <span>@successMessage</span>
            </div>
        }
        @if (TempData["WarningMessage"] is string warningMessage)
        {
            <div class="alert alert-warning app-alert" role="alert">
                <strong>@UiText.Get(Context, "Alert.Warning")</strong>
                <span>@warningMessage</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger app-alert" role="alert">
                <strong>@UiText.Get(Context, "Alert.Error")</strong>
                <span>@errorMessage</span>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer mt-auto">
        <div class="container site-footer__content">
            <div>
                <strong>@UiText.Get(Context, "University.Name")</strong>
                <span>@UiText.Get(Context, "Application.Name")</span>
            </div>
            <div>
                <span>&copy; @DateTime.UtcNow.Year</span>
                <a asp-controller="Home" asp-action="Privacy">@UiText.Get(Context, "Footer.Privacy")</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
