@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <h1 class="h2">İşlem tamamlanamadı</h1>
    <p class="text-muted">Beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Destek kodu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
</div>
