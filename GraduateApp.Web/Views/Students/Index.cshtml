@using GraduateApp.Web.Models
@model List<StudentViewModel>

    @{
        ViewData["Title"] = "Öðrenci Listesi";
    }

    <h2>Kayýtlý Öðrenciler</h2>
    <a asp-action="Create" class="btn btn-success mb-3">Yeni Öðrenci Ekle</a>
    <hr />

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>TC Kimlik</th>
                <th>Ad</th>
                <th>Soyad</th>
                <th>E-Posta</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var student in Model)
                {
                    <tr>
                        <td>@student.TC</td>
                        <td>@student.StudentName</td>
                        <td>@student.StudentSurname</td>
                        <td>@student.Email</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">Henüz kayýtlý öðrenci bulunmuyor.</td>
                </tr>
            }
        </tbody>
    </table>
